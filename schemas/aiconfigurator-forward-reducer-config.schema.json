{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonkvsim.local/schemas/aiconfigurator-forward-reducer-config.schema.json",
  "title": "MoonKVSim AIConfigurator forward reducer method",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "calibration_method",
    "database_mode",
    "shape_axes",
    "train_estimator",
    "held_out_predictor",
    "mixed_policy",
    "residual_convention",
    "absolute_error_percentile_method",
    "formal_requirements"
  ],
  "properties": {
    "schema": {"const": "moonkvsim.aiconfigurator-forward-reducer-config.v1"},
    "calibration_method": {"const": "phase_shape_residual_table"},
    "database_mode": {"const": "MOONKVSIM_PHASE_SHAPE_PHYSICAL_V1"},
    "shape_axes": {"const": ["batch_size", "extend_length", "past_kv_length"]},
    "train_estimator": {"const": "integer_median_half_up"},
    "held_out_predictor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis_normalization", "distance", "tie_breaker"],
      "properties": {
        "axis_normalization": {"const": "phase_plan_axis_range_with_unit_floor"},
        "distance": {"const": "normalized_l1"},
        "tie_breaker": {"const": "shape_id_lexicographic"}
      }
    },
    "mixed_policy": {"const": "observation_only_never_fit_or_decompose"},
    "residual_convention": {"const": "predicted_minus_observed_ns"},
    "absolute_error_percentile_method": {"const": "nearest_rank"},
    "formal_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_bundle_complete",
        "train_held_out_disjoint",
        "phase_coverage",
        "held_out_thresholds_pass",
        "exact_hardware_profile_binding"
      ],
      "properties": {
        "source_bundle_complete": {"const": true},
        "train_held_out_disjoint": {"const": true},
        "phase_coverage": {"const": ["prefill", "decode"]},
        "held_out_thresholds_pass": {"const": true},
        "exact_hardware_profile_binding": {"const": true}
      }
    }
  }
}
