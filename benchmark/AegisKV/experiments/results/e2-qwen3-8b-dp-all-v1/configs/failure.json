{
  "schema": "moonkvsim.aegiskv.failure.v1",
  "enabled": true,
  "allowed_types": ["GPU_FAILURE"],
  "type": "GPU_FAILURE",
  "semantics": "fail_stop_hbm_lost",
  "repair": {
    "enabled": false,
    "repair_after_s": null
  },
  "control": {
    "mode": "focus_span_compute_progress",
    "progress_per_mille": 100,
    "selection_scope": "same_focus_span_and_compute_progress_in_every_system",
    "frequency": {
      "kind": "one_gpu_failure_per_gpu_failure_cell",
      "scenarios": ["no_failure", "gpu_failure"],
      "note": "no_failure cells inject nothing; gpu_failure cells inject exactly one fail-stop on the focus-span GPU when that request reaches the configured progress"
    }
  },
  "detection_delay_ns": 5000000,
  "reroute_delay_ns": 1000000,
  "target": {
    "resolution": "deterministic_focus_span_gpu",
    "topology": "single_node",
    "gpu_sku": "NVIDIA-A100-40GB"
  },
  "effects": {
    "compute_unavailable": true,
    "copy_engines_unavailable": true,
    "hbm_lost": true,
    "committed_store_dram_remains_usable": true
  }
}
