+def profile_manifest_fields(
+    profile: GridDurationProfile, configs: Iterable[Mapping[str, object]]
+) -> dict:
+    """Describe a profile campaign from its actual table and all job configs.
+
+    This prepares metadata only. It neither changes timing nor promotes an
+    operator-model table to calibrated or physically executed evidence.
+    """
+    levels = sorted({float(config["compute_dma_slowdown"]) for config in configs})
+    if not levels or any(not isfinite(value) or value < 0 for value in levels):
+        raise ValueError("DMA slowdown levels must be nonempty, finite and nonnegative")
+    keys = (
+        "model",
+        "revision",
+        "tp",
+        "hardware",
+        "batch_size",
+        "backend",
+        "backend_version",
+        "database_mode",
+        "timing_evidence",
+        "interpolation",
+        "calibrated",
+        "physical_execution",
+        "native_max_context",
+        "max_profile_context",
+        "extended_context",
+        "decoding_convention",
+        "config_sha256",
+    )
+    metadata = {key: deepcopy(profile.data[key]) for key in keys if key in profile.data}
+    metadata["scale"] = profile.scale
+    evidence = profile.data.get("timing_evidence", "configured duration grid")
+    return {
+        "timing": (
+            f"{evidence} via GridDurationProfile; bounded prefix/extend interpolation "
+            "and per-token decode summation; shared weighted max-min fair byte-flow DES"
+        ),
+        "duration_profile": "GridDurationProfile",
+        "duration_profile_metadata": metadata,
+        "foreground_dma_compute_interference": (
+            "configured compute-event-start slowdown when H2D or D2H is active on "
+            "any TP rank of the same worker; levels recorded below; not calibrated"
+            if any(levels)
+            else "disabled by compute_dma_slowdown=0; not measured zero overhead"
+        ),
+        "compute_dma_slowdown_values": levels,
+    }
 
 
