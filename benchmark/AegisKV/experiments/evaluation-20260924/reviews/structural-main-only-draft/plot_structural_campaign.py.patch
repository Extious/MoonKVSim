+def endpoint_tables(paired):
+    """One row per run/seed; workflows within a run are not independent repeats."""
+    groups = {}
+    for row in paired:
+        if int(row["workflows"]) == 8:
+            key = row["scenario"], row["fault"], row["policy"], int(row["seed"])
+            groups.setdefault(key, []).append(row)
+    rows, all_workflow_means = [], {}
+    for key, group in sorted(groups.items()):
+        assert len(group) == len({row["workflow"] for row in group}) == 8
+        targets = [row for row in group if row["target_workflow"] == "True"]
+        assert len(targets) == 1
+        deltas = np.array([float(row["delta_wct_s"]) for row in group])
+        all_workflow_means[key] = float(np.mean(deltas))
+        rows.append(
+            dict(
+                scenario=key[0],
+                fault=key[1],
+                policy=key[2],
+                seed=key[3],
+                workflow_count=8,
+                target_delta_wct_s=float(targets[0]["delta_wct_s"]),
+                all_workflow_mean_delta_wct_s=float(np.mean(deltas)),
+                all_workflow_p95_paired_delta_s=float(np.percentile(deltas, 95, method="higher")),
+                all_workflow_p99_paired_delta_s=float(np.percentile(deltas, 99, method="higher")),
+                all_workflow_max_paired_delta_s=float(max(deltas)),
+                negative_workflow_delta_count=int(sum(deltas < 0)),
+            )
+        )
+    assert len(rows) == 90
+    write_csv(OUT / "wct-endpoints-per-run.csv", rows)
+    return all_workflow_means
 
 
