<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="31.1.5">
  <diagram id="figure-3-slacklandlord" name="附图3：SlackLandlord 租值键决策">
    <mxGraphModel math="1" grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1950" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="canvas" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="0" y="0" width="1800" height="1950" />
        </mxCell>
        <mxCell id="title" value="&lt;div style=&quot;line-height:1.35&quot;&gt;SlackLandlord：KV 分块的租值键决策&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=42;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="5" width="1720" height="65" />
        </mxCell>
        <mxCell id="symbols" value="&lt;div style=&quot;line-height:1.35&quot;&gt;\(L\)：本池累计租金；\(H_x\)：租值键；\(c_{u,x}\)：Agent u 的信用份额；\(Q\)：可释放尾块队列&lt;br&gt;\(L^{\prime},Y,f\)：试算租金、待回收块、可用字节；\(y,z\)：旧尾块、新暴露尾块&lt;br&gt;Peer-HBM 与 DRAM 各自执行；Q 排除内部块、必要前缀和正在读取或操作的块。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=31;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="80" width="1680" height="120" />
        </mxCell>
        <mxCell id="input" value="&lt;div style=&quot;line-height:1.35&quot;&gt;① 请求去重、块状态就绪后，读取本次输入&lt;br&gt;\(a,\ x,\ b_x,\ G_{a,x}\)（收益由附图 2 提供）&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=34;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="360" y="230" width="1080" height="100" />
        </mxCell>
        <mxCell id="renew" value="&lt;div style=&quot;line-height:1.35&quot;&gt;② 结算旧租金，并只续租当前 Agent a&lt;br&gt;\(x\in Q:\quad \mathrm{Credit}_x\leftarrow b_x\max(H_x-L,0),\quad c_{u,x}\leftarrow c_{u,x}\,\frac{\mathrm{Credit}_x}{\sum_v c_{v,x}}\)&lt;br&gt;其他块保留冻结份额；新副本空账；分母取结算前总额，零时跳过。&lt;br&gt;\(c_{a,x}\leftarrow G_{a,x},\quad \mathrm{Credit}_x\leftarrow\sum_u c_{u,x}\)&lt;br&gt;\(H_x\leftarrow L+\mathrm{Credit}_x/b_x\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=31;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="280" y="405" width="1240" height="235" />
        </mxCell>
        <mxCell id="edge-0" edge="1" parent="1" source="input" target="renew" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;jettySize=20;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="resident" value="&lt;div style=&quot;line-height:1.35&quot;&gt;已有备份？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=35;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="650" y="720" width="500" height="115" />
        </mxCell>
        <mxCell id="edge-1" edge="1" parent="1" source="renew" target="resident" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;jettySize=20;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="save" value="&lt;div style=&quot;line-height:1.35&quot;&gt;保存份额，更新 Q 或冻结&lt;br&gt;记录本请求；续租结束&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=31;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="710" width="450" height="125" />
        </mxCell>
        <mxCell id="edge-2" edge="1" parent="1" source="resident" target="save" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;jettySize=20;exitX=0;exitY=0.5;entryX=1;entryY=0.5;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge-2-label" value="&lt;div style=&quot;line-height:1.35&quot;&gt;是&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=31;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;text;strokeColor=none;fillColor=none;fillColor=#FFFFFF;spacing=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="735" width="65" height="40" />
        </mxCell>
        <mxCell id="trial" value="&lt;div style=&quot;line-height:1.35&quot;&gt;③ 新副本：保护必要前缀，建立临时账本&lt;br&gt;\(L^{\prime}\leftarrow L,\quad Y\leftarrow\varnothing,\quad f\leftarrow\text{可用字节}\)&lt;br&gt;退出 Q 的前缀先结算，再冻结份额&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=32;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="380" y="910" width="1040" height="140" />
        </mxCell>
        <mxCell id="edge-3" edge="1" parent="1" source="resident" target="trial" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;jettySize=20;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge-3-label" value="&lt;div style=&quot;line-height:1.35&quot;&gt;否&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=31;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;text;strokeColor=none;fillColor=none;fillColor=#FFFFFF;spacing=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="935" y="850" width="65" height="40" />
        </mxCell>
        <mxCell id="capacity" value="&lt;div style=&quot;line-height:1.35&quot;&gt;空间足够？&lt;br&gt;\(f\ge b_x\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=34;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="650" y="1130" width="500" height="120" />
        </mxCell>
        <mxCell id="edge-4" edge="1" parent="1" source="trial" target="capacity" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;jettySize=20;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="choose" value="&lt;div style=&quot;line-height:1.35&quot;&gt;\(Q\ne\varnothing\)，且最小尾块键&lt;br&gt;\(H_y&amp;lt;H_x\)？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=33;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="150" y="1320" width="620" height="135" />
        </mxCell>
        <mxCell id="edge-5" edge="1" parent="1" source="capacity" target="choose" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;jettySize=20;exitX=0;exitY=0.5;entryX=0.5;entryY=0;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="460" y="1190" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-5-label" value="&lt;div style=&quot;line-height:1.35&quot;&gt;否&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=31;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;text;strokeColor=none;fillColor=none;fillColor=#FFFFFF;spacing=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="505" y="1135" width="65" height="40" />
        </mxCell>
        <mxCell id="reject" value="&lt;div style=&quot;line-height:1.35&quot;&gt;拒绝本次准入&lt;br&gt;丢弃临时账本&lt;br&gt;实际状态不变&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=31;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="870" y="1315" width="250" height="140" />
        </mxCell>
        <mxCell id="edge-6" edge="1" parent="1" source="choose" target="reject" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;jettySize=20;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge-6-label" value="&lt;div style=&quot;line-height:1.35&quot;&gt;否&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=31;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;text;strokeColor=none;fillColor=none;fillColor=#FFFFFF;spacing=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="795" y="1335" width="65" height="40" />
        </mxCell>
        <mxCell id="rent" value="&lt;div style=&quot;line-height:1.35&quot;&gt;④ 试删 y，并从临时 Q 移除&lt;br&gt;\(L^{\prime}\leftarrow H_y,\quad Y\leftarrow Y\cup\{y\},\quad f\leftarrow f+b_y\)&lt;br&gt;新尾块 z 以 \(H_z\leftarrow L^{\prime}+\sum_u c_{u,z}/b_z\) 入 Q&lt;br&gt;候选 \(H_x\) 与持续在 Q 中的 H 保持不变&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=31;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="1530" width="820" height="205" />
        </mxCell>
        <mxCell id="edge-7" edge="1" parent="1" source="choose" target="rent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;jettySize=20;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge-7-label" value="&lt;div style=&quot;line-height:1.35&quot;&gt;是&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=31;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;text;strokeColor=none;fillColor=none;fillColor=#FFFFFF;spacing=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="525" y="1470" width="65" height="40" />
        </mxCell>
        <mxCell id="edge-8" edge="1" parent="1" source="rent" target="capacity" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;jettySize=20;exitX=0;exitY=0.5;entryX=0.5;entryY=0;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="55" y="1632.5" />
              <mxPoint x="55" y="1090" />
              <mxPoint x="900" y="1090" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="commit" value="&lt;div style=&quot;line-height:1.35&quot;&gt;⑤ 核验后提交并执行&lt;br&gt;\(L\leftarrow L^{\prime}\)&lt;br&gt;\(c_{a,x}\leftarrow b_x\max(H_x-L^{\prime},0)\)&lt;br&gt;冻结余额，等待实际释放&lt;br&gt;分配空间 → 复制&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=31;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1220" y="1290" width="525" height="245" />
        </mxCell>
        <mxCell id="edge-9" edge="1" parent="1" source="capacity" target="commit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;jettySize=20;exitX=1;exitY=0.5;entryX=0.5;entryY=0;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1482.5" y="1190" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-9-label" value="&lt;div style=&quot;line-height:1.35&quot;&gt;是&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=31;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;text;strokeColor=none;fillColor=none;fillColor=#FFFFFF;spacing=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1230" y="1135" width="65" height="40" />
        </mxCell>
        <mxCell id="publish" value="&lt;div style=&quot;line-height:1.35&quot;&gt;⑥ 发布备份，记录处理结果&lt;br&gt;\(H_x\leftarrow L+\sum_u c_{u,x}/b_x\)&lt;br&gt;按当前 L 建键；保留租后余额&lt;br&gt;解除保护，安全尾块入 Q&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=31;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1210" y="1600" width="535" height="185" />
        </mxCell>
        <mxCell id="edge-10" edge="1" parent="1" source="commit" target="publish" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;jettySize=20;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge-10-label" value="&lt;div style=&quot;line-height:1.35&quot;&gt;成功&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=31;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;text;strokeColor=none;fillColor=none;fillColor=#FFFFFF;spacing=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1510" y="1540" width="100" height="40" />
        </mxCell>
        <mxCell id="abort" value="&lt;div style=&quot;line-height:1.35&quot;&gt;执行失败：按实际状态清理&lt;br&gt;已释放的备份与已推进的 L 不回滚&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=30;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1000" y="1830" width="760" height="95" />
        </mxCell>
        <mxCell id="edge-11" edge="1" parent="1" source="commit" target="abort" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;jettySize=20;exitX=1;exitY=0.5;entryX=1;entryY=0.5;">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1780" y="1412.5" />
              <mxPoint x="1780" y="1877.5" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-11-label" value="&lt;div style=&quot;line-height:1.35&quot;&gt;失败&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=30;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;text;strokeColor=none;fillColor=none;fillColor=#FFFFFF;spacing=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1710" y="1550" width="75" height="40" />
        </mxCell>
        <mxCell id="notes" value="&lt;div style=&quot;line-height:1.35&quot;&gt;空闲容量允许零 Credit；核验冲突重读①。&lt;br&gt;进行中或未就绪先等待；重复或过期不授信。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=30;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="1820" width="850" height="95" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>