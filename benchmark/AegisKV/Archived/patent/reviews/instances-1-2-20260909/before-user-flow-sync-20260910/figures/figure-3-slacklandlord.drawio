                    </mxGeometry>
                </mxCell>
                <mxCell id="commit" value="&lt;div style=&quot;line-height:1.35&quot;&gt;⑤ 更新累计租金 L&lt;br&gt;\(L\leftarrow L^{\prime}\)&lt;br&gt;x 传输备份&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=31;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=6;" parent="1" vertex="1">
