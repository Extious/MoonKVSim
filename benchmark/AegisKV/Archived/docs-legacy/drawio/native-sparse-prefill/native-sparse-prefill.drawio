        </mxCell>
        <mxCell id="02-moba-prefill-3" value="&lt;div style=&quot;line-height:1.25&quot;&gt;手工机制示意，非实测。固定一层、一个 attention head；当前块强制保留。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#5B6875;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
