        </mxCell>
        <mxCell id="01-nsa-prefill-359" value="&lt;div style=&quot;line-height:1.25&quot;&gt;蓝 = 精选块；白 = 精选分支未选；灰 = 未来。手工示意集合，不是实测轨迹。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#5B6875;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
