        <mxCell id="01-nsa-prefill-693" value="&lt;div style=&quot;line-height:1.25&quot;&gt;金 = 窗口内；白 = 窗口外；灰 = 未来。窗口范围：max(1, t−W+1) ≤ j ≤ t。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#5B6875;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
