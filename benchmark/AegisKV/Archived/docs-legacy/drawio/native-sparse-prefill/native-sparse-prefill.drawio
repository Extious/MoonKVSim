        <mxCell id="02-moba-prefill-2" value="&lt;div style=&quot;line-height:1.25&quot;&gt;MoBA：通过 Query 与整块 K 均值匹配选块&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=32;fontColor=#19344A;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;fontStyle=1;" vertex="1" parent="1">
