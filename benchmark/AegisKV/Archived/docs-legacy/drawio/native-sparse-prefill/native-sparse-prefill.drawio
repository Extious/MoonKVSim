        <mxCell id="04-dsa-prefill-338" value="&lt;div style=&quot;line-height:1.25&quot;&gt;每个小格 = 1 个 Token；粗边界每 4 个 Token 一块。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=20;fontColor=#5B6875;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="110" y="711" width="576" height="28" />
        </mxCell>
        <mxCell id="04-dsa-prefill-339" value="&lt;div style=&quot;line-height:1.25&quot;&gt;蓝：6 个 Token。&lt;br&gt;&lt;br&gt;B1 … B8 只是共同&lt;br&gt;位置参考，DSA 在&lt;br&gt;这里按单 Token 选。&lt;br&gt;&lt;br&gt;索引 K 是额外状态。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#19344A;align=left;verticalAlign=middle;spacing=8;fillColor=#F4F7FA;strokeColor=none;strokeWidth=1;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="725" y="450" width="320" height="239" />
        </mxCell>
        <mxCell id="04-dsa-prefill-340" value="&lt;div style=&quot;line-height:1.25&quot;&gt;选择可以落在块内零散位置；逻辑 Token 数不等于系统实际需要搬运的整块字节数。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#5B6875;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="745" width="1010" height="44" />
        </mxCell>
        <mxCell id="04-dsa-prefill-341" value="&lt;div style=&quot;line-height:1.25&quot;&gt;所选历史 KV：Peer HBM 直接复用，DRAM 需 H2D；存放位置不改变模型选择。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#5B6875;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="825" width="1010" height="34" />
        </mxCell>
      </root>
    </mxGraphModel>
