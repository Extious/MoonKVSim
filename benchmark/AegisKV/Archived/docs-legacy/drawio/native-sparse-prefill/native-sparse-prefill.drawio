  <diagram id="05-nosa-prefill" name="5 · NOSA">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1080" pageHeight="1000" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="05-nosa-prefill-1" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#19344A;align=center;verticalAlign=middle;spacing=0;fillColor=#FFFFFF;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="0" y="0" width="1080" height="1000" />
        </mxCell>
        <mxCell id="05-nosa-prefill-2" value="&lt;div style=&quot;line-height:1.25&quot;&gt;NOSA：Query 相关选择与 CIS 重要性选择结合&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=32;fontColor=#19344A;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1020" height="45" />
        </mxCell>
        <mxCell id="05-nosa-prefill-3" value="&lt;div style=&quot;line-height:1.25&quot;&gt;手工机制示意，非实测。固定一层、一个 KV 组；颜色区分选择来源，不表示权重。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#5B6875;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="75" width="1020" height="52" />
        </mxCell>
        <mxCell id="05-nosa-prefill-4" value="&lt;div style=&quot;line-height:1.25&quot;&gt;M = 24，N = 8；后续 Query 为 q25 … q32；每 4 个 Token 画一个参考块。&lt;br&gt;同层 N 行可并行，各行选择可不同；Query q_t 只能选择位置 j ≤ t 的 KV。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#19344A;align=center;verticalAlign=middle;spacing=0;fillColor=#EAF2FA;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="140" width="1010" height="72" />
