        <mxCell id="02-moba-prefill-364" value="&lt;div style=&quot;line-height:1.25&quot;&gt;每个小格 = 1 个 Token；粗边界每 4 个 Token 一块。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=20;fontColor=#5B6875;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="110" y="711" width="576" height="28" />
        </mxCell>
        <mxCell id="02-moba-prefill-365" value="&lt;div style=&quot;line-height:1.25&quot;&gt;蓝：2 个历史块。&lt;br&gt;金：当前块。&lt;br&gt;&lt;br&gt;当前块不靠整块均值&lt;br&gt;决定是否入选，防止&lt;br&gt;未来 K 影响路由。&lt;br&gt;块内仍做因果屏蔽。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#19344A;align=left;verticalAlign=middle;spacing=8;fillColor=#F4F7FA;strokeColor=none;strokeWidth=1;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="725" y="450" width="320" height="239" />
        </mxCell>
        <mxCell id="02-moba-prefill-366" value="&lt;div style=&quot;line-height:1.25&quot;&gt;Query 属于同一块，也可以选择不同历史块；这里的块划分是 K/V 侧的逻辑单位。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#5B6875;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="745" width="1010" height="44" />
        </mxCell>
        <mxCell id="02-moba-prefill-367" value="&lt;div style=&quot;line-height:1.25&quot;&gt;所选历史 KV：Peer HBM 直接复用，DRAM 需 H2D；存放位置不改变模型选择。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#5B6875;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="825" width="1010" height="34" />
        </mxCell>
