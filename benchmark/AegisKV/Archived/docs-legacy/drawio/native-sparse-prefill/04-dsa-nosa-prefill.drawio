        <mxCell id="04-dsa-nosa-prefill-714" value="&lt;div style=&quot;line-height:1.25&quot;&gt;每个小格 = 1 个 Token；粗边界每 4 个 Token 一块。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=20;fontColor=#5B6875;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="110" y="1313" width="576" height="28" />
        </mxCell>
        <mxCell id="04-dsa-nosa-prefill-715" value="&lt;div style=&quot;line-height:1.25&quot;&gt;蓝：1 个相关块。&lt;br&gt;金：首块 + 本地 2 块。&lt;br&gt;绿：按 CIS 补入 1 块。&lt;br&gt;&lt;br&gt;本例中 B3 反复入选；&lt;br&gt;这是示意的排序条件，&lt;br&gt;不代表永久固定。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#19344A;align=left;verticalAlign=middle;spacing=8;fillColor=#F4F7FA;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="725" y="1055" width="320" height="250" />
        </mxCell>
        <mxCell id="04-dsa-nosa-prefill-716" value="&lt;div style=&quot;line-height:1.25&quot;&gt;本次真实实验使用 NOSA-1B；图中块长 4 是说明用缩小例子，实测使用块长 64。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#19344A;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="1358" width="1010" height="34" />
        </mxCell>
        <mxCell id="04-dsa-nosa-prefill-717" value="&lt;div style=&quot;line-height:1.25&quot;&gt;原始模型还将 CIS 用于 attention 的加权归一化；图中选择后计算保留该机制。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#5B6875;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="1398" width="1010" height="30" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
