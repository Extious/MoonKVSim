                <mxCell id="05-nosa-prefill-2" value="&lt;div style=&quot;line-height:1.25&quot;&gt;NOSA：Query 相关选择与 CIS 重要性选择结合&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=32;fontColor=#19344A;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;fontStyle=1;" parent="1" vertex="1">
