        <mxCell id="03-infllmv2-prefill-372" value="&lt;div style=&quot;line-height:1.25&quot;&gt;每个小格 = 1 个 Token；粗边界每 4 个 Token 一块。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=20;fontColor=#5B6875;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="110" y="711" width="576" height="28" />
        </mxCell>
        <mxCell id="03-infllmv2-prefill-373" value="&lt;div style=&quot;line-height:1.25&quot;&gt;蓝：1 个相关块。&lt;br&gt;金：首块 + 本地 2 块。&lt;br&gt;&lt;br&gt;压缩 K 用于选择。&lt;br&gt;没有 NSA 的独立&lt;br&gt;压缩输出分支。&lt;br&gt;本图展示稀疏路径。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#19344A;align=left;verticalAlign=middle;spacing=8;fillColor=#F4F7FA;strokeColor=none;strokeWidth=1;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="725" y="450" width="320" height="239" />
        </mxCell>
        <mxCell id="03-infllmv2-prefill-374" value="&lt;div style=&quot;line-height:1.25&quot;&gt;示意局部范围覆盖当前块与前一块；第 5 行开始，局部范围随位置向后移动。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#5B6875;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="745" width="1010" height="44" />
        </mxCell>
        <mxCell id="03-infllmv2-prefill-375" value="&lt;div style=&quot;line-height:1.25&quot;&gt;所选历史 KV：Peer HBM 直接复用，DRAM 需 H2D；存放位置不改变模型选择。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#5B6875;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="825" width="1010" height="34" />
        </mxCell>
      </root>
