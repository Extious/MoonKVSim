        <mxCell id="03-infllmv2-prefill-2" value="&lt;div style=&quot;line-height:1.25&quot;&gt;InfLLM-V2：子块评分，汇聚为整块优先级&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=32;fontColor=#19344A;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;fontStyle=1;" vertex="1" parent="1">
