        </mxCell>
        <mxCell id="02-nsa-prefill-3" value="&lt;div style=&quot;line-height:1.25&quot;&gt;机制示意；同一层、同一 GQA 组。矩阵仅展示精选分支，所有分支遵守因果性。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#5B6875;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
