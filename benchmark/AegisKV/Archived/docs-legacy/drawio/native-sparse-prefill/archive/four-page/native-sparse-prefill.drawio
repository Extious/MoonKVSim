          </mxGeometry>
        </mxCell>
        <mxCell id="04-dsa-nosa-prefill-345" value="&lt;div style=&quot;line-height:1.25&quot;&gt;NOSA：相关性选择 + 不依赖当前 Query 的重要性选择&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#19344A;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="745" width="1020" height="43" />
        </mxCell>
        <mxCell id="04-dsa-nosa-prefill-346" value="&lt;div style=&quot;line-height:1.25&quot;&gt;Query 相关块评分&lt;br&gt;Q × 压缩 K&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#19344A;align=center;verticalAlign=middle;spacing=0;fillColor=#EAF2FA;strokeColor=#B9CFE2;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="812" width="265" height="67" />
        </mxCell>
        <mxCell id="04-dsa-nosa-prefill-347" value="&lt;div style=&quot;line-height:1.25&quot;&gt;保留相关块&lt;br&gt;以及首部 / 局部块&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#19344A;align=center;verticalAlign=middle;spacing=0;fillColor=#EAF2FA;strokeColor=#B9CFE2;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
