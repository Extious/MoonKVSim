        <mxCell id="04-dsa-nosa-prefill-349" value="&lt;div style=&quot;line-height:1.25&quot;&gt;优先保留上面的块&lt;br&gt;其余按 CIS 补齐到预算&lt;br&gt;所选 KV → attention&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#19344A;align=center;verticalAlign=middle;spacing=0;fillColor=#EDF5F2;strokeColor=#A6CDBE;strokeWidth=1;rounded=0;arcSize=10;fontStyle=1;" vertex="1" parent="1">
