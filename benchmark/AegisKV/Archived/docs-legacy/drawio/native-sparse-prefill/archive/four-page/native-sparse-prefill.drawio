        </mxCell>
        <mxCell id="04-dsa-nosa-prefill-348" value="&lt;div style=&quot;line-height:1.25&quot;&gt;KV 自身的重要性&lt;br&gt;CIS：不依赖当前 Query&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#19344A;align=center;verticalAlign=middle;spacing=0;fillColor=#E5F2ED;strokeColor=#A6CDBE;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
