        <mxCell id="01-causal-prefill-326" value="&lt;div style=&quot;line-height:1.25&quot;&gt;浅蓝：因果可见的候选；灰斜线：未来位置；算法会进一步从候选中选择。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#5B6875;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="540" width="1010" height="35" />
        </mxCell>
        <mxCell id="01-causal-prefill-327" value="&lt;div style=&quot;line-height:1.25&quot;&gt;同层 Prefill 的实际依赖&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#19344A;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="600" width="1010" height="35" />
        </mxCell>
        <mxCell id="01-causal-prefill-328" value="&lt;div style=&quot;line-height:1.25&quot;&gt;N 个隐藏状态&lt;br&gt;投影出本层 Q / K / V&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#19344A;align=center;verticalAlign=middle;spacing=4;fillColor=#EAF2FA;strokeColor=#B9CFE2;strokeWidth=1;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="650" width="310" height="67" />
        </mxCell>
        <mxCell id="01-causal-prefill-329" value="&lt;div style=&quot;line-height:1.25&quot;&gt;历史 KV + 后续 KV&lt;br&gt;因果约束内逐 Query 选择&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#19344A;align=center;verticalAlign=middle;spacing=4;fillColor=#EAF2FA;strokeColor=#B9CFE2;strokeWidth=1;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="385" y="650" width="310" height="67" />
        </mxCell>
        <mxCell id="01-causal-prefill-330" value="&lt;div style=&quot;line-height:1.25&quot;&gt;所选 KV 参与 attention&lt;br&gt;得到 N 个本层输出&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#19344A;align=center;verticalAlign=middle;spacing=4;fillColor=#EAF2FA;strokeColor=#B9CFE2;strokeWidth=1;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="735" y="650" width="310" height="67" />
        </mxCell>
        <mxCell id="01-causal-prefill-331" style="strokeColor=#5B6875;strokeWidth=2;rounded=0;endArrow=block;endFill=1;endSize=8;dashed=0;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="345" y="683" />
            <mxPoint as="targetPoint" x="381" y="683" />
          </mxGeometry>
        </mxCell>
        <mxCell id="01-causal-prefill-332" style="strokeColor=#5B6875;strokeWidth=2;rounded=0;endArrow=block;endFill=1;endSize=8;dashed=0;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="695" y="683" />
            <mxPoint as="targetPoint" x="731" y="683" />
          </mxGeometry>
        </mxCell>
        <mxCell id="01-causal-prefill-333" value="&lt;div style=&quot;line-height:1.25&quot;&gt;N 行可并行计算，不等于共享一个选择集合；后续段已形成的本层 KV 也是候选。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#19344A;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="735" width="1010" height="32" />
        </mxCell>
        <mxCell id="01-causal-prefill-334" value="&lt;div style=&quot;line-height:1.25&quot;&gt;选中历史 KV 后：Peer HBM 可直接用，DRAM 需要 H2D；存放位置不改变合法候选。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#19344A;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="775" width="1010" height="32" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="02-nsa-prefill" name="NSA 的三个 attention 分支">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1080" pageHeight="1010" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="02-nsa-prefill-1" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#19344A;align=center;verticalAlign=middle;spacing=0;fillColor=#FFFFFF;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="0" y="0" width="1080" height="1010" />
        </mxCell>
        <mxCell id="02-nsa-prefill-2" value="&lt;div style=&quot;line-height:1.25&quot;&gt;NSA：压缩得分选原始块，三个分支分别计算&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=32;fontColor=#19344A;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;fontStyle=1;" vertex="1" parent="1">
