        <mxCell id="02-nsa-prefill-4" value="&lt;div style=&quot;line-height:1.25&quot;&gt;每个后续 Query&lt;br&gt;q1 … q8&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#19344A;align=center;verticalAlign=middle;spacing=0;fillColor=#EAF2FA;strokeColor=#B9CFE2;strokeWidth=1;rounded=0;arcSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="225" width="220" height="80" />
        </mxCell>
        <mxCell id="02-nsa-prefill-5" value="&lt;div style=&quot;line-height:1.25&quot;&gt;压缩 K / V attention&lt;br&gt;输出 Oc + 压缩得分&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#19344A;align=center;verticalAlign=middle;spacing=0;fillColor=#EAF2FA;strokeColor=#B9CFE2;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="350" y="150" width="310" height="76" />
        </mxCell>
        <mxCell id="02-nsa-prefill-6" value="&lt;div style=&quot;line-height:1.25&quot;&gt;Top-k 原始 KV 块&lt;br&gt;精选 attention → Os&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#19344A;align=center;verticalAlign=middle;spacing=0;fillColor=#EAF2FA;strokeColor=#B9CFE2;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
