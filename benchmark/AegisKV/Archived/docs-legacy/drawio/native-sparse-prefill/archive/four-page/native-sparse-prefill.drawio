        <mxCell id="02-nsa-prefill-355" value="&lt;div style=&quot;line-height:1.25&quot;&gt;每个小格 = 1 个 Token；粗边界每 4 个 Token 一块。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=20;fontColor=#5B6875;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="110" y="881" width="576" height="28" />
        </mxCell>
        <mxCell id="02-nsa-prefill-356" value="&lt;div style=&quot;line-height:1.25&quot;&gt;蓝色块由压缩得分选出。&lt;br&gt;&lt;br&gt;同组 Q heads 共享块；&lt;br&gt;不同 Query 可选不同块。&lt;br&gt;&lt;br&gt;本图不把压缩输出、&lt;br&gt;局部输出藏进这张矩阵。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#19344A;align=left;verticalAlign=middle;spacing=8;fillColor=#F4F7FA;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="725" y="625" width="320" height="258" />
        </mxCell>
        <mxCell id="02-nsa-prefill-357" value="&lt;div style=&quot;line-height:1.25&quot;&gt;例如 q5 选中了 B7：它来自后续段，却已经处于 q5 的因果可见范围。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#19344A;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="922" width="1010" height="34" />
        </mxCell>
        <mxCell id="02-nsa-prefill-358" value="&lt;div style=&quot;line-height:1.25&quot;&gt;蓝 = 精选块；白 = 精选分支未选；灰 = 未来。手工示意集合，不是实测轨迹。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#5B6875;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="966" width="1010" height="30" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
