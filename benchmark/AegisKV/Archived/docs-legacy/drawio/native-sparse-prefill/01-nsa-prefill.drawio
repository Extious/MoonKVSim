        </mxCell>
        <mxCell id="01-nsa-prefill-358" value="&lt;div style=&quot;line-height:1.25&quot;&gt;例如 q29 选中了 B7：它来自后续段，却已经处于 q29 的因果可见范围。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#19344A;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
