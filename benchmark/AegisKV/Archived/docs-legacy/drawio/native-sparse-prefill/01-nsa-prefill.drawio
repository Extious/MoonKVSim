        <mxCell id="01-nsa-prefill-7" value="&lt;div style=&quot;line-height:1.25&quot;&gt;Top-k 原始 KV 块&lt;br&gt;精选 attention → Os&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#19344A;align=center;verticalAlign=middle;spacing=0;fillColor=#EAF2FA;strokeColor=#B9CFE2;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
