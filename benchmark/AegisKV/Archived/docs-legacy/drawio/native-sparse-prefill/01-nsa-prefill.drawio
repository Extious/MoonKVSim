        </mxCell>
        <mxCell id="01-nsa-prefill-3" value="&lt;div style=&quot;line-height:1.25&quot;&gt;机制示意；同一层、同一 GQA 组。蓝色矩阵画精选分支，金色矩阵画滑动窗口。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#5B6875;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="75" width="1020" height="52" />
        </mxCell>
        <mxCell id="01-nsa-prefill-4" value="&lt;div style=&quot;line-height:1.25&quot;&gt;M = 24，N = 8；后续 Query 为 q25 … q32；每 4 个 Token 画一个参考块。&lt;br&gt;同层 N 行可并行，各行选择可不同；Query q_t 只能选择位置 j ≤ t 的 KV。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#19344A;align=center;verticalAlign=middle;spacing=0;fillColor=#EAF2FA;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="140" width="1010" height="72" />
        </mxCell>
        <mxCell id="01-nsa-prefill-5" value="&lt;div style=&quot;line-height:1.25&quot;&gt;每个后续 Query&lt;br&gt;q25 … q32&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#19344A;align=center;verticalAlign=middle;spacing=0;fillColor=#EAF2FA;strokeColor=#B9CFE2;strokeWidth=1;rounded=0;arcSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="315.0" width="220" height="80" />
        </mxCell>
        <mxCell id="01-nsa-prefill-6" value="&lt;div style=&quot;line-height:1.25&quot;&gt;压缩 K / V attention&lt;br&gt;输出 Oc；权重用于选块&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#19344A;align=center;verticalAlign=middle;spacing=0;fillColor=#EAF2FA;strokeColor=#B9CFE2;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
