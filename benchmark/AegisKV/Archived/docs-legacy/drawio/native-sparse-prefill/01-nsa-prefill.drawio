        </mxCell>
        <mxCell id="01-nsa-prefill-692" value="&lt;div style=&quot;line-height:1.25&quot;&gt;窗口逐 Token 滑动；B1 … B8 只作位置参考，不表示按块选择。&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#19344A;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;strokeWidth=1;rounded=0;arcSize=10;" vertex="1" parent="1">
