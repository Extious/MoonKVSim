<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="31.1.5">
  <diagram id="SL" name="SlackLandlord：符号与决策流程">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1320" pageHeight="2810" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="slr-canvas" value="" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=26;fontColor=#24364B;strokeColor=#FFFFFF;fillColor=#FFFFFF;rounded=1;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1320" height="2810" as="geometry" />
        </mxCell>
        <mxCell id="slr-title" value="&lt;b&gt;SlackLandlord：KV 备份决策&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=36;fontColor=#24364B;strokeColor=#246BA2;fillColor=#EDF5FB;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="25" width="1200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="slr-containers" value="单个目标池分别执行：Peer HBM / DRAM　·　&lt;i&gt;Q&lt;/i&gt;：最小堆　·　&lt;i&gt;Y&lt;/i&gt;：淘汰集合" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=24;fontColor=#24364B;strokeColor=#246BA2;fillColor=#EDF5FB;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="95" width="1200" height="42" as="geometry" />
        </mxCell>
        <mxCell id="slr-event" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b&gt;请求 / 新 chunk / 状态事件&lt;/b&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=26;fontColor=#24364B;strokeColor=#246BA2;fillColor=#EDF5FB;rounded=1;arcSize=50;" vertex="1" parent="1">
          <mxGeometry x="340" y="170" width="640" height="65" as="geometry" />
        </mxCell>
        <mxCell id="slr-metadata" value="&lt;div style=&quot;line-height:1.35&quot;&gt;更新 Slack 与共享引用；必要时修复排序下界&lt;br&gt;x ← 首个尚未备份的完整 chunk&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=25;fontColor=#24364B;strokeColor=#246BA2;fillColor=#EDF5FB;rounded=1;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="200" y="290" width="920" height="110" as="geometry" />
        </mxCell>
        <mxCell id="slr-priority" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b&gt;计算保护收益与 Priority&lt;/b&gt;&lt;br&gt;单请求贡献 = max(保护前恢复时间 − Slack, 0)&lt;br&gt;− max(保护后恢复时间 − Slack, 0)&lt;br&gt;G&lt;sub&gt;k&lt;/sub&gt; ← 汇总共享请求贡献　；　P&lt;sub&gt;k&lt;/sub&gt; = G&lt;sub&gt;k&lt;/sub&gt; / b&lt;sub&gt;k&lt;/sub&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=26;fontColor=#24364B;strokeColor=#7351A5;fillColor=#F5F0FA;rounded=1;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="190" y="455" width="940" height="155" as="geometry" />
        </mxCell>
        <mxCell id="slr-credit" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b&gt;Landlord：租金阈值与 Credit&lt;/b&gt;&lt;br&gt;H&lt;sub&gt;k&lt;/sub&gt; = 入池租金 + P&lt;sub&gt;k&lt;/sub&gt;　；　credit&lt;sub&gt;k&lt;/sub&gt; = b&lt;sub&gt;k&lt;/sub&gt; max(H&lt;sub&gt;k&lt;/sub&gt; − L, 0)&lt;br&gt;价值刷新沿用原入池租金，不自动续租&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=26;fontColor=#24364B;strokeColor=#7351A5;fillColor=#F5F0FA;rounded=1;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="200" y="665" width="920" height="145" as="geometry" />
        </mxCell>
        <mxCell id="slr-preview" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b&gt;创建临时堆与租金状态，仅用于预演&lt;/b&gt;&lt;br&gt;Θ&lt;sub&gt;x&lt;/sub&gt; ← L + P&lt;sub&gt;x&lt;/sub&gt;　；　Y ← ∅&lt;br&gt;后续 Q、L 均指预演状态；拒绝时丢弃&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=26;fontColor=#24364B;strokeColor=#246BA2;fillColor=#EDF5FB;rounded=1;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="250" y="865" width="820" height="125" as="geometry" />
        </mxCell>
        <mxCell id="slr-capacity" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b&gt;规划空间足够？&lt;/b&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=29;fontColor=#24364B;strokeColor=#A16A17;fillColor=#FFF7E8;rhombus;" vertex="1" parent="1">
          <mxGeometry x="425" y="1045" width="470" height="125" as="geometry" />
        </mxCell>
        <mxCell id="slr-pop" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b&gt;Lazy Refresh&lt;/b&gt;&lt;br&gt;从 Q 弹出最小下界项 y&lt;br&gt;按需刷新 G&lt;sub&gt;y&lt;/sub&gt;、P&lt;sub&gt;y&lt;/sub&gt;、H&lt;sub&gt;y&lt;/sub&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=26;fontColor=#24364B;strokeColor=#7351A5;fillColor=#F5F0FA;rounded=1;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="300" y="1225" width="720" height="125" as="geometry" />
        </mxCell>
        <mxCell id="slr-minimum" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b&gt;刷新后仍为最小项？&lt;/b&gt;&lt;br&gt;与其余候选下界比较&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=27;fontColor=#24364B;strokeColor=#7351A5;fillColor=#F5F0FA;rhombus;" vertex="1" parent="1">
          <mxGeometry x="360" y="1405" width="600" height="125" as="geometry" />
        </mxCell>
        <mxCell id="slr-threshold" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b&gt;H&lt;sub&gt;y&lt;/sub&gt; &amp;lt; Θ&lt;sub&gt;x&lt;/sub&gt; ?&lt;/b&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=29;fontColor=#24364B;strokeColor=#A16A17;fillColor=#FFF7E8;rhombus;" vertex="1" parent="1">
          <mxGeometry x="425" y="1585" width="470" height="125" as="geometry" />
        </mxCell>
        <mxCell id="slr-victim" value="&lt;div style=&quot;line-height:1.35&quot;&gt;Y ← Y ∪ {y}　；　L ← max(L, H&lt;sub&gt;y&lt;/sub&gt;)&lt;br&gt;credit&lt;sub&gt;y&lt;/sub&gt; = 0；累计拟释放空间&lt;br&gt;将新暴露的合法尾块加入 Q&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=26;fontColor=#24364B;strokeColor=#7351A5;fillColor=#F5F0FA;rounded=1;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="250" y="1765" width="820" height="145" as="geometry" />
        </mxCell>
        <mxCell id="slr-admit" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b&gt;G&lt;sub&gt;x&lt;/sub&gt; &amp;gt; D&lt;sub&gt;Y&lt;/sub&gt; ?&lt;/b&gt;&lt;br&gt;且前置检查通过&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=27;fontColor=#24364B;strokeColor=#A16A17;fillColor=#FFF7E8;rhombus;" vertex="1" parent="1">
          <mxGeometry x="360" y="2000" width="600" height="145" as="geometry" />
        </mxCell>
        <mxCell id="slr-copy" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b&gt;淘汰 Y、提交租金 L、为 x 分配空间&lt;/b&gt;&lt;br&gt;复制 → 完整有效 ACK → 发布备份&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=26;fontColor=#24364B;strokeColor=#177F67;fillColor=#EBF7F1;rounded=1;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="280" y="2210" width="760" height="100" as="geometry" />
        </mxCell>
        <mxCell id="slr-next" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b&gt;下一 chunk / 等待状态事件&lt;/b&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=26;fontColor=#24364B;strokeColor=#647383;fillColor=#F5F7F9;rounded=1;arcSize=50;" vertex="1" parent="1">
