        <mxCell id="ctrl_v_app" value="&lt;b&gt;vLLM Scheduler / Connector&lt;/b&gt;&lt;br&gt;block hash · external hit tokens&lt;br&gt;&lt;font color=&quot;#274C77&quot;&gt;PoolKey：model / cache_prefix / group / ranks&lt;/font&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#EDF4FC;strokeColor=#5B8DB8;strokeWidth=1.7;fontSize=12;fontColor=#274C77;fontFamily=Noto Sans CJK SC;" vertex="1" parent="control">
          <mxGeometry x="30" y="70" width="300" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="ctrl_v_client" value="&lt;b&gt;vLLM Store Client · control path&lt;/b&gt;&lt;br&gt;batch_is_exist&lt;br&gt;Put / Get object metadata&lt;br&gt;&lt;font color=&quot;#8A6116&quot;&gt;same client as data plane below&lt;/font&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFF4DF;strokeColor=#D69E2E;strokeWidth=1.7;fontSize=12;fontColor=#6B4A10;fontFamily=Noto Sans CJK SC;" vertex="1" parent="control">
          <mxGeometry x="380" y="70" width="330" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="master" value="&lt;b&gt;Mooncake Master&lt;/b&gt;&lt;br&gt;object allocation / eviction / lifecycle&lt;br&gt;key → replica descriptors&lt;br&gt;&lt;font color=&quot;#8A6116&quot;&gt;segment_name + offset + length + state&lt;/font&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFF6D8;strokeColor=#C9A227;strokeWidth=1.8;fontSize=13;fontColor=#5B4710;fontFamily=Noto Sans CJK SC;" vertex="1" parent="control">
