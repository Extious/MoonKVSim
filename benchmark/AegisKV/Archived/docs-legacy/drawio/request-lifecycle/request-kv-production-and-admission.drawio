        <mxCell id="edge-10-label" value="无可行&#10;候选" style="fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#A16A17;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fillColor=#FFFFFF;spacing=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="800" y="1115" width="85" height="80" />
