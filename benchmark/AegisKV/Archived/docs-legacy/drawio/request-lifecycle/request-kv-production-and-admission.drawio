        <mxCell id="frontier" value="读取本池 C，找当前连续前缀 f&#10;已有副本直接复用，不重复计 bytes&#10;从首缺口枚举已生成的连续候选组 X" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#24364B;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#24364B;fillColor=#F5F7FA;rounded=1;arcSize=8;" vertex="1" parent="lane1">
          <mxGeometry as="geometry" x="85" y="85" width="560" height="150" />
        </mxCell>
        <mxCell id="eligible" value="许可 / pending / 回收门槛通过？&#10;源、时限、staging 和物理容量&#10;允许复制当前 X？" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#A16A17;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#A16A17;fillColor=#FFF7E8;rhombus;" vertex="1" parent="lane1">
          <mxGeometry as="geometry" x="55" y="325" width="620" height="210" />
        </mxCell>
        <mxCell id="gain" value="计算当前保护收益&#10;A(X|C,t) = Φ(C,t) − Φ(C∪X,t)&#10;解释其单位字节价值：P = A / b(X)" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#7351A5;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#7351A5;fillColor=#F5F0FA;rounded=1;arcSize=8;" vertex="1" parent="lane1">
          <mxGeometry as="geometry" x="85" y="640" width="560" height="145" />
        </mxCell>
        <mxCell id="victims" value="若需要空间：按当前损失 / bytes&#10;选择合法删除闭包 Y，逐轮重算&#10;禁止删候选祖先和正在读取的对象" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#24364B;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#24364B;fillColor=#F5F7FA;rounded=1;arcSize=8;" vertex="1" parent="lane1">
          <mxGeometry as="geometry" x="85" y="875" width="560" height="145" />
        </mxCell>
        <mxCell id="improves" value="所有候选比较后，有计划满足&#10;Φ(C,t)−Φ((C\Y)∪X,t)&gt;η&#10;且 begin 再校验通过？" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#A16A17;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#A16A17;fillColor=#FFF7E8;rhombus;" vertex="1" parent="lane1">
          <mxGeometry as="geometry" x="55" y="1090" width="620" height="200" />
        </mxCell>
        <mxCell id="pause" value="无可行组：PAUSED&#10;推理继续；新事件后重试&#10;不永久封死后续 chunk" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#A16A17;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#A16A17;fillColor=#FFF7E8;rounded=1;arcSize=8;" vertex="1" parent="lane1">
          <mxGeometry as="geometry" x="15" y="1345" width="325" height="115" />
        </mxCell>
        <mxCell id="commit" value="预留 / PENDING → 逐批复制&#10;ACK 齐全且再校验：提交&#10;失败保留旧 C；回收见 2C" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#177F67;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#177F67;fillColor=#EBF7F1;rounded=1;arcSize=8;" vertex="1" parent="lane1">
