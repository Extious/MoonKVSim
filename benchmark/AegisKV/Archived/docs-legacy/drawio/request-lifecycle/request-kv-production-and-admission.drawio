        <mxCell id="edge-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#246BA2;strokeWidth=2.8;endArrow=block;endFill=1;endSize=10;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#246BA2;labelBackgroundColor=#FFFFFF;jettySize=20;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=1;entryPerimeter=1;" edge="1" parent="1" source="victims" target="improves">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge-13" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#A16A17;strokeWidth=2.8;endArrow=block;endFill=1;endSize=10;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#A16A17;labelBackgroundColor=#FFFFFF;jettySize=20;exitX=0.25;exitY=0.75;entryX=0.5;entryY=0;exitPerimeter=1;entryPerimeter=1;" edge="1" parent="1" source="improves" target="pause">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="edge-14" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#177F67;strokeWidth=2.8;endArrow=block;endFill=1;endSize=10;fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#177F67;labelBackgroundColor=#FFFFFF;jettySize=20;exitX=0.75;exitY=0.75;entryX=0.5;entryY=0;exitPerimeter=1;entryPerimeter=1;" edge="1" parent="1" source="improves" target="commit">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="priority" value="建议的 Priority：每字节可减少多少&#10;超出 Slack 的恢复损失&#10;&#10;Φ(C,t) = Σ活跃调用 wi [Ti(fi(C),t)−si(t)]₊&#10;Padd(X|C,t) = [Φ(C,t)−Φ(C∪X,t)] / b(X)&#10;单 chunk 是 X={k} 的特例" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#7351A5;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#7351A5;fillColor=#F5F0FA;rounded=1;arcSize=8;" vertex="1" parent="lane2">
          <mxGeometry as="geometry" x="85" y="85" width="560" height="285" />
        </mxCell>
        <mxCell id="estimate" value="Ti 的来源：按当前生成进度估计&#10;读取 + 剩余重算 + 输出重放&#10;在可行前缀与完整重算中取最小代价&#10;&#10;需用实测 / 校准模型提供参数；&#10;参考模块不会自动测出这些数值。" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#246BA2;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#246BA2;fillColor=#EDF5FB;rounded=1;arcSize=8;" vertex="1" parent="lane2">
          <mxGeometry as="geometry" x="85" y="475" width="560" height="255" />
        </mxCell>
        <mxCell id="credit" value="若另行选择历史租金 Credit：&#10;插入时 Hk = Lins + Pk&#10;初始总 Credit = bk · Pk&#10;剩余 Credit = bk · max(Hk − L, 0)&#10;&#10;H 是阈值，L 是本池累计压力租金；&#10;Credit 与插入 Priority 不同。" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#A16A17;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#A16A17;fillColor=#FFF7E8;rounded=1;arcSize=8;" vertex="1" parent="lane2">
          <mxGeometry as="geometry" x="85" y="830" width="560" height="285" />
        </mxCell>
