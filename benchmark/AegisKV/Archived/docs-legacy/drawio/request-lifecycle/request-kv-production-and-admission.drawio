        <mxCell id="context" value="记录当前 Slack、恢复代价模型和有效期&#10;关联已存在的兼容共享前缀&#10;管理对象是 chunk；调用提供价值上下文" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#24364B;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#24364B;fillColor=#F5F7FA;rounded=1;arcSize=8;" vertex="1" parent="lane0">
