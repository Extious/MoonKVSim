        <mxCell id="produce" value="执行 Prefill / Decode，逐步生成主 KV&#10;持续生产；每个完整 chunk 触发保护评估" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#24364B;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#24364B;fillColor=#F5F7FA;rounded=1;arcSize=8;" vertex="1" parent="lane0">
