                    <mxGeometry as="geometry" x="380" y="880" width="320" height="115"/>
                </mxCell>
                <mxCell id="rationale" value="为何不再维护逐块历史 credit&#xa;每次删除都重算前缀损失；尾块低价值&#xa;不代表此前所有块都应立即删除。&#xa;&#xa;零收益首块可与后续已生成块成组。&#xa;Gmax / staging 有界：不保证全局最优。" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#647383;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#647383;fillColor=#F5F7F9;rounded=1;arcSize=8;" vertex="1" parent="lane2">
