                <mxCell id="improves" value="Δ = Φ(C,t)−Φ(Cafter,t)&#xa;严格大于 η？" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#A16A17;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#A16A17;fillColor=#FFF7E8;rhombus;" vertex="1" parent="lane2">
