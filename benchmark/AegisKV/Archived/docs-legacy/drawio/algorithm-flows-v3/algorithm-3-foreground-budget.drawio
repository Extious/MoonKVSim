        <mxCell id="timer" value="独立 watchdog 事件&#10;定时器不是一条新的健康样本" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#7351A5;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#7351A5;fillColor=#F5F0FA;rounded=1;arcSize=8;" vertex="1" parent="lane2">
