        </mxCell>
        <mxCell id="timeout" value="① pending deadline 到期：中止复制组&#10;旧 C 保留；组占用等取消 / FreeACK&#10;未到期则保持 pending" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#AB4346;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#AB4346;fillColor=#FCF0F0;rounded=1;arcSize=8;" vertex="1" parent="lane2">
          <mxGeometry as="geometry" x="85" y="305" width="560" height="145" />
        </mxCell>
        <mxCell id="ttl" value="② TTL 到期：删除到期消费者引用&#10;仅回收无剩余引用且未 pinned 的对象&#10;物理回收沿用 2C-R" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#24364B;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#24364B;fillColor=#F5F7FA;rounded=1;arcSize=8;" vertex="1" parent="lane2">
          <mxGeometry as="geometry" x="85" y="560" width="560" height="140" />
        </mxCell>
        <mxCell id="reads" value="③ read lease 到期：返回待取消 ID&#10;恢复先预留 primary，才能获取源 read lease&#10;到期不代表 DMA 结束，不直接 free&#10;read-done / cancel ACK 后才解除 pin" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#A16A17;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#A16A17;fillColor=#FFF7E8;rounded=1;arcSize=8;" vertex="1" parent="lane2">
          <mxGeometry as="geometry" x="85" y="800" width="560" height="200" />
        </mxCell>
        <mxCell id="expired" value="④ 许可到期：保留原 sample 时间&#10;新 sequence + valid=false → 3A&#10;不制造健康样本、不积累稳定时间" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#AB4346;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#AB4346;fillColor=#FCF0F0;rounded=1;arcSize=8;" vertex="1" parent="lane2" data-source="RevisionRuntime.watchdog">
          <mxGeometry as="geometry" x="85" y="1100" width="560" height="160" />
        </mxCell>
        <mxCell id="scope" value="无域内认证 ⇒ 不启用新 HBM 保护&#10;有内存余量 ≠ 已证明推理零干扰&#10;实测证书由接入/校准方提供" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#647383;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#647383;fillColor=#F5F7F9;rounded=1;arcSize=8;" vertex="1" parent="lane2">
