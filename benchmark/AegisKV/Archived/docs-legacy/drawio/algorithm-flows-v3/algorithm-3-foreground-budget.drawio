        <mxCell id="memory" value="H = max(0, Mphys − Mfixed − Mprimary&#10;                        − Mnext − Rburst − Ralloc)&#10;Qmem = min(Mreg, Qpolicy, Lalloc, H)&#10;&#10;各项互不重复；Mnext 只指本次新增&#10;Lalloc 来自真实可借页，不是 CUDA free&#10;Rburst 覆盖取消和 FreeACK 前的增长" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#7351A5;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#7351A5;fillColor=#F5F0FA;rounded=1;arcSize=8;" vertex="1" parent="lane1" data-source="MemoryEnvelope.backup_limit">
          <mxGeometry as="geometry" x="85" y="85" width="560" height="305" />
        </mxCell>
        <mxCell id="healthy" value="样本有效且新鲜？&#10;无前台违约？&#10;认证域 / 证书有效？" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#A16A17;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#A16A17;fillColor=#FFF7E8;rhombus;" vertex="1" parent="lane1">
          <mxGeometry as="geometry" x="55" y="515" width="620" height="195" />
        </mxCell>
        <mxCell id="cap" value="Q* = min(Qmem, Qcert, D)&#10;D 含值得保留的保护、新组和 staging&#10;首次 / 采样断档 / 认证域变化：&#10;重置稳定起点；本次 Δt = 0" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#24364B;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#24364B;fillColor=#F5F7FA;rounded=1;arcSize=8;" vertex="1" parent="lane1">
