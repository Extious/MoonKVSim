<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="31.1.5">
  <diagram id="flow" name="2 · SlackLandlord：一次请求中一个 KV chunk 的决策">
    <mxGraphModel math="1" grid="0" page="1" pageWidth="3760" pageHeight="3620" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="sla-flow-canvas" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;locked=1;connectable=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="0" y="0" width="3760" height="3620" />
        </mxCell>
        <mxCell id="sla-flow-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;SlackLandlord  ·  Agent 的请求到来，决策其中一个 KV chunk x&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=40;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="25" width="3640" height="80" />
        </mxCell>
        <mxCell id="sla-flow-subtitle" value="&lt;div style=&quot;line-height:1.4&quot;&gt;请求中的完整 KV 按前缀顺序逐块处理；先按当前 Agent 估值和续租，再用 H、L 决定新副本准入。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="115" width="3640" height="65" />
        </mxCell>
        <mxCell id="sla-flow-symbols-0" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(a\)：当前 Agent；\(x\)：本请求的完整 KV 块；\(s_a\)：本请求固定 Slack；\(b_x\)：块的物理字节数&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="220" width="3620" height="57" />
        </mxCell>
        <mxCell id="sla-flow-symbols-1" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(G_{a,x}\)：a 的恢复收益；\(T_a(k)\)：用前 k 块备份恢复已生成 KV 的时间；\(k_a\)：x 前面的块数&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="277" width="3620" height="57" />
        </mxCell>
        <mxCell id="sla-flow-symbols-2" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(c_{u,x}\)：最近结算时 Agent u 的信用份额；\(u,v\)：遍历该块的 Agent；\(\mathrm{Credit}_x\)：结算后的总余额&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="334" width="3620" height="57" />
        </mxCell>
        <mxCell id="sla-flow-symbols-3" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(L\)：本池累计每字节租金，初值 0；\(L^{\prime}\)：本次试算租金；\(H_x\)：租值键；H、L 单位均为时间/字节&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="391" width="3620" height="57" />
        </mxCell>
        <mxCell id="sla-flow-symbols-4" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(Q\)：按 H 排序的可释放尾块；排除读取、必要前缀、其他备份操作保护与释放中的块&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="448" width="3620" height="57" />
        </mxCell>
        <mxCell id="sla-flow-symbols-5" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(Y\)：试算回收块；\(f\)：试算可用字节；\(y,z\)：旧尾块及新暴露尾块；每个请求、Agent、副本代次只授信一次&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="505" width="3620" height="57" />
        </mxCell>
        <mxCell id="sla-flow-candidate" value="&lt;div style=&quot;line-height:1.4&quot;&gt;① Agent a 的请求到来，取其中一个完整 KV chunk x&lt;br&gt;读取本请求 Slack、请求号与 x 状态；无副本则空分账&lt;br&gt;新生成块在封闭后进入本流程&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="620" width="1300" height="155" />
        </mxCell>
        <mxCell id="sla-flow-event-state" value="&lt;div style=&quot;line-height:1.4&quot;&gt;本请求对 x 的处理状态？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1430" y="830" width="840" height="150" />
        </mxCell>
        <mxCell id="sla-flow-skip" value="&lt;div style=&quot;line-height:1.4&quot;&gt;本次结束&lt;br&gt;重复或过期请求不重新授信&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="835" width="960" height="140" />
        </mxCell>
        <mxCell id="sla-flow-defer" value="&lt;div style=&quot;line-height:1.4&quot;&gt;暂缓处理 x，不授信、不复制&lt;br&gt;操作完成或前缀 / 源就绪后，回到①重读&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="1050" width="960" height="150" />
        </mxCell>
        <mxCell id="sla-flow-unready" value="&lt;div style=&quot;line-height:1.4&quot;&gt;需要新副本，且前缀或源未就绪？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1430" y="1080" width="840" height="150" />
        </mxCell>
        <mxCell id="sla-flow-gain" value="&lt;div style=&quot;line-height:1.4&quot;&gt;② 只计算当前 Agent a 的恢复收益&lt;br&gt;\(G_{a,x}=\min\{T_a(k_a)-T_a(k_a+1),\max(T_a(k_a)-s_a,0)\}\)&lt;br&gt;比较前缀到 x 之前 / 到 x；其后已生成的 KV 重算&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="1300" width="1300" height="150" />
        </mxCell>
        <mxCell id="sla-flow-settle" value="&lt;div style=&quot;line-height:1.4&quot;&gt;③ 先结算 x 已支付的租金&lt;br&gt;\(\mathrm{Credit}_x\leftarrow b_x\max(H_x-L,0)\)&lt;br&gt;\(c_{u,x}\leftarrow c_{u,x}\,\frac{\mathrm{Credit}_x}{\sum_v c_{v,x}}\quad(\forall u)\)&lt;br&gt;仅已有 x ∈ Q 时执行；其余块保留份额&lt;br&gt;分母取结算前总额；总额为 0 时跳过&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="1530" width="1300" height="240" />
        </mxCell>
        <mxCell id="sla-flow-credit" value="&lt;div style=&quot;line-height:1.4&quot;&gt;④ 只续租当前 Agent a，并设置租值键&lt;br&gt;\(c_{a,x}\leftarrow G_{a,x},\quad \mathrm{Credit}_x\leftarrow\sum_u c_{u,x}\)&lt;br&gt;\(H_x\leftarrow L+\mathrm{Credit}_x/b_x\)&lt;br&gt;其他 Agent 保留租后余额；本次改动暂存&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="1820" width="1300" height="185" />
        </mxCell>
        <mxCell id="sla-flow-resident" value="&lt;div style=&quot;line-height:1.4&quot;&gt;x 已有已提交的备份？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1430" y="2090" width="840" height="150" />
        </mxCell>
        <mxCell id="sla-flow-renew-done" value="&lt;div style=&quot;line-height:1.4&quot;&gt;保存分账与 a 本请求已处理记录&lt;br&gt;\(x\in Q\)：更新堆中 \(H_x\)；否则冻结份额&lt;br&gt;内部块、读取中的块同样可续租，结束&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2790" y="2075" width="820" height="180" />
        </mxCell>
        <mxCell id="sla-flow-plan" value="&lt;div style=&quot;line-height:1.4&quot;&gt;⑤ 新副本：建立 L、Q 与账本的临时副本&lt;br&gt;\(L^{\prime}\leftarrow L,\quad Y\leftarrow\varnothing,\quad f\leftarrow\text{Pool 可用字节}\)&lt;br&gt;本次退出 Q 的块按③结算并冻结；保护 x 的必要前缀&lt;br&gt;新入 Q 者按左侧回收框建键；持续在 Q 中的 H 不变&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="2330" width="1300" height="220" />
        </mxCell>
        <mxCell id="sla-flow-fits" value="&lt;div style=&quot;line-height:1.4&quot;&gt;空间足够？\(f\ge b_x\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1430" y="2640" width="840" height="150" />
        </mxCell>
        <mxCell id="sla-flow-execute" value="&lt;div style=&quot;line-height:1.4&quot;&gt;⑥ 核验并执行备份计划&lt;br&gt;先核验请求、L / Q 版本、保护与容量；通过后提交临时状态&lt;br&gt;\(L\leftarrow L^{\prime},\qquad c_{a,x}\leftarrow b_x\max(H_x-L^{\prime},0)\)&lt;br&gt;冻结 x 的租后份额；撤销 Y 恢复资格后释放、分配并复制 x&lt;br&gt;只接受本副本代次的操作结果&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="2890" width="1300" height="245" />
        </mxCell>
        <mxCell id="sla-flow-copy-failed" value="&lt;div style=&quot;line-height:1.4&quot;&gt;执行失败：清理本次未完成分配&lt;br&gt;不发布 x；已执行的租金推进与释放不回滚&lt;br&gt;按实际状态恢复 Q，结束&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2790" y="3200" width="820" height="165" />
        </mxCell>
        <mxCell id="sla-flow-done" value="&lt;div style=&quot;line-height:1.4&quot;&gt;⑦ 复制完成：按当前 L 发布完整备份&lt;br&gt;\(\mathrm{Credit}_x\leftarrow\sum_u c_{u,x},\quad H_x\leftarrow L+\mathrm{Credit}_x/b_x\)&lt;br&gt;记录 a 本请求已授信；按保护状态入 Q 或冻结&lt;br&gt;复制期间不收租；不重算收益、不补满 Credit&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="3270" width="1300" height="220" />
        </mxCell>
        <mxCell id="sla-flow-has-tail" value="&lt;div style=&quot;line-height:1.4&quot;&gt;有可释放尾块？&lt;br&gt;\(Q\ne\varnothing\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="145" y="2130" width="810" height="150" />
        </mxCell>
        <mxCell id="sla-flow-rent" value="&lt;div style=&quot;line-height:1.4&quot;&gt;读取 Q 中租值键最小的尾块 y&lt;br&gt;\((y,H_y)\leftarrow\min Q\)&lt;br&gt;H 相同则按物理块 ID 选择&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="2370" width="960" height="145" />
        </mxCell>
        <mxCell id="sla-flow-alive" value="&lt;div style=&quot;line-height:1.4&quot;&gt;旧尾块会先耗尽信用？&lt;br&gt;\(H_y&amp;lt;H_x\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="165" y="2620" width="770" height="150" />
        </mxCell>
        <mxCell id="sla-flow-remove" value="&lt;div style=&quot;line-height:1.4&quot;&gt;推进试算租金，试删 y&lt;br&gt;\(L^{\prime}\leftarrow H_y,\quad Y\leftarrow Y\cup\{y\},\quad f\leftarrow f+b_y\)&lt;br&gt;移除 y；新暴露且可释放的尾块 z 入 Q：&lt;br&gt;\(H_z\leftarrow L^{\prime}+\frac{\sum_u c_{u,z}}{b_z}\)&lt;br&gt;原有其他 H 不变；候选 \(H_x\) 不重建&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="2870" width="960" height="245" />
        </mxCell>
        <mxCell id="sla-flow-reject" value="&lt;div style=&quot;line-height:1.4&quot;&gt;不备份 x，丢弃试算 L、Q 与账本&lt;br&gt;实际 L、已有副本及余额不变&lt;br&gt;候选与旧尾块同值也拒绝&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="3230" width="960" height="145" />
        </mxCell>
        <mxCell id="sla-flow-layout-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;共享块 x · 分账与租值键&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=30;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2790" y="835" width="820" height="60" />
        </mxCell>
        <mxCell id="sla-flow-layout-card" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Agent A：\(s_A,\ c_{A,x}\)，续租请求号&lt;br&gt;Agent B：\(s_B,\ c_{B,x}\)，续租请求号&lt;br&gt;块大小 \(b_x\)、租值键 \(H_x\)&lt;br&gt;副本状态、读取保护、是否在 Q 中&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2790" y="950" width="820" height="205" />
        </mxCell>
        <mxCell id="sla-flow-layout-pool-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Peer HBM Pool&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2790" y="1290" width="820" height="60" />
        </mxCell>
        <mxCell id="sla-flow-layout-slot-0" value="&lt;div style=&quot;line-height:1.4&quot;&gt;共享 x&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2790" y="1390" width="255" height="80" />
        </mxCell>
        <mxCell id="sla-flow-layout-slot-1" value="&lt;div style=&quot;line-height:1.4&quot;&gt;A2&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="3070" y="1390" width="255" height="80" />
        </mxCell>
        <mxCell id="sla-flow-layout-slot-2" value="&lt;div style=&quot;line-height:1.4&quot;&gt;A3&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="3350" y="1390" width="255" height="80" />
        </mxCell>
        <mxCell id="sla-flow-layout-slot-3" value="&lt;div style=&quot;line-height:1.4&quot;&gt;B2&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2790" y="1495" width="255" height="80" />
        </mxCell>
        <mxCell id="sla-flow-layout-slot-4" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C1&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="3070" y="1495" width="255" height="80" />
