                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="slr-edge-8-label" value="是" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=22;fontColor=#24364B;strokeColor=#177F67;fillColor=#EBF7F1;strokeColor=none;fillColor=none;spacing=0;" parent="1" vertex="1">
                    <mxGeometry x="95" y="1390" width="65" height="35" as="geometry"/>
                </mxCell>
                <mxCell id="slr-edge-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#647383;fontFamily=Noto Sans CJK SC;fontSize=23;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="slr-pop" target="slr-minimum" edge="1">
