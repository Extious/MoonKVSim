                <mxCell id="slr-edge-7-label" value="否" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=22;fontColor=#24364B;strokeColor=#647383;fillColor=#F5F7F9;strokeColor=none;fillColor=none;spacing=0;" parent="1" vertex="1">
