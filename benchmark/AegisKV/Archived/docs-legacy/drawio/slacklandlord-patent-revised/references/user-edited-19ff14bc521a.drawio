                <mxCell id="slr-edge-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2.5;strokeColor=#177F67;fontFamily=Noto Sans CJK SC;fontSize=23;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="slr-capacity" target="slr-jointloss" edge="1">
