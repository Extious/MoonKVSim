                <mxCell id="slr-abort-transfer" value="" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=26;fontColor=#24364B;strokeColor=#AB4346;fillColor=#FCF0F0;ellipse;fillColor=#AB4346;strokeColor=#AB4346;" parent="1" vertex="1">
                    <mxGeometry x="1257" y="2877" width="6" height="6" as="geometry"/>
