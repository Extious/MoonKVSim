<mxfile host="65bd71144e">
    <diagram id="PA2" name="专利算法2：SlackLandlord修订流程">
        <mxGraphModel dx="2148" dy="4492" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="3940" background="#FFFFFF" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="slr-canvas" value="" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=26;fontColor=#24364B;strokeColor=#FFFFFF;fillColor=#FFFFFF;rounded=1;arcSize=5;" parent="1" vertex="1">
                    <mxGeometry width="1320" height="3940" as="geometry"/>
                </mxCell>
                <mxCell id="slr-title" value="&lt;b&gt;SlackLandlord：KV 备份决策流程&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=35;fontColor=#24364B;strokeColor=#246BA2;fillColor=#EDF5FB;strokeColor=none;fillColor=none;spacing=0;" parent="1" vertex="1">
                    <mxGeometry x="50" y="25" width="1220" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="slr-source" value="基于算法 2" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=22;fontColor=#24364B;strokeColor=#246BA2;fillColor=#EDF5FB;strokeColor=none;fillColor=none;spacing=0;" parent="1" vertex="1">
                    <mxGeometry x="50" y="90" width="1220" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="slr-event" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b&gt;请求 i 到来：固定 Slack s&lt;sub&gt;i&lt;/sub&gt; 与兼容目标&lt;/b&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=26;fontColor=#24364B;strokeColor=#246BA2;fillColor=#EDF5FB;rounded=1;arcSize=50;" parent="1" vertex="1">
                    <mxGeometry x="240" y="165" width="840" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="slr-tiers" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b&gt;HBM / DRAM 各自执行以下流程&lt;/b&gt;&lt;br&gt;各自的 Q、L、容量与提交状态；互不以对方接纳为前提&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=26;fontColor=#24364B;strokeColor=#246BA2;fillColor=#EDF5FB;rounded=1;arcSize=5;" parent="1" vertex="1">
                    <mxGeometry x="180" y="285" width="960" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="slr-metadata" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b&gt;若复用已有 KV：登记新请求与复用时租金&lt;/b&gt;&lt;br&gt;续租目标：H ← max(H, L&lt;sub&gt;复用&lt;/sub&gt; + P&lt;sub&gt;新请求&lt;/sub&gt;)&lt;br&gt;同一请求只登记一次；到堆顶或暴露尾块时再兑现&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=25;fontColor=#24364B;strokeColor=#7351A5;fillColor=#F5F0FA;rounded=1;arcSize=5;" parent="1" vertex="1">
                    <mxGeometry x="140" y="425" width="1040" height="135" as="geometry"/>
                </mxCell>
                <mxCell id="slr-sealed" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b&gt;依序生成 / 选取首个未备份完整 chunk x&lt;/b&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=26;fontColor=#24364B;strokeColor=#246BA2;fillColor=#EDF5FB;rounded=1;arcSize=5;" parent="1" vertex="1">
                    <mxGeometry x="140" y="595" width="1040" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="slr-recovery" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b&gt;估计本层恢复时间 T&lt;sub&gt;0&lt;/sub&gt;, …, T&lt;sub&gt;x&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;加载 + 未保护后缀重算 + 静默重放&lt;br&gt;J&lt;sub&gt;k&lt;/sub&gt; = max(T&lt;sub&gt;k&lt;/sub&gt; − s&lt;sub&gt;i&lt;/sub&gt;, 0)&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=25;fontColor=#24364B;strokeColor=#246BA2;fillColor=#EDF5FB;rounded=1;arcSize=5;" parent="1" vertex="1">
                    <mxGeometry x="140" y="705" width="1040" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="slr-priority" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b&gt;累计前缀恢复收益，再计算 Priority&lt;/b&gt;&lt;br&gt;W&lt;sub&gt;k&lt;/sub&gt; = max(J&lt;sub&gt;k−1&lt;/sub&gt; − J&lt;sub&gt;k&lt;/sub&gt;, 0)&lt;br&gt;G&lt;sub&gt;x&lt;/sub&gt; = ∑&lt;sub&gt;k=1&lt;/sub&gt;&lt;sup&gt;x&lt;/sup&gt; W&lt;sub&gt;k&lt;/sub&gt;　（恢复权重 λ&lt;sub&gt;w&lt;/sub&gt; = 1）&lt;br&gt;P&lt;sub&gt;x&lt;/sub&gt; = G&lt;sub&gt;x&lt;/sub&gt; / b&lt;sub&gt;x&lt;/sub&gt;　；　Θ&lt;sub&gt;x&lt;/sub&gt; ← L + P&lt;sub&gt;x&lt;/sub&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=25;fontColor=#24364B;strokeColor=#246BA2;fillColor=#EDF5FB;rounded=1;arcSize=5;" parent="1" vertex="1">
                    <mxGeometry x="140" y="900" width="1040" height="180" as="geometry"/>
                </mxCell>
                <mxCell id="slr-preview" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b&gt;Y ← ∅；Q ← 本池尾块堆的临时视图；f ← 空闲字节&lt;/b&gt;&lt;br&gt;只纳入合法尾块；跳过 x 所属请求及其共享前缀依赖&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=25;fontColor=#24364B;strokeColor=#246BA2;fillColor=#EDF5FB;rounded=1;arcSize=5;" parent="1" vertex="1">
                    <mxGeometry x="180" y="1140" width="960" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="slr-capacity" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b&gt;f ≥ b&lt;sub&gt;x&lt;/sub&gt; ?&lt;/b&gt;&lt;br&gt;规划空间足够&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=29;fontColor=#24364B;strokeColor=#A16A17;fillColor=#FFF7E8;rhombus;" parent="1" vertex="1">
                    <mxGeometry x="425" y="1305" width="470" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="slr-pop" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b&gt;Lazy Refresh：兑现 y 尚未处理的续租&lt;/b&gt;&lt;br&gt;从 Q 取最小旧键 y；按新请求的固定 Slack 计算 P&lt;br&gt;H&lt;sub&gt;y&lt;/sub&gt; ← max(H&lt;sub&gt;y&lt;/sub&gt;, L&lt;sub&gt;复用&lt;/sub&gt; + P&lt;sub&gt;新请求&lt;/sub&gt;)&lt;br&gt;credit&lt;sub&gt;y&lt;/sub&gt; = b&lt;sub&gt;y&lt;/sub&gt; max(H&lt;sub&gt;y&lt;/sub&gt; − L, 0)&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=25;fontColor=#24364B;strokeColor=#7351A5;fillColor=#F5F0FA;rounded=1;arcSize=5;" parent="1" vertex="1">
                    <mxGeometry x="250" y="1485" width="820" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="slr-minimum" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b&gt;H&lt;sub&gt;y&lt;/sub&gt; ≤ min(Q 中其余旧键) ?&lt;/b&gt;&lt;br&gt;续租后仍为最小项&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=25;fontColor=#24364B;strokeColor=#7351A5;fillColor=#F5F0FA;rhombus;" parent="1" vertex="1">
                    <mxGeometry x="335" y="1680" width="650" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="slr-threshold" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b&gt;H&lt;sub&gt;y&lt;/sub&gt; &amp;lt; Θ&lt;sub&gt;x&lt;/sub&gt; ?&lt;/b&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=29;fontColor=#24364B;strokeColor=#A16A17;fillColor=#FFF7E8;rhombus;" parent="1" vertex="1">
                    <mxGeometry x="425" y="1865" width="470" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="slr-victim" value="&lt;div style=&quot;line-height:1.35&quot;&gt;Y ← Y ∪ {y}　；　f ← f + b&lt;sub&gt;y&lt;/sub&gt;&lt;br&gt;暴露并刷新前一合法尾块，再加入 Q&lt;br&gt;共享块只释放一次；更新合法尾块索引&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=25;fontColor=#24364B;strokeColor=#7351A5;fillColor=#F5F0FA;rounded=1;arcSize=5;" parent="1" vertex="1">
                    <mxGeometry x="180" y="2040" width="960" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="slr-jointloss" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b&gt;计算新增收益与整个 Y 的淘汰损失&lt;/b&gt;&lt;br&gt;ΔG&lt;sub&gt;x&lt;/sub&gt; = G&lt;sub&gt;x&lt;/sub&gt; − G&lt;sub&gt;前一块&lt;/sub&gt; = W&lt;sub&gt;x&lt;/sub&gt;&lt;br&gt;D&lt;sub&gt;Y&lt;/sub&gt; = WCT(加入 x、移除 Y) − WCT(仅加入 x)&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=24;fontColor=#24364B;strokeColor=#246BA2;fillColor=#EDF5FB;rounded=1;arcSize=5;" parent="1" vertex="1">
                    <mxGeometry x="140" y="2230" width="1040" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="slr-admit" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b&gt;ΔG&lt;sub&gt;x&lt;/sub&gt; &amp;gt; D&lt;sub&gt;Y&lt;/sub&gt; ?&lt;/b&gt;&lt;br&gt;且前置检查通过&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=25;fontColor=#24364B;strokeColor=#A16A17;fillColor=#FFF7E8;rhombus;" parent="1" vertex="1">
                    <mxGeometry x="315" y="2450" width="690" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="slr-pending" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b&gt;撤销并释放 Y；分配 x → PENDING&lt;/b&gt;&lt;br&gt;L ← max(L, max&lt;sub&gt;y∈Y&lt;/sub&gt; H&lt;sub&gt;y&lt;/sub&gt;)　（Y = ∅ 时 L 不变）&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=25;fontColor=#24364B;strokeColor=#246BA2;fillColor=#EDF5FB;rounded=1;arcSize=5;" parent="1" vertex="1">
                    <mxGeometry x="150" y="2660" width="1020" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="slr-transfer" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b&gt;从源 Worker 直接复制&lt;/b&gt;&lt;br&gt;HBM：D2D / P2P　；　DRAM：D2H&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=26;fontColor=#24364B;strokeColor=#246BA2;fillColor=#EDF5FB;rounded=1;arcSize=5;" parent="1" vertex="1">
                    <mxGeometry x="240" y="2830" width="840" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="slr-ack" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b&gt;分片完整且版本有效？&lt;/b&gt;&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=27;fontColor=#24364B;strokeColor=#A16A17;fillColor=#FFF7E8;rhombus;" parent="1" vertex="1">
                    <mxGeometry x="315" y="2990" width="690" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="slr-commit" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b&gt;确认前缀完整，初始化新副本租值键&lt;/b&gt;&lt;br&gt;H&lt;sub&gt;x&lt;/sub&gt; ← L + G&lt;sub&gt;x&lt;/sub&gt; / b&lt;sub&gt;x&lt;/sub&gt; = L + P&lt;sub&gt;x&lt;/sub&gt;&lt;br&gt;COMMITTED；加入本层索引&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=25;fontColor=#24364B;strokeColor=#177F67;fillColor=#EBF7F1;rounded=1;arcSize=5;" parent="1" vertex="1">
                    <mxGeometry x="250" y="3180" width="820" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="slr-result" value="&lt;div style=&quot;line-height:1.35&quot;&gt;&lt;b&gt;两层均结束后组合结果；继续后续 chunk / 重试事件&lt;/b&gt;&lt;br&gt;HBM_ONLY　/　DRAM_ONLY　/　HBM_AND_DRAM　/　BYPASS&lt;/div&gt;" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=23;fontColor=#24364B;strokeColor=#647383;fillColor=#F5F7F9;rounded=1;arcSize=50;" parent="1" vertex="1">
                    <mxGeometry x="90" y="3390" width="1140" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="slr-bypass-pop" value="" style="whiteSpace=wrap;html=1;fontFamily=Noto Sans CJK SC;align=center;verticalAlign=middle;spacing=8;strokeWidth=2;fontSize=26;fontColor=#24364B;strokeColor=#AB4346;fillColor=#FCF0F0;ellipse;fillColor=#AB4346;strokeColor=#AB4346;" parent="1" vertex="1">
                    <mxGeometry x="1257" y="1552" width="6" height="6" as="geometry"/>
