                <mxCell id="sla-agents-physical-C1" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C1&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-agents-physical" vertex="1">
                    <mxGeometry x="35" y="230" width="250" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-physical-C2" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C2&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-agents-physical" vertex="1">
                    <mxGeometry x="315" y="230" width="250" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-physical-C3" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C3&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-agents-physical" vertex="1">
                    <mxGeometry x="595" y="230" width="250" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-physical-C4" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C4&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-agents-physical" vertex="1">
                    <mxGeometry x="875" y="230" width="250" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-physical-A5" value="&lt;div style=&quot;line-height:1.4&quot;&gt;A5&lt;br&gt;COPYING&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;dashed=1;dashPattern=7 5;" parent="sla-agents-physical" vertex="1">
                    <mxGeometry x="1155" y="230" width="250" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-physical-note" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Pool 包含 9 个已提交块；A5 另占 1 块空间。&lt;br&gt;恢复仅使用已提交的连续前缀；内部共享块有后继时不能单独删除。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-agents-physical" vertex="1">
                    <mxGeometry x="25" y="340" width="1390" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-state-panel" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;container=1;pointerEvents=0;" parent="1" vertex="1">
                    <mxGeometry x="1560" y="1110" width="780" height="435" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-state-panel-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Pool 需要维护的状态&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" parent="sla-agents-state-panel" vertex="1">
                    <mxGeometry x="20" y="12" width="740" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-state" value="&lt;div style=&quot;line-height:1.4&quot;&gt;容量与物理分配记录&lt;br&gt;COMMITTED / COPYING / RETIRING&lt;br&gt;读取保护与分配代次&lt;br&gt;各 Agent 的剩余信用、最近续租请求号&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-agents-state-panel" vertex="1">
                    <mxGeometry x="30" y="90" width="720" height="205" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-state-note" value="&lt;div style=&quot;line-height:1.4&quot;&gt;每个 Agent 单独续租；物理块只收一份租金。&lt;br&gt;只有释放 ACK 才减少实际占用。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-agents-state-panel" vertex="1">
                    <mxGeometry x="30" y="315" width="720" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-round" value="&lt;div style=&quot;line-height:1.4&quot;&gt;新请求到来&lt;br&gt;记录本轮 Slack 与请求号&lt;br&gt;本轮生成过程中 Slack 不变&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1630" width="690" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-produce" value="&lt;div style=&quot;line-height:1.4&quot;&gt;复用已有 KV&lt;br&gt;按新 Slack 重算该块收益&lt;br&gt;刷新本 Agent 的 Credit&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
                    <mxGeometry x="855" y="1630" width="690" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-edge-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jumpStyle=arc;jumpSize=9;" parent="1" source="sla-agents-round" target="sla-agents-produce" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-ack" value="&lt;div style=&quot;line-height:1.4&quot;&gt;生成新的完整 KV chunk&lt;br&gt;按前缀顺序进行准入决策&lt;br&gt;容量不足时收租并淘汰尾块&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
                    <mxGeometry x="1650" y="1630" width="690" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-edge-13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jumpStyle=arc;jumpSize=9;" parent="1" source="sla-agents-produce" target="sla-agents-ack" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-footer" value="&lt;div style=&quot;line-height:1.4&quot;&gt;第 2 页：每次只处理当前 Agent 的一个 KV 块；单独估值、单独续租，再用共享块的剩余 Credit 决策。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1850" width="2280" height="55" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="flow" name="2 · SlackLandlord：简化后的 KV 决策流程">
        <mxGraphModel dx="1132" dy="818" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3760" pageHeight="3410" background="#FFFFFF" math="1" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="sla-flow-canvas" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;locked=1;connectable=0;" parent="1" vertex="1">
                    <mxGeometry width="3760" height="3410" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;SlackLandlord  ·  逐 Agent 续租与 KV 备份决策&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=40;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="25" width="3640" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-subtitle" value="&lt;div style=&quot;line-height:1.4&quot;&gt;先确认事件与备份条件，再计算当前 Agent 的收益；已有副本续租结束，新副本才参与容量竞争。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="60" y="115" width="3640" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-symbols-0" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(a\)：当前 Agent；\(x\)：完整 KV 块；\(s_a\)：本请求固定的 Slack；\(b_x\)：物理字节数&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="70" y="225" width="3620" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-symbols-1" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(G_{a,x}\)：a 的独立恢复收益；\(c_{a,x}\)：a 的剩余信用；\(\mathrm{Credit}_x=\sum_a c_{a,x}\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="70" y="283" width="3620" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-symbols-2" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(T_a(k)\)：使用前 k 块备份恢复已生成 KV 的时间；\(k_a\)：x 前面的块数；不计未知未来 KV&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="70" y="341" width="3620" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-symbols-3" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(Q\)：已提交、无后继且可释放的尾块；排除读取、必要前缀、其他备份操作保护与释放中的块&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="70" y="399" width="3620" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-symbols-4" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(Y\)：试算回收块；\(f\)：试算可用字节；\(\delta\)：每字节租金；每个 Agent、请求、副本代次只授信一次&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="70" y="457" width="3620" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-candidate" value="&lt;div style=&quot;line-height:1.4&quot;&gt;① 读取 Agent a 当前请求对 x 的生成 / 复用事件&lt;br&gt;读取 x 状态、各 Agent 余额和 a 的续租请求号；无副本则空分账&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="1200" y="590" width="1300" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-event-state" value="&lt;div style=&quot;line-height:1.4&quot;&gt;本次事件状态？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" parent="1" vertex="1">
                    <mxGeometry x="1430" y="830" width="840" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-skip" value="&lt;div style=&quot;line-height:1.4&quot;&gt;本次结束&lt;br&gt;重复或过期事件不修改信用&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="70" y="840" width="960" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-defer" value="&lt;div style=&quot;line-height:1.4&quot;&gt;暂缓本事件，不授信、不复制&lt;br&gt;操作完成或前缀 / 源就绪后，回到①重读&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="70" y="1050" width="960" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-unready" value="&lt;div style=&quot;line-height:1.4&quot;&gt;需要新副本，且前缀或源未就绪？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" parent="1" vertex="1">
                    <mxGeometry x="1430" y="1110" width="840" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-gain" value="&lt;div style=&quot;line-height:1.4&quot;&gt;② 只计算当前 Agent a 的恢复收益&lt;br&gt;\(G_{a,x}=\min\{T_a(k_a)-T_a(k_a+1),\max(T_a(k_a)-s_a,0)\}\)&lt;br&gt;比较前缀到 x 之前 / 到 x；其后已生成的 KV 重算&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="1200" y="1380" width="1300" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-credit" value="&lt;div style=&quot;line-height:1.4&quot;&gt;③ 更新 a 的份额，再汇总共享 Credit&lt;br&gt;\(c_{a,x}\leftarrow G_{a,x},\qquad \mathrm{Credit}_x\leftarrow\sum_a c_{a,x}\)&lt;br&gt;其他 Agent 保留已扣租余额；本次改动暂存&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="1200" y="1660" width="1300" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-resident" value="&lt;div style=&quot;line-height:1.4&quot;&gt;x 已有已提交的备份？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" parent="1" vertex="1">
                    <mxGeometry x="1430" y="1940" width="840" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-renew-done" value="&lt;div style=&quot;line-height:1.4&quot;&gt;保存 a 的份额与本请求已处理记录，结束&lt;br&gt;内部块、读取中的块同样可续租；更新 Q&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="2790" y="1940" width="820" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-plan" value="&lt;div style=&quot;line-height:1.4&quot;&gt;④ 新副本：保护必要前缀，初始化 Q 与回收试算&lt;br&gt;\(Y\leftarrow\varnothing,\qquad f\leftarrow\text{Pool 空闲字节}\)&lt;br&gt;扣租和试删只修改临时记录&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="1200" y="2210" width="1300" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-fits" value="&lt;div style=&quot;line-height:1.4&quot;&gt;空间足够？\(f\ge b_x\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" parent="1" vertex="1">
                    <mxGeometry x="1430" y="2480" width="840" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-execute" value="&lt;div style=&quot;line-height:1.4&quot;&gt;⑤ 核验并执行备份计划&lt;br&gt;先核验状态、请求、保护与容量；通过后提交扣租&lt;br&gt;释放 Y 后分配并复制 x；只接受本代次结果&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="1200" y="2760" width="1300" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-copy-failed" value="&lt;div style=&quot;line-height:1.4&quot;&gt;执行失败：清理本次未完成分配，结束&lt;br&gt;不发布 x；已执行扣租与释放不回滚&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="2790" y="2910" width="820" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-done" value="&lt;div style=&quot;line-height:1.4&quot;&gt;⑥ 发布完整备份与竞争后的剩余信用&lt;br&gt;记录 a 本请求已授信；更新 Q，结束&lt;br&gt;不补满 Credit；等候事件随后各自处理&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="1200" y="3100" width="1300" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-has-tail" value="&lt;div style=&quot;line-height:1.4&quot;&gt;有可释放尾块且 x 尚有信用？&lt;br&gt;\(Q\ne\varnothing\ \land\ \mathrm{Credit}_x&amp;gt;0\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" parent="1" vertex="1">
                    <mxGeometry x="145" y="2080" width="810" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-rent" value="&lt;div style=&quot;line-height:1.4&quot;&gt;x 与 Q 中各块按物理字节收租&lt;br&gt;\(\delta=\min\{\mathrm{Credit}_x/b_x,\min_{y\in Q}\mathrm{Credit}_y/b_y\}\)&lt;br&gt;\(c_{a,y}\leftarrow c_{a,y}(1-b_y\delta/\mathrm{Credit}_y),\quad y\in Q\cup\{x\}\)&lt;br&gt;所有 Agent 均扣租，分母取扣租前总余额&lt;br&gt;零余额跳过除法，再汇总各块 Credit&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="70" y="2340" width="960" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-alive" value="&lt;div style=&quot;line-height:1.4&quot;&gt;收租后 x 仍有信用？&lt;br&gt;\(\mathrm{Credit}_x&amp;gt;0\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" parent="1" vertex="1">
                    <mxGeometry x="165" y="2680" width="770" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-remove" value="&lt;div style=&quot;line-height:1.4&quot;&gt;试删一个 Credit = 0 的旧尾块 y&lt;br&gt;\(Y\leftarrow Y\cup\{y\},\qquad f\leftarrow f+b_y\)&lt;br&gt;同值按块 ID 选择；更新 Q，新尾块下一轮再收租&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="70" y="2940" width="960" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-reject" value="&lt;div style=&quot;line-height:1.4&quot;&gt;不备份 x，丢弃整次试算&lt;br&gt;已有备份与余额不变；同时归零也拒绝 x&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="70" y="3210" width="960" height="110" as="geometry"/>
                </mxCell>
