                <mxCell id="sla-agents-physical-C1" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C1&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-agents-physical" vertex="1">
                    <mxGeometry x="35" y="230" width="250" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-physical-C2" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C2&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-agents-physical" vertex="1">
                    <mxGeometry x="315" y="230" width="250" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-physical-C3" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C3&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-agents-physical" vertex="1">
                    <mxGeometry x="595" y="230" width="250" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-physical-C4" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C4&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-agents-physical" vertex="1">
                    <mxGeometry x="875" y="230" width="250" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-physical-A5" value="&lt;div style=&quot;line-height:1.4&quot;&gt;A5&lt;br&gt;COPYING&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;dashed=1;dashPattern=7 5;" parent="sla-agents-physical" vertex="1">
                    <mxGeometry x="1155" y="230" width="250" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-physical-note" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Pool 包含 9 个已提交块；A5 另占 1 块空间。&lt;br&gt;恢复仅使用已提交的连续前缀；内部共享块有后继时不能单独删除。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-agents-physical" vertex="1">
                    <mxGeometry x="25" y="340" width="1390" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-state-panel" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;container=1;pointerEvents=0;" parent="1" vertex="1">
                    <mxGeometry x="1560" y="1110" width="780" height="435" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-state-panel-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Pool 需要维护的状态&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" parent="sla-agents-state-panel" vertex="1">
                    <mxGeometry x="20" y="12" width="740" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-state" value="&lt;div style=&quot;line-height:1.4&quot;&gt;容量与物理分配记录&lt;br&gt;COMMITTED / COPYING / RETIRING&lt;br&gt;固定读取引用与分配代次&lt;br&gt;Agent 子租约余额与已兑现轮号&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-agents-state-panel" vertex="1">
                    <mxGeometry x="30" y="90" width="720" height="205" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-state-note" value="&lt;div style=&quot;line-height:1.4&quot;&gt;每个 Agent 单独续租；物理块只收一份租金。&lt;br&gt;只有释放 ACK 才减少实际占用。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-agents-state-panel" vertex="1">
                    <mxGeometry x="30" y="315" width="720" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-round" value="&lt;div style=&quot;line-height:1.4&quot;&gt;新请求开始&lt;br&gt;替换本轮输入，登记一次续租资格&lt;br&gt;本轮生成过程中不调整 Slack&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1630" width="690" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-produce" value="&lt;div style=&quot;line-height:1.4&quot;&gt;生成完整 chunk&lt;br&gt;发布可读源与前缀关系&lt;br&gt;进入第 2 页的容量决策&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
                    <mxGeometry x="855" y="1630" width="690" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-edge-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jumpStyle=arc;jumpSize=9;" parent="1" source="sla-agents-round" target="sla-agents-produce" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-ack" value="&lt;div style=&quot;line-height:1.4&quot;&gt;请求结束：保留 Agent 的租约&lt;br&gt;Agent 结束：撤销自己的份额&lt;br&gt;共享物理块按尾块规则回收&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
                    <mxGeometry x="1650" y="1630" width="690" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-edge-13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jumpStyle=arc;jumpSize=9;" parent="1" source="sla-agents-produce" target="sla-agents-ack" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-footer" value="&lt;div style=&quot;line-height:1.4&quot;&gt;第 2 页：逐块准入与收租。内部前缀 / 固定读取块保存剩余信用；成为可释放尾块后继续收租。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1850" width="2280" height="55" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="flow" name="2 · SlackLandlord：单块准入、续租与收租">
        <mxGraphModel dx="1175" dy="1091" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="4330" background="#FFFFFF" math="1" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="sla-flow-canvas" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=none;rounded=1;arcSize=9;locked=1;connectable=0;" parent="1" vertex="1">
                    <mxGeometry width="2600" height="4330" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;算法二  ·  SlackLandlord：Agent 续租与单块备份&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=40;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="30" width="2480" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-subtitle" value="&lt;div style=&quot;line-height:1.4&quot;&gt;新请求登记续租资格；一次只准入一个完整 chunk x；已有共享副本只更新引用。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="60" y="115" width="2480" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-symbols" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;container=1;pointerEvents=0;" parent="1" vertex="1">
                    <mxGeometry x="60" y="205" width="2480" height="485" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-symbols-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;符号说明&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" parent="sla-flow-symbols" vertex="1">
                    <mxGeometry x="20" y="12" width="2440" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-symbols-objects" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(x/y\)：候选块 / 可释放尾块；\(a,s_a\)：Agent 及其本轮 Slack&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-flow-symbols" vertex="1">
                    <mxGeometry x="25" y="90" width="1170" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-symbols-bytes" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(b_x,b_y\)：物理 bytes；\(f\)：可用 bytes；\(E\)：可释放尾块&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-flow-symbols" vertex="1">
                    <mxGeometry x="25" y="151" width="1170" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-symbols-gain" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(W_x=G_x\)：块的 WCT 收益；\(P_x=G_x/b_x\)：收益密度&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-flow-symbols" vertex="1">
                    <mxGeometry x="25" y="212" width="1170" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-symbols-shares" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(G_{a,x},c_{a,x}\)：Agent a 的授信额、剩余信用&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-flow-symbols" vertex="1">
                    <mxGeometry x="25" y="273" width="1170" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-symbols-credit" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(\mathrm{Credit}_x\)：块的总剩余信用；\(L,H_x\)：累计租金、租值键&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-flow-symbols" vertex="1">
                    <mxGeometry x="25" y="334" width="1170" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-symbols-loss" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(\delta\)：本次单位字节租金；\(Y,D_Y\)：试删块及累计 WCT 损失&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-flow-symbols" vertex="1">
                    <mxGeometry x="25" y="395" width="1170" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-symbols-prefix" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(k,k_a,n_a\)：连续备份长度、Agent 前缀长度、已生成块数&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-flow-symbols" vertex="1">
                    <mxGeometry x="1275" y="90" width="1170" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-symbols-costs" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(t_a^{\rm load}(j),t_a^{\rm rec}(j,n_a)\)：加载前 j 块、重算其余块&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-flow-symbols" vertex="1">
                    <mxGeometry x="1275" y="151" width="1170" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-symbols-time" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(T_a,\Delta T_{a,x},W_{a,x}\)：恢复时间、节省时间、单 Agent 收益&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-flow-symbols" vertex="1">
                    <mxGeometry x="1275" y="212" width="1170" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-symbols-dag" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(w,u\to v,d_v,t_v\)：工作流、前驱、节点正常耗时、完成时间&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-flow-symbols" vertex="1">
                    <mxGeometry x="1275" y="273" width="1170" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-symbols-vector" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(T_v,\mathbf T,\mathbf T^x\)：节点恢复耗时、耗时向量、使用 x 的向量&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-flow-symbols" vertex="1">
                    <mxGeometry x="1275" y="334" width="1170" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-symbols-order" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(a_i,\mathbf T^{(i)}\)：第 i 个引用 Agent、前 i 个 Agent 使用 x 的向量&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-flow-symbols" vertex="1">
                    <mxGeometry x="1275" y="395" width="1170" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-candidate" value="&lt;div style=&quot;line-height:1.4&quot;&gt;① 取首个尚未备份的完整 KV chunk x&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
                    <mxGeometry x="610" y="770" width="1040" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-prefix" value="&lt;div style=&quot;line-height:1.4&quot;&gt;x 的连续前缀&lt;br&gt;已提交？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rhombus;" parent="1" vertex="1">
                    <mxGeometry x="795" y="940" width="670" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-wait-prefix" value="&lt;div style=&quot;line-height:1.4&quot;&gt;前缀未备份，后续也不再备份&lt;br&gt;（遵循 Prefix Cache）&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
                    <mxGeometry x="80" y="950" width="430" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-references" value="&lt;div style=&quot;line-height:1.4&quot;&gt;读取 Agent 引用、当前轮号、Slack 与恢复代价&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
                    <mxGeometry x="610" y="1160" width="1040" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-gain" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Agent 在备份 k 个 KV chunk 时的恢复时间&lt;br&gt;\(T_a(k)=\min_{0\le j\le k}\{t_a^{\rm reuse}(j)+t_a^{\rm recompute}(j,n_a)\}\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
                    <mxGeometry x="610" y="1320" width="1040" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-gain-single" value="&lt;div style=&quot;line-height:1.4&quot;&gt;备份第 k+1 个 KV chunk 对 WCT 带来的收益&lt;br&gt;\(\Delta T_{a,x}=T_a(k)-T_a(k+1)\)&lt;br&gt;\(W_{a,x}=\min\{\Delta T_{a,x},\max(T_a(k)-s_a,0)\}\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
                    <mxGeometry x="610" y="1530" width="1040" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-gain-density" value="&lt;div style=&quot;line-height:1.4&quot;&gt;计算候选块x的恢复收益与密度&lt;br&gt;\(G_x=W_x,\qquad P_x=G_x/b_x\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
                    <mxGeometry x="610" y="1777" width="1040" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-init" value="&lt;div style=&quot;line-height:1.4&quot;&gt;④ 试算备份 x，保护必要前缀（尚未分配）&lt;br&gt;\(Y\leftarrow\varnothing,\quad D_Y\leftarrow0,\quad f\leftarrow\text{Pool 可用字节}\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
                    <mxGeometry x="610" y="2130" width="1040" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-fits" value="&lt;div style=&quot;line-height:1.4&quot;&gt;可用空间足够？&lt;br&gt;\(f\ge b_x\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rhombus;" parent="1" vertex="1">
                    <mxGeometry x="795" y="2360" width="670" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-accept" value="&lt;div style=&quot;line-height:1.4&quot;&gt;⑤ 当前净收益为正？&lt;br&gt;\(G_x&amp;gt;D_Y\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rhombus;" parent="1" vertex="1">
                    <mxGeometry x="795" y="2660" width="670" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-validate" value="&lt;div style=&quot;line-height:1.4&quot;&gt;⑥ 重验输入版本、容量、固定读取与分配代次&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
                    <mxGeometry x="610" y="2920" width="1040" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-release" value="&lt;div style=&quot;line-height:1.4&quot;&gt;⑦ 确认回收计划与扣租；释放 Y&lt;br&gt;等待对应的物理释放 ACK&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
                    <mxGeometry x="610" y="3100" width="1040" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-copy" value="&lt;div style=&quot;line-height:1.4&quot;&gt;⑧ 为 x 分配空间并复制&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
                    <mxGeometry x="610" y="3300" width="1040" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-ack" value="&lt;div style=&quot;line-height:1.4&quot;&gt;全部分片&lt;br&gt;确认成功？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rhombus;" parent="1" vertex="1">
                    <mxGeometry x="810" y="3490" width="640" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-copy-failure" value="&lt;div style=&quot;line-height:1.4&quot;&gt;失败：清理本次分配并重规划&lt;br&gt;未齐：等待其余分片&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
                    <mxGeometry x="1830" y="4070" width="710" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-commit" value="&lt;div style=&quot;line-height:1.4&quot;&gt;⑨ 发布 COMMITTED，按当前前缀授信&lt;br&gt;\(c_{a,x}\leftarrow G_{a,x},\qquad\mathrm{Credit}_x=\sum_a c_{a,x}\)&lt;br&gt;记录各 Agent 的已兑现轮号&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
                    <mxGeometry x="610" y="3770" width="1040" height="165" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-eligible-note" value="&lt;div style=&quot;line-height:1.4&quot;&gt;E：无后继、未固定的可释放尾块&lt;br&gt;内部前缀保存余额，不参加本轮收租&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="65" y="2230" width="465" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-has-tail" value="&lt;div style=&quot;line-height:1.4&quot;&gt;有可释放尾块？&lt;br&gt;\(E\ne\varnothing\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rhombus;" parent="1" vertex="1">
                    <mxGeometry x="100" y="2380" width="390" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-refresh-tail" value="&lt;div style=&quot;line-height:1.4&quot;&gt;检查 E 中每个块的版本&lt;br&gt;按右侧公式兑现续租 / 限额&lt;br&gt;\(H_y=L+\mathrm{Credit}_y/b_y\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
                    <mxGeometry x="65" y="2630" width="465" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-collect" value="&lt;div style=&quot;line-height:1.4&quot;&gt;推进累计租金&lt;br&gt;\(\delta=\min_{y\in E}(H_y-L)\)&lt;br&gt;\(L\leftarrow L+\delta\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
                    <mxGeometry x="65" y="2880" width="465" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-debit" value="&lt;div style=&quot;line-height:1.4&quot;&gt;对 E 中每块收一份物理租金&lt;br&gt;\(\mathrm{Credit}_y\leftarrow\mathrm{Credit}_y-b_y\delta\)&lt;br&gt;各 Agent 按右侧比例分摊&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
                    <mxGeometry x="65" y="3115" width="465" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-select-tail" value="&lt;div style=&quot;line-height:1.4&quot;&gt;选择一个信用归零的尾块 y&lt;br&gt;\(\mathrm{Credit}_y=0\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
