                <mxCell id="sla-flow-chunk-record" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;container=1;pointerEvents=0;" parent="1" vertex="1">
                    <mxGeometry x="1830" y="770" width="710" height="425" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-chunk-record-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;一个 chunk 的引用信息&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" parent="sla-flow-chunk-record" vertex="1">
                    <mxGeometry x="20" y="12" width="670" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-user-chunk-card" value="&lt;div style=&quot;line-height:1.4&quot;&gt;KV chunk P2  ·  候选 x&lt;br&gt;Agent1: Slack1 = 8 ms&lt;br&gt;Agent2: Slack2 = 3 ms&lt;br&gt;Size: 4096 tokens&lt;br&gt;HBM/DRAM: \(b_x\) bytes&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-chunk-record" vertex="1">
                    <mxGeometry x="50" y="90" width="610" height="245" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-references-note" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Slack 从 Agent 表读取；每个引用另存剩余信用。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-flow-chunk-record" vertex="1">
                    <mxGeometry x="20" y="350" width="670" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-pool" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;container=1;pointerEvents=0;" parent="1" vertex="1">
                    <mxGeometry x="1830" y="1260" width="710" height="780" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-pool-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Peer HBM Pool · 共享存储与收租边界&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" parent="sla-flow-pool" vertex="1">
                    <mxGeometry x="20" y="12" width="670" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-pool-prefixes" value="&lt;div style=&quot;line-height:1.4&quot;&gt;连续前缀：P1 → P2(x)&lt;br&gt;另一条链：C1 → C2 → C3(y)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-flow-pool" vertex="1">
                    <mxGeometry x="25" y="80" width="660" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-pool-P1" value="&lt;div style=&quot;line-height:1.4&quot;&gt;P1&lt;br&gt;Agent1: 8 ms&lt;br&gt;Agent2: 3 ms&lt;br&gt;Size: 4096 tokens&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-pool" vertex="1">
                    <mxGeometry x="40" y="210" width="300" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-pool-C1" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C1&lt;br&gt;Agent3: 12 ms&lt;br&gt;内部块：暂停收租&lt;br&gt;Size: 4096 tokens&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-pool" vertex="1">
                    <mxGeometry x="370" y="210" width="300" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-pool-C2" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C2&lt;br&gt;Agent3: 12 ms&lt;br&gt;内部块：暂停收租&lt;br&gt;Size: 4096 tokens&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-pool" vertex="1">
                    <mxGeometry x="40" y="435" width="300" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-pool-C3" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C3&lt;br&gt;Agent3: 12 ms&lt;br&gt;尾块 y：参与收租&lt;br&gt;Size: 4096 tokens&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-pool" vertex="1">
                    <mxGeometry x="370" y="435" width="300" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-pool-note" value="&lt;div style=&quot;line-height:1.4&quot;&gt;P1 只占一槽；候选 x 的必要前缀不被试删。&lt;br&gt;C3 删除后，C2 带剩余信用进入下一轮竞争。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-flow-pool" vertex="1">
                    <mxGeometry x="20" y="640" width="670" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-pool-result" value="&lt;div style=&quot;line-height:1.4&quot;&gt;若接纳 x：P1 | C1 | C2 | x&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-flow-pool" vertex="1">
                    <mxGeometry x="20" y="720" width="670" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-ledger" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;container=1;pointerEvents=0;" parent="1" vertex="1">
                    <mxGeometry x="1830" y="2110" width="710" height="1010" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-ledger-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;子租约：谁续租，谁获得新信用&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" parent="sla-flow-ledger" vertex="1">
                    <mxGeometry x="20" y="12" width="670" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-credit-total" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(\mathrm{Credit}_x=\sum_a c_{a,x}\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-ledger" vertex="1">
                    <mxGeometry x="40" y="90" width="630" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-renew-agent" value="&lt;div style=&quot;line-height:1.4&quot;&gt;仅 Agent a 有未兑现的新请求&lt;br&gt;\(c_{a,x}\leftarrow G_{a,x}\)&lt;br&gt;兑现后记录该轮号&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-ledger" vertex="1">
                    <mxGeometry x="40" y="240" width="630" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-cap-others" value="&lt;div style=&quot;line-height:1.4&quot;&gt;其余 Agent / 普通刷新：只保留或减额&lt;br&gt;\(c_{b,x}\leftarrow\min(c_{b,x},G_{b,x})\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-ledger" vertex="1">
                    <mxGeometry x="40" y="450" width="630" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-lease-key" value="&lt;div style=&quot;line-height:1.4&quot;&gt;用剩余信用更新键&lt;br&gt;\(H_x=L+\mathrm{Credit}_x/b_x\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-ledger" vertex="1">
                    <mxGeometry x="40" y="625" width="630" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-rent-split" value="&lt;div style=&quot;line-height:1.4&quot;&gt;一份物理租金，按扣租前余额比例分摊&lt;br&gt;\(c_{a,y}\leftarrow c_{a,y}\left(1-\frac{b_y\delta}{\mathrm{Credit}_y}\right)\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-ledger" vertex="1">
                    <mxGeometry x="40" y="785" width="630" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-ledger-note" value="&lt;div style=&quot;line-height:1.4&quot;&gt;零信用不做除法；Agent 结束则撤销其份额。&lt;br&gt;新请求不能补回其他 Agent 已支付的租金。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-flow-ledger" vertex="1">
                    <mxGeometry x="20" y="925" width="670" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-edge-30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=0.5;exitY=1;entryX=0.5;entryY=0;jumpStyle=arc;jumpSize=9;" parent="1" source="sla-flow-credit-total" target="sla-flow-renew-agent" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-edge-31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=0.5;exitY=1;entryX=0.5;entryY=0;jumpStyle=arc;jumpSize=9;" parent="1" source="sla-flow-renew-agent" target="sla-flow-cap-others" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-edge-32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=0.5;exitY=1;entryX=0.5;entryY=0;jumpStyle=arc;jumpSize=9;" parent="1" source="sla-flow-cap-others" target="sla-flow-lease-key" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-lazy" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;container=1;pointerEvents=0;" parent="1" vertex="1">
                    <mxGeometry x="1830" y="3200" width="710" height="780" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-lazy-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Lazy Refresh：登记 → 按需兑现&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" parent="sla-flow-lazy" vertex="1">
                    <mxGeometry x="20" y="12" width="670" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-round-update" value="&lt;div style=&quot;line-height:1.4&quot;&gt;x 已备份，Agent1 发起下一轮请求&lt;br&gt;Slack: 8 → 4 ms；版本: 7 → 8&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-lazy" vertex="1">
                    <mxGeometry x="40" y="90" width="630" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-mark" value="&lt;div style=&quot;line-height:1.4&quot;&gt;只写 Agent1 表；Agent2 仍为 3 ms&lt;br&gt;x 的余额、H 与已兑现版本暂不改&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-lazy" vertex="1">
                    <mxGeometry x="40" y="245" width="630" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-lazy-when" value="&lt;div style=&quot;line-height:1.4&quot;&gt;x 成为可释放尾块，下一次收租前&lt;br&gt;已兑现版本 7 ≠ Agent1 当前版本 8&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-lazy" vertex="1">
                    <mxGeometry x="40" y="405" width="630" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-lazy-write" value="&lt;div style=&quot;line-height:1.4&quot;&gt;按当前恢复前缀重算 \(G_{1,x}\)&lt;br&gt;仅兑现 Agent1，记录版本 8；再更新 H&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-lazy" vertex="1">
                    <mxGeometry x="40" y="565" width="630" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-lazy-note" value="&lt;div style=&quot;line-height:1.4&quot;&gt;每次推进 L 前检查全部参与尾块，不能只看旧堆顶。&lt;br&gt;内部块暂停收租，兑现前不会漏付尾块租金。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-flow-lazy" vertex="1">
                    <mxGeometry x="20" y="690" width="670" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-edge-33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=0.5;exitY=1;entryX=0.5;entryY=0;jumpStyle=arc;jumpSize=9;" parent="1" source="sla-flow-round-update" target="sla-flow-mark" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-edge-34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=0.5;exitY=1;entryX=0.5;entryY=0;jumpStyle=arc;jumpSize=9;" parent="1" source="sla-flow-mark" target="sla-flow-lazy-when" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-edge-35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=0.5;exitY=1;entryX=0.5;entryY=0;jumpStyle=arc;jumpSize=9;" parent="1" source="sla-flow-lazy-when" target="sla-flow-lazy-write" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-quota" value="&lt;div style=&quot;line-height:1.4&quot;&gt;容量缩小：暂停准入，按尾块规则强制回收。&lt;br&gt;固定读取未解除时等待；复制/释放中分配仍计入容量。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
                    <mxGeometry x="610" y="4070" width="1040" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-footer" value="&lt;div style=&quot;line-height:1.4&quot;&gt;设计边界：只考虑恢复 WCT；时间单位 ms，容量用 bytes。固定顺序分账不保证对称公平；严格单块准入可能错过组合收益；未声称经典 Landlord 竞争比。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="60" y="4225" width="2480" height="80" as="geometry"/>
