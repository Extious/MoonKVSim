                <mxCell id="sla-flow-edge-25-label" value="&lt;div style=&quot;line-height:1.4&quot;&gt;失败 / 未齐&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fillColor=#FFFFFF;spacing=1;" parent="1" vertex="1">
                    <mxGeometry x="1525" y="3575" width="195" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-dag-formulas" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;container=1;pointerEvents=0;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1160" width="485" height="1030" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-dag-formulas-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;WCT 与共享分账公式&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" parent="sla-flow-dag-formulas" vertex="1">
                    <mxGeometry x="20" y="12" width="445" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-dag-recovery" value="&lt;div style=&quot;line-height:1.4&quot;&gt;受影响 Agent 节点&lt;br&gt;\(T_v=T_a(k_a)\)&lt;br&gt;其余节点 \(T_v=0\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-dag-formulas" vertex="1">
                    <mxGeometry x="20" y="85" width="445" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-dag-finish" value="&lt;div style=&quot;line-height:1.4&quot;&gt;按拓扑顺序计算&lt;br&gt;\(t_v=d_v+T_v+\max_{u\to v}t_u\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-dag-formulas" vertex="1">
                    <mxGeometry x="20" y="285" width="445" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-dag-wct" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(\mathrm{WCT}_w(\mathbf T)=\max_{v\in w}t_v\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-dag-formulas" vertex="1">
                    <mxGeometry x="20" y="460" width="445" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-dag-order" value="&lt;div style=&quot;line-height:1.4&quot;&gt;按固定 Agent ID 顺序分账&lt;br&gt;\(G_{a_i,x}=\sum_{w\gets x}\big[\)&lt;br&gt;\(\mathrm{WCT}_w(\mathbf T^{(i-1)})-\mathrm{WCT}_w(\mathbf T^{(i)})\big]\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-dag-formulas" vertex="1">
                    <mxGeometry x="20" y="610" width="445" height="185" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-dag-total" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(\sum_iG_{a_i,x}=G_x\)&lt;br&gt;\(w\gets x\)：工作流引用 x&lt;br&gt;无前驱时 \(\max\varnothing=0\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-dag-formulas" vertex="1">
                    <mxGeometry x="20" y="855" width="445" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-edge-26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=0.5;exitY=1;entryX=0.5;entryY=0;jumpStyle=arc;jumpSize=9;" parent="1" source="sla-flow-dag-recovery" target="sla-flow-dag-finish" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-edge-27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=0.5;exitY=1;entryX=0.5;entryY=0;jumpStyle=arc;jumpSize=9;" parent="1" source="sla-flow-dag-finish" target="sla-flow-dag-wct" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-edge-28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=0.5;exitY=1;entryX=0.5;entryY=0;jumpStyle=arc;jumpSize=9;" parent="1" source="sla-flow-dag-wct" target="sla-flow-dag-order" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-edge-29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=0.5;exitY=1;entryX=0.5;entryY=0;jumpStyle=arc;jumpSize=9;" parent="1" source="sla-flow-dag-order" target="sla-flow-dag-total" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
