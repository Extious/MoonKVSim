                <mxCell id="sla-flow-dag-formulas-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;WCT 的 DAG 计算公式&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" parent="sla-flow-dag-formulas" vertex="1">
                    <mxGeometry x="20" y="12" width="420" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-dag-recovery" value="&lt;div style=&quot;line-height:1.4&quot;&gt;受影响 Agent 节点&lt;br&gt;\(T_v=T_a(k_a)\)&lt;br&gt;其余节点 \(T_v=0\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-dag-formulas" vertex="1">
                    <mxGeometry x="20" y="90" width="420" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-dag-finish" value="&lt;div style=&quot;line-height:1.4&quot;&gt;按拓扑顺序计算&lt;br&gt;\(t_v=d_v+T_v+\max_{u\to v}t_u\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-dag-formulas" vertex="1">
                    <mxGeometry x="20" y="310" width="420" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-dag-wct" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(\mathrm{WCT}_w(\mathbf T)=\max_{v\in w}t_v\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-dag-formulas" vertex="1">
                    <mxGeometry x="20" y="500" width="420" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-dag-with-x" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(\mathbf T^x\)：引用 x 的受影响 Agent&lt;br&gt;\(T_v=T_a(k_a+1)\)&lt;br&gt;其余节点保持当前恢复耗时&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-dag-formulas" vertex="1">
                    <mxGeometry x="20" y="650" width="420" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-dag-note" value="&lt;div style=&quot;line-height:1.4&quot;&gt;分别代入两组恢复耗时；&lt;br&gt;每个工作流的完成时间只计一次。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-flow-dag-formulas" vertex="1">
                    <mxGeometry x="15" y="820" width="430" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-edge-24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=0.5;exitY=1;entryX=0.5;entryY=0;jumpStyle=arc;jumpSize=9;" parent="1" source="sla-flow-dag-recovery" target="sla-flow-dag-finish" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-edge-25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=0.5;exitY=1;entryX=0.5;entryY=0;jumpStyle=arc;jumpSize=9;" parent="1" source="sla-flow-dag-finish" target="sla-flow-dag-wct" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-edge-26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=0.5;exitY=1;entryX=0.5;entryY=0;jumpStyle=arc;jumpSize=9;" parent="1" source="sla-flow-dag-wct" target="sla-flow-dag-with-x" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-tail-formula-note" value="&lt;div style=&quot;line-height:1.4&quot;&gt;尾块 y：按试删 y 后的前缀，&lt;br&gt;用同一公式计算保留 y 的收益。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="75" y="2090" width="455" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-chunk-record" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;container=1;pointerEvents=0;" parent="1" vertex="1">
                    <mxGeometry x="1830" y="700" width="710" height="435" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-chunk-record-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;一个 chunk 的引用信息&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" parent="sla-flow-chunk-record" vertex="1">
                    <mxGeometry x="20" y="12" width="670" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-user-chunk-card" value="&lt;div style=&quot;line-height:1.4&quot;&gt;KV chunk P2  ·  候选 x&lt;br&gt;Agent1: Slack1 = 8 ms&lt;br&gt;Agent2: Slack2 = 3 ms&lt;br&gt;Size: 4096 tokens&lt;br&gt;HBM/DRAM: \(b_x\) bytes&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-chunk-record" vertex="1">
                    <mxGeometry x="50" y="95" width="610" height="245" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-references-note" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Slack 由 Agent 表读取；新请求不逐块改写。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-flow-chunk-record" vertex="1">
                    <mxGeometry x="20" y="360" width="670" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-pool" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;container=1;pointerEvents=0;" parent="1" vertex="1">
                    <mxGeometry x="1830" y="1200" width="710" height="830" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-pool-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Peer HBM Pool · 本次准入示例&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" parent="sla-flow-pool" vertex="1">
                    <mxGeometry x="20" y="12" width="670" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-pool-prefixes" value="&lt;div style=&quot;line-height:1.4&quot;&gt;连续前缀：P1 → P2(x)&lt;br&gt;另一条链：C1 → C2 → C3(y)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-flow-pool" vertex="1">
                    <mxGeometry x="25" y="80" width="660" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-pool-P1" value="&lt;div style=&quot;line-height:1.4&quot;&gt;P1&lt;br&gt;Agent1: 8 ms&lt;br&gt;Agent2: 3 ms&lt;br&gt;Size: 4096 tokens&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-pool" vertex="1">
                    <mxGeometry x="40" y="220" width="300" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-pool-C1" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C1&lt;br&gt;Agent3: 12 ms&lt;br&gt;Size: 4096 tokens&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-pool" vertex="1">
                    <mxGeometry x="370" y="220" width="300" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-pool-C2" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C2&lt;br&gt;Agent3: 12 ms&lt;br&gt;Size: 4096 tokens&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-pool" vertex="1">
                    <mxGeometry x="40" y="445" width="300" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-pool-C3" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C3&lt;br&gt;Agent3: 12 ms&lt;br&gt;可回收尾块 y&lt;br&gt;Size: 4096 tokens&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-pool" vertex="1">
                    <mxGeometry x="370" y="445" width="300" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-pool-note" value="&lt;div style=&quot;line-height:1.4&quot;&gt;P1 被两个 Agent 引用，只占一个物理槽。&lt;br&gt;内部块有后继时不可回收；固定读取块也不可选。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-flow-pool" vertex="1">
                    <mxGeometry x="20" y="655" width="670" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-pool-result" value="&lt;div style=&quot;line-height:1.4&quot;&gt;若接纳 x：P1 | C1 | C2 | x&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-flow-pool" vertex="1">
                    <mxGeometry x="20" y="755" width="670" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-lazy" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;container=1;pointerEvents=0;" parent="1" vertex="1">
                    <mxGeometry x="1830" y="2180" width="710" height="875" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-lazy-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Lazy Refresh：已备份块按需计算&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" parent="sla-flow-lazy" vertex="1">
                    <mxGeometry x="20" y="12" width="670" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-round-update" value="&lt;div style=&quot;line-height:1.4&quot;&gt;x 已备份，Agent1 发起下一轮请求&lt;br&gt;Slack: 8 → 4 ms；版本: 7 → 8&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-lazy" vertex="1">
                    <mxGeometry x="40" y="100" width="630" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-mark" value="&lt;div style=&quot;line-height:1.4&quot;&gt;只写 Agent1 表；Agent2 仍为 3 ms&lt;br&gt;已备份块的 W/G/P 和已算版本保持原值&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-lazy" vertex="1">
                    <mxGeometry x="40" y="270" width="630" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-lazy-when" value="&lt;div style=&quot;line-height:1.4&quot;&gt;x 成为可释放尾块并参与比较&lt;br&gt;已算版本 7 ≠ Agent1 当前版本 8&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-lazy" vertex="1">
                    <mxGeometry x="40" y="440" width="630" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-lazy-write" value="&lt;div style=&quot;line-height:1.4&quot;&gt;重算该块的 \(W_x\)&lt;br&gt;\(G_x\leftarrow W_x,\quad P_x\leftarrow G_x/b_x\)&lt;br&gt;写回已算版本 8&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-lazy" vertex="1">
                    <mxGeometry x="40" y="610" width="630" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-lazy-note" value="&lt;div style=&quot;line-height:1.4&quot;&gt;新块首次准入直接计算；已有块按需刷新。&lt;br&gt;恢复代价、试算前缀变化也会使缓存失效。&lt;br&gt;本版延迟计算 W/G/P；未引入历史租值键 H。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-flow-lazy" vertex="1">
                    <mxGeometry x="20" y="750" width="670" height="115" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-edge-27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=0.5;exitY=1;entryX=0.5;entryY=0;jumpStyle=arc;jumpSize=9;" parent="1" source="sla-flow-round-update" target="sla-flow-mark" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-edge-28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=0.5;exitY=1;entryX=0.5;entryY=0;jumpStyle=arc;jumpSize=9;" parent="1" source="sla-flow-mark" target="sla-flow-lazy-when" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-edge-29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=0.5;exitY=1;entryX=0.5;entryY=0;jumpStyle=arc;jumpSize=9;" parent="1" source="sla-flow-lazy-when" target="sla-flow-lazy-write" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-quota" value="&lt;div style=&quot;line-height:1.4&quot;&gt;容量缩小：暂停准入，先回收到新上限。&lt;br&gt;复制中、释放中的分配仍计入物理占用。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
                    <mxGeometry x="1830" y="3680" width="710" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-footer" value="&lt;div style=&quot;line-height:1.4&quot;&gt;恢复代价按加载后重算的串行模型计；每个已备份前缀均允许回退。Size 为 tokens，容量使用实际 HBM bytes。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="60" y="3800" width="2480" height="55" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>