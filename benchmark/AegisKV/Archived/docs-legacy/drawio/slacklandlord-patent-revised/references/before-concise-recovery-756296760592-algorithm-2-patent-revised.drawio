        <mxCell id="sla-agents-physical-C1" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C1&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-agents-physical" vertex="1">
          <mxGeometry x="35" y="230" width="250" height="85" as="geometry" />
        </mxCell>
        <mxCell id="sla-agents-physical-C2" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C2&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-agents-physical" vertex="1">
          <mxGeometry x="315" y="230" width="250" height="85" as="geometry" />
        </mxCell>
        <mxCell id="sla-agents-physical-C3" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C3&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-agents-physical" vertex="1">
          <mxGeometry x="595" y="230" width="250" height="85" as="geometry" />
        </mxCell>
        <mxCell id="sla-agents-physical-C4" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C4&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-agents-physical" vertex="1">
          <mxGeometry x="875" y="230" width="250" height="85" as="geometry" />
        </mxCell>
        <mxCell id="sla-agents-physical-A5" value="&lt;div style=&quot;line-height:1.4&quot;&gt;A5&lt;br&gt;COPYING&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;dashed=1;dashPattern=7 5;" parent="sla-agents-physical" vertex="1">
          <mxGeometry x="1155" y="230" width="250" height="85" as="geometry" />
        </mxCell>
        <mxCell id="sla-agents-physical-note" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Pool 包含 9 个已提交块；A5 另占 1 块空间。&lt;br&gt;恢复仅使用已提交的连续前缀；内部共享块有后继时不能单独删除。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-agents-physical" vertex="1">
          <mxGeometry x="25" y="340" width="1390" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sla-agents-state-panel" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;container=1;pointerEvents=0;" parent="1" vertex="1">
          <mxGeometry x="1560" y="1110" width="780" height="435" as="geometry" />
        </mxCell>
        <mxCell id="sla-agents-state-panel-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Pool 需要维护的状态&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" parent="sla-agents-state-panel" vertex="1">
          <mxGeometry x="20" y="12" width="740" height="65" as="geometry" />
        </mxCell>
        <mxCell id="sla-agents-state" value="&lt;div style=&quot;line-height:1.4&quot;&gt;容量与物理分配记录&lt;br&gt;COMMITTED / COPYING / RETIRING&lt;br&gt;固定读取引用与分配代次&lt;br&gt;Agent 子租约余额与已兑现轮号&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-agents-state-panel" vertex="1">
          <mxGeometry x="30" y="90" width="720" height="205" as="geometry" />
        </mxCell>
        <mxCell id="sla-agents-state-note" value="&lt;div style=&quot;line-height:1.4&quot;&gt;每个 Agent 单独续租；物理块只收一份租金。&lt;br&gt;只有释放 ACK 才减少实际占用。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-agents-state-panel" vertex="1">
          <mxGeometry x="30" y="315" width="720" height="95" as="geometry" />
        </mxCell>
        <mxCell id="sla-agents-round" value="&lt;div style=&quot;line-height:1.4&quot;&gt;新请求开始&lt;br&gt;替换本轮输入，登记一次续租资格&lt;br&gt;本轮生成过程中不调整 Slack&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
          <mxGeometry x="60" y="1630" width="690" height="150" as="geometry" />
        </mxCell>
        <mxCell id="sla-agents-produce" value="&lt;div style=&quot;line-height:1.4&quot;&gt;生成完整 chunk&lt;br&gt;发布可读源与前缀关系&lt;br&gt;进入第 2 页的容量决策&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
          <mxGeometry x="855" y="1630" width="690" height="150" as="geometry" />
        </mxCell>
        <mxCell id="sla-agents-edge-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jumpStyle=arc;jumpSize=9;" parent="1" source="sla-agents-round" target="sla-agents-produce" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sla-agents-ack" value="&lt;div style=&quot;line-height:1.4&quot;&gt;请求结束：保留 Agent 的租约&lt;br&gt;Agent 结束：撤销自己的份额&lt;br&gt;共享物理块按尾块规则回收&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
          <mxGeometry x="1650" y="1630" width="690" height="150" as="geometry" />
        </mxCell>
        <mxCell id="sla-agents-edge-13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jumpStyle=arc;jumpSize=9;" parent="1" source="sla-agents-produce" target="sla-agents-ack" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sla-agents-footer" value="&lt;div style=&quot;line-height:1.4&quot;&gt;第 2 页：逐块准入与收租。内部前缀 / 固定读取块保存剩余信用；成为可释放尾块后继续收租。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="60" y="1850" width="2280" height="55" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="flow" name="2 · 新 chunk：完整准入决策">
    <mxGraphModel math="1" grid="0" page="1" pageWidth="3820" pageHeight="7970" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="sla-flow-canvas" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;locked=1;connectable=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="0" y="0" width="3820" height="7970" />
        </mxCell>
        <mxCell id="sla-flow-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;SlackLandlord  ·  新 chunk：收益分账、准入与尾块收租&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=40;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="25" width="3700" height="80" />
        </mxCell>
        <mxCell id="sla-flow-subtitle" value="&lt;div style=&quot;line-height:1.4&quot;&gt;恢复收益只按 WCT 计价；黑色实线表示执行顺序，等待框由对应事件继续。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="115" width="3700" height="65" />
        </mxCell>
        <mxCell id="sla-flow-symbols-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;符号说明&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=31;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="210" width="3700" height="65" />
        </mxCell>
        <mxCell id="sla-flow-symbols-0" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(x\)：本次处理的物理块；\(y\)：待淘汰尾块；\(a\)：Agent；\(s_a\)：本轮 Slack；\(b_x,b_y\)：物理字节数&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="75" y="290" width="3670" height="62" />
        </mxCell>
        <mxCell id="sla-flow-symbols-1" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(k_a\)：待评估块之前的连续备份块数；\(t_a^{\rm reuse}(j)\)：加载前 j 块；\(t_a^{\rm recompute}(j)\)：在此前缀上重算已有其余 KV&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="75" y="355" width="3670" height="62" />
        </mxCell>
        <mxCell id="sla-flow-symbols-2" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(T_a(k_a),T_a(k_a+1)\)：不用 / 使用待评估块的恢复时间；\(W_{a,x}\)：Agent 的 WCT 收益份额；\(P_{a,x}=W_{a,x}/b_x\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="75" y="420" width="3670" height="62" />
        </mxCell>
        <mxCell id="sla-flow-symbols-3" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(c_{a,x}\)：Agent 剩余信用；\(\mathrm{Credit}_x=\sum_a c_{a,x}\)；\(H_x\)：尾块租值键；\(L\)：累计租金；\(\delta\)：本次收租增量&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="75" y="485" width="3670" height="62" />
        </mxCell>
        <mxCell id="sla-flow-symbols-4" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(Q\)：本次决策的可释放尾块优先队列；\(Y\)：计划淘汰的块；\(f\)：计划可用字节；\(G_x,D_Y\)：加入收益、累计回收损失&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="75" y="550" width="3670" height="62" />
        </mxCell>
        <mxCell id="sla-flow-symbols-5" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(w\)：工作流；\(v,u\)：DAG 节点；\(d_v,t_v\)：正常耗时、完成时间；\(\mathbf T\)：各节点恢复耗时；\(\max\varnothing=0\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="75" y="615" width="3670" height="62" />
        </mxCell>
        <mxCell id="sla-flow-candidate" value="&lt;div style=&quot;line-height:1.4&quot;&gt;① 新的完整 KV chunk x 到来&lt;br&gt;按前缀顺序逐块决策&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1450" y="780" width="1300" height="115" />
        </mxCell>
        <mxCell id="sla-flow-prefix" value="&lt;div style=&quot;line-height:1.4&quot;&gt;源完整可读，且必要前缀均已提交？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1640" y="1010" width="920" height="170" />
        </mxCell>
        <mxCell id="sla-flow-wait-prefix" value="&lt;div style=&quot;line-height:1.4&quot;&gt;BYPASS：本轮不备份 x&lt;br&gt;前缀未备份，后续也不再备份（Prefix Cache）&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="1030" width="1160" height="130" />
        </mxCell>
        <mxCell id="sla-flow-inputs" value="&lt;div style=&quot;line-height:1.4&quot;&gt;② 读取引用 Agent、本轮 Slack、轮号与恢复代价&lt;br&gt;新请求只更新 Agent 表；请求内 Slack 不变，不逐块重设 Credit&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1450" y="1270" width="1300" height="155" />
        </mxCell>
        <mxCell id="sla-flow-recovery" value="&lt;div style=&quot;line-height:1.4&quot;&gt;计算各引用 Agent 的恢复时间&lt;br&gt;\(T_a(k_a)=\min_{0\le j\le k_a}\{t_a^{\rm reuse}(j)+t_a^{\rm recompute}(j)\}\)&lt;br&gt;\(T_a(k_a+1)=\min\{T_a(k_a),t_a^{\rm reuse}(k_a+1)+t_a^{\rm recompute}(k_a+1)\}\)&lt;br&gt;刚生成 x：重算只到 x，此时 \(t_a^{\rm recompute}(k_a+1)=0\)&lt;br&gt;若是补备份已有块，其后已生成的 KV 仍计入重算&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1450" y="1510" width="1300" height="270" />
        </mxCell>
        <mxCell id="sla-flow-dag" value="&lt;div style=&quot;line-height:1.4&quot;&gt;对每组 \(\mathbf T^{(i)}\) 按拓扑顺序计算工作流完成时间&lt;br&gt;\(t_v=d_v+T_v+\max_{u\to v}t_u,\quad\mathrm{WCT}_w(\mathbf T)=\max_{v\in w}t_v\)&lt;br&gt;受故障影响的 Agent 节点取其恢复耗时；其余节点取 0&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1450" y="2155" width="1300" height="175" />
        </mxCell>
        <mxCell id="sla-flow-ordered" value="&lt;div style=&quot;line-height:1.4&quot;&gt;共享引用按固定 Agent ID 顺序排列：\(a_1,\ldots,a_m\)&lt;br&gt;\(\mathbf T^{(i)}\)：前 i 个引用 Agent 使用 x，其余引用 Agent 不用 x&lt;br&gt;使用时取 \(T_a(k_a+1)\)，不用时取 \(T_a(k_a)\)；其他节点保持当前恢复时间&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1450" y="1880" width="1300" height="160" />
        </mxCell>
        <mxCell id="sla-flow-shares" value="&lt;div style=&quot;line-height:1.4&quot;&gt;③ 计算不重复计价的 Agent 收益份额&lt;br&gt;\(W_{a_i,x}=\sum_{w\gets x}\left[\mathrm{WCT}_w(\mathbf T^{(i-1)})-\mathrm{WCT}_w(\mathbf T^{(i)})\right]\)&lt;br&gt;\(w\gets x\)：引用 x 的工作流；每个工作流按此顺序分账一次&lt;br&gt;仅单个 Agent 需要恢复时，上式等价于：&lt;br&gt;\(W_{a,x}=\min\{T_a(k_a)-T_a(k_a+1),\max(T_a(k_a)-s_a,0)\}\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1450" y="2415" width="1300" height="275" />
        </mxCell>
        <mxCell id="sla-flow-priority" value="&lt;div style=&quot;line-height:1.4&quot;&gt;④ 计算优先级与本块总收益&lt;br&gt;\(P_{a,x}=W_{a,x}/b_x,\qquad G_x=\sum_a W_{a,x}\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=30;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1450" y="2790" width="1300" height="145" />
        </mxCell>
        <mxCell id="sla-flow-init" value="&lt;div style=&quot;line-height:1.4&quot;&gt;⑤ 复制余额与轮号到临时账本，保护 x 的必要前缀&lt;br&gt;\(Y\leftarrow\varnothing,\quad D_Y\leftarrow0,\quad f\leftarrow\text{Pool 可用字节}\)&lt;br&gt;回收试算按 x 可恢复时的前缀计算；通过准入前不改真实账本&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1450" y="3050" width="1300" height="185" />
        </mxCell>
        <mxCell id="sla-flow-fits" value="&lt;div style=&quot;line-height:1.4&quot;&gt;可用空间足够？&lt;br&gt;\(f\ge b_x\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1675" y="3390" width="850" height="170" />
        </mxCell>
        <mxCell id="sla-flow-admission-rule" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(\boxed{\begin{cases}G_x\ge0,&amp;amp;Y=\varnothing\quad\text{无需淘汰已有块};\\[2mm]G_x&amp;gt;D_Y,&amp;amp;Y\ne\varnothing\quad\text{需要淘汰已有块}.\end{cases}}\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1450" y="3660" width="1300" height="200" />
        </mxCell>
        <mxCell id="sla-flow-accept" value="&lt;div style=&quot;line-height:1.4&quot;&gt;满足准入条件？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1675" y="3970" width="850" height="170" />
        </mxCell>
        <mxCell id="sla-flow-validate" value="&lt;div style=&quot;line-height:1.4&quot;&gt;⑥ 输入、容量、读取状态&lt;br&gt;及租金账本版本仍有效？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1640" y="4240" width="920" height="170" />
        </mxCell>
        <mxCell id="sla-flow-release" value="&lt;div style=&quot;line-height:1.4&quot;&gt;⑦ 提交回收计划与扣租记录&lt;br&gt;\(Y\ne\varnothing\)：释放 Y，等待对应物理释放 ACK&lt;br&gt;\(Y=\varnothing\)：跳过释放&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1450" y="4510" width="1300" height="155" />
        </mxCell>
        <mxCell id="sla-flow-copy" value="&lt;div style=&quot;line-height:1.4&quot;&gt;⑧ 为 x 分配空间并复制全部分片&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1450" y="4770" width="1300" height="115" />
        </mxCell>
        <mxCell id="sla-flow-ack" value="&lt;div style=&quot;line-height:1.4&quot;&gt;全部分片成功，且提交条件仍有效？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1640" y="5000" width="920" height="170" />
        </mxCell>
        <mxCell id="sla-flow-grant-value" value="&lt;div style=&quot;line-height:1.4&quot;&gt;⑨ 按实际前缀与当前已生成 KV 重算收益份额&lt;br&gt;恢复时间含已生成后缀：\(t_a^{\rm recompute}(k_a+1)\) 不强制为 0&lt;br&gt;\(W_{a_i,x}=\sum_{w\gets x}[\mathrm{WCT}_w(\mathbf T^{(i-1)})-\mathrm{WCT}_w(\mathbf T^{(i)})]\)&lt;br&gt;\(P_{a,x}=W_{a,x}/b_x\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1450" y="5250" width="1300" height="285" />
        </mxCell>
        <mxCell id="sla-flow-commit" value="&lt;div style=&quot;line-height:1.4&quot;&gt;⑩ 发布 COMMITTED，初始化各 Agent 的信用&lt;br&gt;\(c_{a,x}\leftarrow b_xP_{a,x}=W_{a,x},\quad\mathrm{Credit}_x=\sum_a c_{a,x}\)&lt;br&gt;发布前原子重验计算版本，并记录已兑现轮号；零收益时 Credit = 0&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1450" y="5620" width="1300" height="200" />
        </mxCell>
        <mxCell id="sla-flow-new-tail" value="&lt;div style=&quot;line-height:1.4&quot;&gt;x 当前是可释放尾块？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1675" y="5930" width="850" height="170" />
        </mxCell>
        <mxCell id="sla-flow-publish-key" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(H_x\leftarrow L+\mathrm{Credit}_x/b_x\)&lt;br&gt;将 x 加入 Q；若变成内部块，保留余额并退出尾块竞争&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1450" y="6210" width="1300" height="150" />
        </mxCell>
        <mxCell id="sla-flow-done" value="&lt;div style=&quot;line-height:1.4&quot;&gt;本次备份完成；处理下一个完整 chunk&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1450" y="6540" width="1300" height="100" />
        </mxCell>
        <mxCell id="sla-flow-build-q" value="&lt;div style=&quot;line-height:1.4&quot;&gt;更新 Q：已提交、无后继、可独立释放的尾块&lt;br&gt;排除 x、必要前缀与正在读取的块&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="3140" width="1160" height="150" />
        </mxCell>
        <mxCell id="sla-flow-has-tail" value="&lt;div style=&quot;line-height:1.4&quot;&gt;有可释放尾块？&lt;br&gt;\(Q\ne\varnothing\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="235" y="3390" width="850" height="170" />
        </mxCell>
        <mxCell id="sla-flow-refresh-inputs" value="&lt;div style=&quot;line-height:1.4&quot;&gt;逐个检查 Q 中的尾块 y&lt;br&gt;读取引用 Agent 的轮号、Slack 及相关工作流前缀 / 代价版本&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="3660" width="1160" height="140" />
        </mxCell>
        <mxCell id="sla-flow-tail-dirty" value="&lt;div style=&quot;line-height:1.4&quot;&gt;新暴露尾块，或输入版本已变化？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="235" y="3890" width="850" height="150" />
        </mxCell>
        <mxCell id="sla-flow-tail-time" value="&lt;div style=&quot;line-height:1.4&quot;&gt;评估已有尾块 y：恢复到当前已有 KV 的末尾&lt;br&gt;\(T_a(k_a)=\min_{0\le j\le k_a}\{t_a^{\rm reuse}(j)+t_a^{\rm recompute}(j)\}\)&lt;br&gt;\(T_a(k_a+1)=\min\{T_a(k_a),t_a^{\rm reuse}(k_a+1)+t_a^{\rm recompute}(k_a+1)\}\)&lt;br&gt;该块之后已生成的 KV 仍需重算；不计尚未生成的后续 KV&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="4130" width="1160" height="250" />
        </mxCell>
        <mxCell id="sla-flow-tail-share" value="&lt;div style=&quot;line-height:1.4&quot;&gt;为 y 按固定 Agent 顺序构造恢复时间，再联合分账&lt;br&gt;\(t_v=d_v+T_v+\max_{u\to v}t_u,\quad\mathrm{WCT}_w=\max_v t_v\)&lt;br&gt;\(W_{a_i,y}=\sum_{w\gets y}[\mathrm{WCT}_w(\mathbf T^{(i-1)})-\mathrm{WCT}_w(\mathbf T^{(i)})]\)&lt;br&gt;固定 Agent 顺序；使用 y 取 \(T_a(k_a+1)\)，不用时取 \(T_a(k_a)\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="4440" width="1160" height="240" />
        </mxCell>
        <mxCell id="sla-flow-refresh-credit" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Lazy Refresh：在临时账本中逐 Agent 更新信用&lt;br&gt;\(c_{a,y}\leftarrow\begin{cases}0,&amp;amp;\text{Agent 结束或引用解除};\\W_{a,y},&amp;amp;\text{首次引用或新轮尚未兑现};\\\min(c_{a,y},W_{a,y}),&amp;amp;\text{本轮已兑现}.\end{cases}\)&lt;br&gt;临时记录已兑现轮号；解除引用后也保留去重记录&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="4780" width="1160" height="285" />
        </mxCell>
        <mxCell id="sla-flow-tail-key" value="&lt;div style=&quot;line-height:1.4&quot;&gt;汇总余额，更新当前尾块租值键&lt;br&gt;\(\mathrm{Credit}_y=\sum_a c_{a,y},\quad H_y\leftarrow L+\mathrm{Credit}_y/b_y\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="5165" width="1160" height="145" />
        </mxCell>
        <mxCell id="sla-flow-more-tails" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Q 中还有未检查的尾块？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="235" y="5415" width="850" height="150" />
        </mxCell>
        <mxCell id="sla-flow-collect" value="&lt;div style=&quot;line-height:1.4&quot;&gt;计算本次租金增量&lt;br&gt;\(\delta=\min_{y\in Q}(H_y-L)\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=30;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="5675" width="1160" height="120" />
        </mxCell>
        <mxCell id="sla-flow-debit" value="&lt;div style=&quot;line-height:1.4&quot;&gt;每个物理块只收一份租金，按扣租前余额分摊&lt;br&gt;\(c_{a,y}\leftarrow c_{a,y}\left(1-\frac{b_y\delta}{\mathrm{Credit}_y}\right)\)&lt;br&gt;\(\mathrm{Credit}_y\leftarrow\sum_a c_{a,y}\)&lt;br&gt;全 Q 分摊完成后，仅推进一次：\(L\leftarrow L+\delta\)&lt;br&gt;Credit = 0 时跳过除法；内部块与固定读取块不在 Q 中&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="5895" width="1160" height="275" />
        </mxCell>
        <mxCell id="sla-flow-select-tail" value="&lt;div style=&quot;line-height:1.4&quot;&gt;选择一个 Credit = 0 的尾块 y&lt;br&gt;同值时按物理块 ID 决定&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="6255" width="1160" height="130" />
        </mxCell>
        <mxCell id="sla-flow-loss" value="&lt;div style=&quot;line-height:1.4&quot;&gt;计算删除 y 的当前条件恢复损失&lt;br&gt;\(G_y=\sum_{w\gets y}[\mathrm{WCT}_w(\mathbf T^{-y})-\mathrm{WCT}_w(\mathbf T)]\)&lt;br&gt;\(\mathbf T^{-y}\)：从当前临时前缀中删除 y 后的恢复耗时&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="6485" width="1160" height="200" />
        </mxCell>
        <mxCell id="sla-flow-trim" value="&lt;div style=&quot;line-height:1.4&quot;&gt;仅更新临时计划&lt;br&gt;\(Y\leftarrow Y\cup\{y\},\quad D_Y\leftarrow D_Y+G_y,\quad f\leftarrow f+b_y\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="6785" width="1160" height="150" />
        </mxCell>
        <mxCell id="sla-flow-expose" value="&lt;div style=&quot;line-height:1.4&quot;&gt;从 Q 移除 y，加入新暴露的可释放尾块&lt;br&gt;新尾块沿用剩余余额，进入下一轮版本检查&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="7035" width="1160" height="150" />
        </mxCell>
        <mxCell id="sla-flow-bypass" value="&lt;div style=&quot;line-height:1.4&quot;&gt;BYPASS：不备份 x&lt;br&gt;丢弃临时计划；已有备份、真实余额与 L 保持不变&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="7500" width="1160" height="140" />
        </mxCell>
        <mxCell id="sla-flow-layout-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;KV 布局示意&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=31;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2930" y="810" width="790" height="70" />
        </mxCell>
        <mxCell id="sla-flow-layout-card" value="&lt;div style=&quot;line-height:1.4&quot;&gt;共享块 P1&lt;br&gt;Agent 1 → 本轮 Slack&lt;br&gt;Agent 2 → 本轮 Slack&lt;br&gt;\(b_{P1}\)：实际 bytes；内容：4096 tokens&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2930" y="915" width="790" height="220" />
        </mxCell>
        <mxCell id="sla-flow-layout-agent-a" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Agent 1&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2930" y="1190" width="180" height="75" />
        </mxCell>
        <mxCell id="sla-flow-layout-agent-b" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Agent 2&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2930" y="1360" width="180" height="75" />
        </mxCell>
        <mxCell id="sla-flow-layout-a-0" value="&lt;div style=&quot;line-height:1.4&quot;&gt;P1&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="3135" y="1190" width="155" height="75" />
        </mxCell>
        <mxCell id="sla-flow-layout-a-1" value="&lt;div style=&quot;line-height:1.4&quot;&gt;A2&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="3320" y="1190" width="155" height="75" />
        </mxCell>
        <mxCell id="sla-flow-edge-0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="sla-flow-layout-a-0" target="sla-flow-layout-a-1" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="sla-flow-layout-a-2" value="&lt;div style=&quot;line-height:1.4&quot;&gt;x&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="3505" y="1190" width="155" height="75" />
        </mxCell>
        <mxCell id="sla-flow-edge-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="sla-flow-layout-a-1" target="sla-flow-layout-a-2" parent="1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="sla-flow-layout-b-0" value="&lt;div style=&quot;line-height:1.4&quot;&gt;P1&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="3135" y="1360" width="155" height="75" />
        </mxCell>
        <mxCell id="sla-flow-layout-b-1" value="&lt;div style=&quot;line-height:1.4&quot;&gt;B2&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="3320" y="1360" width="155" height="75" />
        </mxCell>
        <mxCell id="sla-flow-edge-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="sla-flow-layout-b-0" target="sla-flow-layout-b-1" parent="1">
