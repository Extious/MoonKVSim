        <mxCell id="sla-value-plan-3-time" value="&lt;div style=&quot;line-height:1.45&quot;&gt;恢复 T = 6 ms&lt;br&gt;损失 J = 2 ms&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2320" y="2055" width="380" height="85" />
