        <mxCell id="sla-value-plan-3-harm" value="&lt;div style=&quot;line-height:1.45&quot;&gt;2 ms&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#B76D69;fillColor=#F5DDDC;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1805" y="2175" width="110" height="60" />
