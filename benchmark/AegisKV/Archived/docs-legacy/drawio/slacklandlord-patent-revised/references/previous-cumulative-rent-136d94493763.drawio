        <mxCell id="sla-value-plan-3-meaning" value="&lt;div style=&quot;line-height:1.45&quot;&gt;6 − 4 = 2&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#566474;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2320" y="2175" width="380" height="60" />
        </mxCell>
        <mxCell id="sla-value-gains-panel" value="&lt;div style=&quot;line-height:1.45&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#718096;fillColor=#FFFFFF;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1530" y="2470" width="1210" height="490" />
        </mxCell>
        <mxCell id="sla-value-gains-title" value="&lt;div style=&quot;line-height:1.45&quot;&gt;⑤ 新增收益与累计收益&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#19334A;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1560" y="2485" width="1150" height="65" />
        </mxCell>
        <mxCell id="sla-value-new-gain" value="&lt;div style=&quot;line-height:1.45&quot;&gt;新增：只比较加入 x3 前后&lt;br&gt;\(W_3=J_2-J_3=5-2=3\ \mathrm{ms}\)&lt;br&gt;对应上面 k = 2 与 k = 3 两行&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#151515;fillColor=#FFF5DD;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1570" y="2580" width="550" height="145" />
        </mxCell>
        <mxCell id="sla-value-total-gain" value="&lt;div style=&quot;line-height:1.45&quot;&gt;累计：对比无备份基准&lt;br&gt;\(G_3=J_0-J_3=8-2=6\ \mathrm{ms}\)&lt;br&gt;对应上面 k = 0 与 k = 3 两行&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#151515;fillColor=#EAF1FA;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2160" y="2580" width="540" height="145" />
        </mxCell>
        <mxCell id="sla-value-gain-bar-title" value="&lt;div style=&quot;line-height:1.45&quot;&gt;累计 6 ms = 已有前缀贡献 3 ms + x3 新增贡献 3 ms&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1570" y="2750" width="1125" height="50" />
        </mxCell>
        <mxCell id="sla-value-g1" value="&lt;div style=&quot;line-height:1.45&quot;&gt;x1&lt;br&gt;1 ms&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#151515;fillColor=#EAF1FA;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1585" y="2820" width="170" height="85" />
        </mxCell>
        <mxCell id="sla-value-g2" value="&lt;div style=&quot;line-height:1.45&quot;&gt;x2 贡献 2 ms&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#151515;fillColor=#DCE8F8;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1755" y="2820" width="340" height="85" />
        </mxCell>
        <mxCell id="sla-value-g3" value="&lt;div style=&quot;line-height:1.45&quot;&gt;x3 贡献 3 ms&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#151515;fillColor=#FFF5DD;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2095" y="2820" width="510" height="85" />
        </mxCell>
        <mxCell id="sla-value-shared-panel" value="&lt;div style=&quot;line-height:1.45&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#718096;fillColor=#FFFFFF;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1530" y="3050" width="1210" height="360" />
        </mxCell>
        <mxCell id="sla-value-shared-title" value="&lt;div style=&quot;line-height:1.45&quot;&gt;⑥ 共享 x3：取两个 Agent 中较大的累计收益&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#19334A;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1560" y="3060" width="1150" height="65" />
        </mxCell>
        <mxCell id="sla-value-shared-a" value="&lt;div style=&quot;line-height:1.45&quot;&gt;Agent A&lt;br&gt;Slack 4 ms → 累计 6 ms&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#151515;fillColor=#FFFFFF;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1570" y="3150" width="460" height="105" />
        </mxCell>
        <mxCell id="sla-value-shared-b" value="&lt;div style=&quot;line-height:1.45&quot;&gt;Agent B（同一代价曲线）&lt;br&gt;Slack 8 ms → 累计 4 ms&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#151515;fillColor=#FFFFFF;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1570" y="3270" width="460" height="105" />
        </mxCell>
        <mxCell id="sla-value-shared-x3" value="&lt;div style=&quot;line-height:1.45&quot;&gt;x3  ·  一份 2 MiB 副本&lt;br&gt;\(G_3=\max(6,4)=6\ \mathrm{ms}\)&lt;br&gt;\(P_3=6/2=3\ \mathrm{ms/MiB}\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#151515;fillColor=#EAF1FA;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2150" y="3160" width="540" height="200" />
        </mxCell>
        <mxCell id="sla-value-edge-32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#566474;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;jettySize=20;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.25;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="sla-value-shared-a" target="sla-value-shared-x3">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="2100" y="3202.5" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="sla-value-edge-33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#566474;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;jettySize=20;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.75;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="sla-value-shared-b" target="sla-value-shared-x3">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="2100" y="3322.5" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="sla-value-rent-example" value="&lt;div style=&quot;line-height:1.45&quot;&gt;⑦ 新请求复用 x3 时续租&lt;br&gt;请求到来时 L = 1，P = 3，旧 H = 2 → 新 H = 4（均为 ms/MiB）&lt;br&gt;稍后检查时 L = 2：Credit = 2 MiB × (4 − 2) = 4 ms&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#151515;fillColor=#FFFFFF;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1530" y="3500" width="1210" height="195" />
        </mxCell>
        <mxCell id="sla-value-admission" value="&lt;div style=&quot;line-height:1.45&quot;&gt;新增收益是否大于淘汰损失？&lt;br&gt;\(\Delta G_B=\mathrm{WCT}(C)-\mathrm{WCT}(C\cup B)\)&lt;br&gt;\(D_Y=\mathrm{WCT}((C\cup B)\setminus Y)-\mathrm{WCT}(C\cup B)\)&lt;br&gt;本例：新增收益 3 ms，淘汰损失 4 ms → 拒绝备份&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#151515;fillColor=#FFFFFF;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1530" y="3770" width="1210" height="215" />
        </mxCell>
        <mxCell id="sla-value-symbols" value="&lt;div style=&quot;line-height:1.45&quot;&gt;符号：a 为引用 Agent，s 为固定 Slack，k 为前缀位置，T 为恢复时间，J 为超过 Slack 的损失，W / G 为新增 / 累计收益。&lt;br&gt;P 为每字节 Priority，b 为实际字节，L / H / Θ 为池租金 / 租值键 / 准入阈值；C 为本层现有保护集合，B 为候选连续段，Y 为拟淘汰集合。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#566474;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="4050" width="2680" height="100" />
        </mxCell>
        <mxCell id="sla-value-scope" value="&lt;div style=&quot;line-height:1.45&quot;&gt;数值为说明示例。J 按 Slack 估算；多个 Agent 的最终 WCT 变化按整个工作流计算。HBM / DRAM 分别评估。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=21;fontColor=#566474;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="4180" width="2680" height="50" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>