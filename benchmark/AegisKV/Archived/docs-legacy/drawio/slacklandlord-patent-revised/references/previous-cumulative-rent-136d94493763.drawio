        <mxCell id="sla-value-edge-31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#566474;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;jettySize=20;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sla-value-plan-3-x2" target="sla-value-plan-3-x3">
          <mxGeometry as="geometry" relative="1" />
