        </mxCell>
        <mxCell id="sla-agents-edge-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#151515;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;jettySize=20;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sla-agents-new-round" target="sla-agents-produce">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="sla-agents-admission" value="&lt;div style=&quot;line-height:1.45&quot;&gt;每个 Pool 独立决策&lt;br&gt;第 2 页：租金、准入、复制&lt;br&gt;第 3 页：收益与续租&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#151515;fillColor=#FFFFFF;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1090" y="1280" width="450" height="155" />
        </mxCell>
        <mxCell id="sla-agents-edge-13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#151515;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;jettySize=20;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sla-agents-produce" target="sla-agents-admission">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="sla-agents-publish" value="&lt;div style=&quot;line-height:1.45&quot;&gt;有效 ACK 后发布&lt;br&gt;推进 Agent 本层恢复前沿&lt;br&gt;共享数据不重复计容量&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#151515;fillColor=#FFFFFF;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1605" y="1280" width="450" height="155" />
        </mxCell>
        <mxCell id="sla-agents-edge-14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#151515;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;jettySize=20;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sla-agents-admission" target="sla-agents-publish">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="sla-agents-request-end" value="&lt;div style=&quot;line-height:1.45&quot;&gt;Request 完成&lt;br&gt;只结束本轮生产&lt;br&gt;保留 Agent 前缀及未完成复制&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#151515;fillColor=#FFFFFF;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1530" width="625" height="155" />
        </mxCell>
        <mxCell id="sla-agents-agent-end" value="&lt;div style=&quot;line-height:1.45&quot;&gt;Agent / 分支结束或换前缀&lt;br&gt;解除引用；共享对象保留其他引用&lt;br&gt;无引用且无占用的副本才回收&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#151515;fillColor=#FFFFFF;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="735" y="1530" width="625" height="155" />
        </mxCell>
        <mxCell id="sla-agents-failure" value="&lt;div style=&quot;line-height:1.45&quot;&gt;源故障 / 目标失效&lt;br&gt;隔离旧执行版本，再选择有效前沿&lt;br&gt;未提交部分确定性重算&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#151515;fillColor=#FFFFFF;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1410" y="1530" width="625" height="155" />
        </mxCell>
        <mxCell id="sla-agents-page-note" value="&lt;div style=&quot;line-height:1.45&quot;&gt;HBM 与 DRAM 分别维护上述状态。主 KV 不属于备份淘汰对象；额度与复制许可来自算法 3 / Worker。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#566474;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1740" width="1980" height="65" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="flow" name="2 · SlackLandlord 备份决策">
    <mxGraphModel math="1" grid="0" gridSize="10" page="1" pageWidth="2100" pageHeight="2910" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="sla-flow-canvas" value="&lt;div style=&quot;line-height:1.45&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=none;fillColor=#FFFFFF;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="0" y="0" width="2100" height="2910" />
        </mxCell>
        <mxCell id="sla-flow-title" value="&lt;div style=&quot;line-height:1.45&quot;&gt;算法二  ·  SlackLandlord&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=37;fontColor=#19334A;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="25" width="2000" height="70" />
        </mxCell>
        <mxCell id="sla-flow-subtitle" value="&lt;div style=&quot;line-height:1.45&quot;&gt;完整块到来或状态变化时执行；先规划，再校验与预留，最后异步提交。HBM / DRAM 各自执行。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#566474;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="105" width="2000" height="60" />
        </mxCell>
        <mxCell id="sla-flow-event" value="&lt;div style=&quot;line-height:1.45&quot;&gt;Agent 已绑定当前轮&lt;br&gt;新完整 chunk / 前缀变化 / 额度释放&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#151515;fillColor=#FFFFFF;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="650" y="200" width="800" height="110" />
        </mxCell>
        <mxCell id="sla-flow-candidate" value="&lt;div style=&quot;line-height:1.45&quot;&gt;① 从已提交前沿构造最短连续段 B（通常一块）&lt;br&gt;优先补缺口；仅纳入完整、源侧仍可读的块&lt;br&gt;限制段字节数和控制面工作量；收益见第 3 页&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#151515;fillColor=#FFFFFF;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="575" y="390" width="950" height="170" />
        </mxCell>
        <mxCell id="sla-flow-ready" value="&lt;div style=&quot;line-height:1.45&quot;&gt;存在有正新增收益的&lt;br&gt;完整候选段 B？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#151515;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="710" y="640" width="680" height="170" />
        </mxCell>
        <mxCell id="sla-flow-wait" value="&lt;div style=&quot;line-height:1.45&quot;&gt;暂缓该前缀&lt;br&gt;等待新块、续租或额度变化&lt;br&gt;不跳过缺口；推理继续&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#151515;fillColor=#FFFFFF;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1570" y="640" width="465" height="170" />
        </mxCell>
        <mxCell id="sla-flow-preview" value="&lt;div style=&quot;line-height:1.45&quot;&gt;② 建立临时规划视图&lt;br&gt;\(\Theta=L+P_B,\quad Y=\varnothing,\quad f=\text{可用字节}\)&lt;br&gt;Q 只含合法尾块；排除 B 的依赖与正在占用的块&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#151515;fillColor=#FFFFFF;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="575" y="885" width="950" height="160" />
        </mxCell>
        <mxCell id="sla-flow-space" value="&lt;div style=&quot;line-height:1.45&quot;&gt;\(f\ge b(B)\)？&lt;br&gt;空间足够&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#151515;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="780" y="1120" width="540" height="160" />
        </mxCell>
        <mxCell id="sla-flow-pop" value="&lt;div style=&quot;line-height:1.45&quot;&gt;③ 取 Q 的最小旧键 y，兑现未处理续租&lt;br&gt;\(H_y\leftarrow\max\{H_y,\ \text{该块待兑现的续租键}\}\)&lt;br&gt;旧键只会上升；历史租金不清零&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#151515;fillColor=#FFFFFF;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="130" y="1390" width="840" height="170" />
        </mxCell>
        <mxCell id="sla-flow-minimum" value="&lt;div style=&quot;line-height:1.45&quot;&gt;刷新后仍为最小？&lt;br&gt;\(H_y\le\min(\text{其余旧键})\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#151515;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="235" y="1640" width="630" height="160" />
        </mxCell>
        <mxCell id="sla-flow-threshold" value="&lt;div style=&quot;line-height:1.45&quot;&gt;\(H_y&amp;lt;\Theta\)？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=30;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#151515;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="280" y="1890" width="540" height="145" />
        </mxCell>
        <mxCell id="sla-flow-bypass" value="&lt;div style=&quot;line-height:1.45&quot;&gt;本轮 BYPASS&lt;br&gt;没有合适受害者&lt;br&gt;等待状态变化再评估&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#151515;fillColor=#FFFFFF;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="2170" width="335" height="165" />
        </mxCell>
        <mxCell id="sla-flow-victim" value="&lt;div style=&quot;line-height:1.45&quot;&gt;\(Y\leftarrow Y\cup\{y\},\quad f\leftarrow f+b_y\)&lt;br&gt;移除临时叶子，暴露新的合法尾块&lt;br&gt;共享物理块只计一次&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#151515;fillColor=#FFFFFF;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="475" y="2160" width="610" height="150" />
        </mxCell>
        <mxCell id="sla-flow-gain" value="&lt;div style=&quot;line-height:1.45&quot;&gt;④ 新增恢复收益大于&lt;br&gt;整个 Y 的联合损失？&lt;br&gt;\(\Delta G_B&amp;gt;D_Y\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#151515;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1220" y="1400" width="670" height="185" />
        </mxCell>
        <mxCell id="sla-flow-reserve" value="&lt;div style=&quot;line-height:1.45&quot;&gt;⑤ 短事务重验并锁定 B / Y&lt;br&gt;撤销 Y → 锁外确认物理释放 → 预留 B&lt;br&gt;\(L\leftarrow\max\{L,\max_{y\in Y}H_y\}\)&lt;br&gt;B 记 PENDING；Y 为空时 L 不变&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#151515;fillColor=#FFFFFF;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1190" y="1690" width="740" height="200" />
        </mxCell>
        <mxCell id="sla-flow-copy" value="&lt;div style=&quot;line-height:1.45&quot;&gt;⑥ 源 Worker 按许可异步复制&lt;br&gt;HBM：D2D / P2P；DRAM：直接 D2H&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#151515;fillColor=#FFFFFF;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1190" y="1980" width="740" height="120" />
        </mxCell>
        <mxCell id="sla-flow-ack" value="&lt;div style=&quot;line-height:1.45&quot;&gt;全部分片完成，&lt;br&gt;前缀与执行版本有效？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#151515;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1270" y="2190" width="580" height="160" />
        </mxCell>
        <mxCell id="sla-flow-commit" value="&lt;div style=&quot;line-height:1.45&quot;&gt;⑦ 整段发布 COMMITTED&lt;br&gt;\(H_x\leftarrow L+P_x\quad(x\in B)\)&lt;br&gt;合并期间续租；更新 Agent 前沿与 Q&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#151515;fillColor=#FFFFFF;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1190" y="2450" width="740" height="155" />
        </mxCell>
        <mxCell id="sla-flow-next" value="&lt;div style=&quot;line-height:1.45&quot;&gt;处理本层后续连续段&lt;br&gt;两层终态组合驻留结果&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#151515;fillColor=#FFFFFF;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1000" y="2665" width="555" height="100" />
        </mxCell>
        <mxCell id="sla-flow-stop" value="&lt;div style=&quot;line-height:1.45&quot;&gt;拒绝 / 校验冲突：暂缓&lt;br&gt;复制失败：ABORTED&lt;br&gt;释放 B 的预留与占用&lt;br&gt;已淘汰 Y 不自动回滚&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#151515;fillColor=#FFFFFF;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1640" y="2640" width="410" height="150" />
        </mxCell>
        <mxCell id="sla-flow-edge-0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#151515;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;jettySize=20;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sla-flow-event" target="sla-flow-candidate">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="sla-flow-edge-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#151515;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;jettySize=20;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sla-flow-candidate" target="sla-flow-ready">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="sla-flow-edge-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#151515;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;jettySize=20;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sla-flow-ready" target="sla-flow-wait">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="sla-flow-edge-2-label" value="&lt;div style=&quot;line-height:1.45&quot;&gt;否&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;text;strokeColor=none;fillColor=none;fillColor=#FFFFFF;spacing=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1440" y="660" width="75" height="45" />
        </mxCell>
        <mxCell id="sla-flow-edge-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#151515;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;jettySize=20;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sla-flow-ready" target="sla-flow-preview">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="sla-flow-edge-3-label" value="&lt;div style=&quot;line-height:1.45&quot;&gt;是&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;text;strokeColor=none;fillColor=none;fillColor=#FFFFFF;spacing=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1065" y="825" width="75" height="45" />
        </mxCell>
        <mxCell id="sla-flow-edge-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#151515;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;jettySize=20;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sla-flow-preview" target="sla-flow-space">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="sla-flow-edge-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#151515;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;jettySize=20;jumpStyle=arc;jumpSize=10;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="sla-flow-space" target="sla-flow-pop">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="550" y="1200" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="sla-flow-edge-5-label" value="&lt;div style=&quot;line-height:1.45&quot;&gt;否：腾空间&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;text;strokeColor=none;fillColor=none;fillColor=#FFFFFF;spacing=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="440" y="1290" width="240" height="45" />
        </mxCell>
        <mxCell id="sla-flow-edge-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#151515;strokeWidth=2.5;endArrow=block;endFill=1;endSize=10;jettySize=20;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="sla-flow-space" target="sla-flow-gain">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1555" y="1200" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="sla-flow-edge-6-label" value="&lt;div style=&quot;line-height:1.45&quot;&gt;是&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;text;strokeColor=none;fillColor=none;fillColor=#FFFFFF;spacing=2;" vertex="1" parent="1">
