        <mxCell id="sla-value-plan-3-slack" value="&lt;div style=&quot;line-height:1.45&quot;&gt;Slack 吸收 4 ms&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=21;fontColor=#151515;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=14;strokeWidth=2;strokeColor=#87909B;fillColor=#E8EBEF;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1585" y="2175" width="220" height="60" />
