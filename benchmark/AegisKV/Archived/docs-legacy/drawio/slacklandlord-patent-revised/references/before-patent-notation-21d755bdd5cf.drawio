        <mxCell id="sla-flow-before-A1" value="&lt;div style=&quot;line-height:1.4&quot;&gt;A1&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=30;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF4FD;strokeColor=#2E6FA8;rounded=1;arcSize=9;" vertex="1" parent="sla-flow-example">
          <mxGeometry as="geometry" x="30" y="320" width="170" height="85" />
        </mxCell>
        <mxCell id="sla-flow-before-A2" value="&lt;div style=&quot;line-height:1.4&quot;&gt;A2&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=30;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF4FD;strokeColor=#2E6FA8;rounded=1;arcSize=9;" vertex="1" parent="sla-flow-example">
          <mxGeometry as="geometry" x="230" y="320" width="170" height="85" />
        </mxCell>
        <mxCell id="sla-flow-before-A3" value="&lt;div style=&quot;line-height:1.4&quot;&gt;A3&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=30;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FCEEEB;strokeColor=#AE4B45;rounded=1;arcSize=9;" vertex="1" parent="sla-flow-example">
          <mxGeometry as="geometry" x="430" y="320" width="170" height="85" />
        </mxCell>
        <mxCell id="sla-flow-incoming" value="&lt;div style=&quot;line-height:1.4&quot;&gt;候选 B1 的新增收益 G = 4 ms&lt;br&gt;试删 A3 的恢复损失 K = 3 ms&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="sla-flow-example">
          <mxGeometry as="geometry" x="20" y="435" width="610" height="125" />
        </mxCell>
        <mxCell id="sla-flow-after-label" value="&lt;div style=&quot;line-height:1.4&quot;&gt;替换后：累计收益 7 ms&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="sla-flow-example">
          <mxGeometry as="geometry" x="20" y="570" width="610" height="60" />
        </mxCell>
        <mxCell id="sla-flow-after-A1" value="&lt;div style=&quot;line-height:1.4&quot;&gt;A1&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=30;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF4FD;strokeColor=#2E6FA8;rounded=1;arcSize=9;" vertex="1" parent="sla-flow-example">
          <mxGeometry as="geometry" x="30" y="655" width="170" height="85" />
        </mxCell>
        <mxCell id="sla-flow-after-A2" value="&lt;div style=&quot;line-height:1.4&quot;&gt;A2&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=30;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF4FD;strokeColor=#2E6FA8;rounded=1;arcSize=9;" vertex="1" parent="sla-flow-example">
          <mxGeometry as="geometry" x="230" y="655" width="170" height="85" />
        </mxCell>
        <mxCell id="sla-flow-after-B1" value="&lt;div style=&quot;line-height:1.4&quot;&gt;B1&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=30;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF8F4;strokeColor=#118575;rounded=1;arcSize=9;" vertex="1" parent="sla-flow-example">
          <mxGeometry as="geometry" x="430" y="655" width="170" height="85" />
        </mxCell>
        <mxCell id="sla-flow-example-result" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(\mathrm{Credit}=4-3=1\ \mathrm{ms}&amp;gt;0\)&lt;br&gt;只释放 A3；A1 / A2 继续保留&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#118575;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="sla-flow-example">
          <mxGeometry as="geometry" x="20" y="765" width="610" height="95" />
        </mxCell>
        <mxCell id="sla-flow-lazy" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#C1CEDB;rounded=1;arcSize=9;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1690" y="1420" width="650" height="455" />
        </mxCell>
        <mxCell id="sla-flow-lazy-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Lazy Refresh：需要时才计算&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#2E6FA8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="sla-flow-lazy">
          <mxGeometry as="geometry" x="20" y="12" width="610" height="65" />
        </mxCell>
        <mxCell id="sla-flow-mark" value="&lt;div style=&quot;line-height:1.4&quot;&gt;新请求到来&lt;br&gt;只标记相关工作流收益待刷新&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF4FD;strokeColor=#2E6FA8;rounded=1;arcSize=9;" vertex="1" parent="sla-flow-lazy">
          <mxGeometry as="geometry" x="30" y="105" width="590" height="110" />
        </mxCell>
        <mxCell id="sla-flow-refresh" value="&lt;div style=&quot;line-height:1.4&quot;&gt;比较 G 或 ρ 时再重算&lt;br&gt;输入与备份前缀都未变 → 复用缓存&lt;br&gt;同一工作流的多 Agent 联合计价&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#118575;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF8F4;strokeColor=#118575;rounded=1;arcSize=9;" vertex="1" parent="sla-flow-lazy">
          <mxGeometry as="geometry" x="30" y="280" width="590" height="145" />
        </mxCell>
        <mxCell id="sla-flow-edge-11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#2E6FA8;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=0.5;exitY=1;entryX=0.5;entryY=0;jumpStyle=arc;jumpSize=9;" edge="1" parent="1" source="sla-flow-mark" target="sla-flow-refresh">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="sla-flow-shrink" value="&lt;div style=&quot;line-height:1.4&quot;&gt;容量缩小：暂停新准入&lt;br&gt;按③逐块回收，直到占用不超过 C&lt;br&gt;固定读取阻碍回收 → 等待引用解除&lt;br&gt;复制、释放未完成的块仍占容量&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#B17A1D;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFF7E8;strokeColor=#B17A1D;rounded=1;arcSize=9;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1690" y="1980" width="650" height="290" />
        </mxCell>
        <mxCell id="sla-flow-footer" value="&lt;div style=&quot;line-height:1.4&quot;&gt;S：当前备份；X：候选缺少的连续块；V：备份草案；b：物理字节数；F：减少的总 WCT。&lt;br&gt;T(k)：保留前 k 块的恢复时间；s：本轮 Slack；[z]₊ = max(z, 0)；G / K：新增收益 / 回收损失。&lt;br&gt;按当前收益做局部替换；租金按实际回收损失结算，不使用全局最优求解或每块历史过期键。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#657B90;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="2310" width="2280" height="125" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>