        </mxCell>
        <mxCell id="sla-flow-example-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;只删一块，保留其余前缀&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#2E6FA8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="sla-flow-example">
          <mxGeometry as="geometry" x="20" y="12" width="610" height="65" />
        </mxCell>
        <mxCell id="sla-flow-example-input" value="&lt;div style=&quot;line-height:1.4&quot;&gt;A / B 属于不同工作流；每块等大&lt;br&gt;重算 3 / 4 / 5 ms；每块加载 2 ms&lt;br&gt;Slack = 4 ms；容量可容纳 3 块&lt;br&gt;\(U(0..3)=0,1,3,6\ \mathrm{ms}\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="sla-flow-example">
          <mxGeometry as="geometry" x="20" y="70" width="610" height="160" />
        </mxCell>
        <mxCell id="sla-flow-before-label" value="&lt;div style=&quot;line-height:1.4&quot;&gt;现有 A 前缀：累计收益 6 ms&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="sla-flow-example">
          <mxGeometry as="geometry" x="20" y="240" width="610" height="60" />
