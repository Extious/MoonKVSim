                <mxCell id="sla-agents-physical-C1" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C1&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-agents-physical" vertex="1">
                    <mxGeometry x="35" y="230" width="250" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-physical-C2" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C2&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-agents-physical" vertex="1">
                    <mxGeometry x="315" y="230" width="250" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-physical-C3" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C3&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-agents-physical" vertex="1">
                    <mxGeometry x="595" y="230" width="250" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-physical-C4" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C4&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-agents-physical" vertex="1">
                    <mxGeometry x="875" y="230" width="250" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-physical-A5" value="&lt;div style=&quot;line-height:1.4&quot;&gt;A5&lt;br&gt;COPYING&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;dashed=1;dashPattern=7 5;" parent="sla-agents-physical" vertex="1">
                    <mxGeometry x="1155" y="230" width="250" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-physical-note" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Pool 包含 9 个已提交块；A5 另占 1 块空间。&lt;br&gt;恢复仅使用已提交的连续前缀；内部共享块有后继时不能单独删除。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-agents-physical" vertex="1">
                    <mxGeometry x="25" y="340" width="1390" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-state-panel" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;container=1;pointerEvents=0;" parent="1" vertex="1">
                    <mxGeometry x="1560" y="1110" width="780" height="435" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-state-panel-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Pool 需要维护的状态&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" parent="sla-agents-state-panel" vertex="1">
                    <mxGeometry x="20" y="12" width="740" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-state" value="&lt;div style=&quot;line-height:1.4&quot;&gt;容量与物理分配记录&lt;br&gt;COMMITTED / COPYING / RETIRING&lt;br&gt;读取保护与分配代次&lt;br&gt;各 Agent 的剩余信用、最近续租请求号&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-agents-state-panel" vertex="1">
                    <mxGeometry x="30" y="90" width="720" height="205" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-state-note" value="&lt;div style=&quot;line-height:1.4&quot;&gt;每个 Agent 单独续租；物理块只收一份租金。&lt;br&gt;只有释放 ACK 才减少实际占用。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-agents-state-panel" vertex="1">
                    <mxGeometry x="30" y="315" width="720" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-round" value="&lt;div style=&quot;line-height:1.4&quot;&gt;新请求到来&lt;br&gt;记录本轮 Slack 与请求号&lt;br&gt;本轮生成过程中 Slack 不变&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1630" width="690" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-produce" value="&lt;div style=&quot;line-height:1.4&quot;&gt;复用已有 KV&lt;br&gt;按新 Slack 重算该块收益&lt;br&gt;刷新本 Agent 的 Credit&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
                    <mxGeometry x="855" y="1630" width="690" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-edge-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jumpStyle=arc;jumpSize=9;" parent="1" source="sla-agents-round" target="sla-agents-produce" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-ack" value="&lt;div style=&quot;line-height:1.4&quot;&gt;生成新的完整 KV chunk&lt;br&gt;按前缀顺序进行准入决策&lt;br&gt;容量不足时收租并淘汰尾块&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
                    <mxGeometry x="1650" y="1630" width="690" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-edge-13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jumpStyle=arc;jumpSize=9;" parent="1" source="sla-agents-produce" target="sla-agents-ack" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-footer" value="&lt;div style=&quot;line-height:1.4&quot;&gt;第 2 页：各 Agent 独立计算收益，共享块合并 Credit；新块与可释放尾块竞争信用，只淘汰可释放尾块。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1850" width="2280" height="55" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="flow" name="2 · 独立 Agent 收益与共享 Credit：统一租金流程">
        <mxGraphModel dx="1223" dy="818" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3760" pageHeight="3520" background="#FFFFFF" math="1" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="sla-flow-canvas" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;locked=1;connectable=0;" parent="1" vertex="1">
                    <mxGeometry width="3760" height="3520" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;SlackLandlord  ·  独立 Agent 收益，共享块合并 Credit&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=40;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="25" width="3640" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-subtitle" value="&lt;div style=&quot;line-height:1.4&quot;&gt;新请求实际复用时续租；空间不足时，新块与可释放尾块按信用竞争。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="60" y="115" width="3640" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-symbols-0" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(x\)：本次 KV 块；\(a\)：引用 Agent；\(s_a\)：该 Agent 最近请求的 Slack；\(b_x\)：物理字节数&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="70" y="225" width="3620" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-symbols-1" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(G_{a,x}\)：单独考虑 Agent a 时，备份 x 减少的 Slack 外恢复延迟；\(c_{a,x}\)：该 Agent 的剩余信用&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="70" y="283" width="3620" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-symbols-2" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(\mathrm{Credit}_x=\sum_a c_{a,x}\)；\(\delta\)：每字节收取的租金；共享块只占一份物理空间&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="70" y="341" width="3620" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-symbols-3" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(Q\)：可释放尾块；\(Y\)：计划淘汰的块；\(f\)：计划可用字节；\(y\)：参与收租的块&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="70" y="399" width="3620" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-symbols-4" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(T_a(k)\)：使用前 k 块备份恢复已生成 KV 的时间；\(k_a\)：x 之前的块数；不计未知未来 KV&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="70" y="457" width="3620" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-candidate" value="&lt;div style=&quot;line-height:1.4&quot;&gt;新请求复用 x，或生成完整 x&lt;br&gt;登记引用、请求号与 Slack；本轮 Slack 不变&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="1200" y="570" width="1300" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-resident" value="&lt;div style=&quot;line-height:1.4&quot;&gt;本 Pool 已有 x 的备份？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" parent="1" vertex="1">
                    <mxGeometry x="1430" y="790" width="840" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-prefix" value="&lt;div style=&quot;line-height:1.4&quot;&gt;必要前缀已提交，且源完整可读？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" parent="1" vertex="1">
                    <mxGeometry x="1430" y="1020" width="840" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-wait-prefix" value="&lt;div style=&quot;line-height:1.4&quot;&gt;从缺失前缀开始处理&lt;br&gt;前缀或源未就绪时，暂不备份后续块&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="53" y="1115" width="960" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-gain" value="&lt;div style=&quot;line-height:1.4&quot;&gt;逐个计算各引用 Agent 的恢复收益&lt;br&gt;\(G_{a,x}=\min\{T_a(k_a)-T_a(k_a+1),\max(T_a(k_a)-s_a,0)\}\)&lt;br&gt;使用全部可用前缀；其后已生成的 KV 重算&lt;br&gt;内部块按“前缀到 x 之前 / 到 x”为止估值&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="1200" y="1270" width="1300" height="235" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-initial" value="&lt;div style=&quot;line-height:1.4&quot;&gt;为新块建立临时信用&lt;br&gt;\(c_{a,x}\leftarrow G_{a,x},\qquad \mathrm{Credit}_x\leftarrow\sum_a c_{a,x}\)&lt;br&gt;每个 Agent 单独授信；此时尚未分配备份&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="1200" y="1620" width="1300" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-plan" value="&lt;div style=&quot;line-height:1.4&quot;&gt;建立回收计划，保护 x 的必要前缀&lt;br&gt;\(Y\leftarrow\varnothing,\qquad f\leftarrow\text{Pool 空闲字节}\)&lt;br&gt;以下收租与试删只修改临时记录&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="1200" y="1880" width="1300" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-fits" value="&lt;div style=&quot;line-height:1.4&quot;&gt;空间足够？\(f\ge b_x\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" parent="1" vertex="1">
                    <mxGeometry x="1430" y="2170" width="840" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-copy" value="&lt;div style=&quot;line-height:1.4&quot;&gt;核验代次与余额版本，提交收租和回收计划&lt;br&gt;释放 Y 后分配并复制 x；冲突则重新决策&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="1200" y="2480" width="1300" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-done" value="&lt;div style=&quot;line-height:1.4&quot;&gt;复制成功后发布 x，保留竞争后的信用余额&lt;br&gt;记录各 Agent 本请求已授信；更新 Q&lt;br&gt;不重新授信，不补回已支付的租金&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="1200" y="2800" width="1300" height="145" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-queue" value="&lt;div style=&quot;line-height:1.4&quot;&gt;更新 Q：无备份后继、未被读取的已提交块&lt;br&gt;排除 x、必要前缀及释放中的块&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="70" y="1830" width="960" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-has-tail" value="&lt;div style=&quot;line-height:1.4&quot;&gt;还有尾块且 x 尚有信用？&lt;br&gt;\(Q\ne\varnothing\ \land\ \mathrm{Credit}_x&amp;gt;0\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" parent="1" vertex="1">
                    <mxGeometry x="145" y="2090" width="810" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-rent" value="&lt;div style=&quot;line-height:1.4&quot;&gt;x 与 Q 中各块一起收租&lt;br&gt;\(\delta=\min\{\mathrm{Credit}_x/b_x,\min_{y\in Q}\mathrm{Credit}_y/b_y\}\)&lt;br&gt;\(c_{a,y}\leftarrow c_{a,y}(1-b_y\delta/\mathrm{Credit}_y),\quad y\in Q\cup\{x\}\)&lt;br&gt;各块 Credit 取剩余份额之和；零余额跳过除法&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="70" y="2320" width="960" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-alive" value="&lt;div style=&quot;line-height:1.4&quot;&gt;收租后 x 仍有信用？&lt;br&gt;\(\mathrm{Credit}_x&amp;gt;0\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" parent="1" vertex="1">
                    <mxGeometry x="165" y="2700" width="770" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-remove" value="&lt;div style=&quot;line-height:1.4&quot;&gt;选一个 Credit = 0 的旧尾块 y，加入回收计划&lt;br&gt;\(Y\leftarrow Y\cup\{y\},\qquad f\leftarrow f+b_y\)&lt;br&gt;同值按块 ID 选择；前驱成为尾块后再参与收租&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="70" y="2960" width="960" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-no-space" value="&lt;div style=&quot;line-height:1.4&quot;&gt;不备份 x，丢弃本次临时记录&lt;br&gt;已有备份与余额不变；信用同时归零也拒绝 x&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="70" y="3230" width="960" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-renew" value="&lt;div style=&quot;line-height:1.4&quot;&gt;按左侧收益式，用 a 的新 Slack 重算 \(G_{a,x}\)&lt;br&gt;仅该 Agent 的新请求首次复用时续租&lt;br&gt;\(c_{a,x}\leftarrow G_{a,x},\quad \mathrm{Credit}_x\leftarrow\sum_a c_{a,x}\)&lt;br&gt;其他 Agent 余额不变；重复事件保留原余额&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="2790" y="1650" width="820" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-renew-done" value="&lt;div style=&quot;line-height:1.4&quot;&gt;立即保存余额与本请求已处理记录&lt;br&gt;内部块、读取中的块也可续租；更新 Q&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="2790" y="2090" width="820" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-copy-failed" value="&lt;div style=&quot;line-height:1.4&quot;&gt;复制未完成则等待；失败则清理本次分配&lt;br&gt;旧 ACK 不发布；已释放的备份不回滚&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="2790" y="2480" width="820" height="160" as="geometry"/>
                </mxCell>
