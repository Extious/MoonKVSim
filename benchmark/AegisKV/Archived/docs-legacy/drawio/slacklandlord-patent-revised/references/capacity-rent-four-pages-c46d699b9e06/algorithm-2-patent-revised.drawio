        <mxCell id="sla-agents-physical-B3" value="&lt;div style=&quot;line-height:1.4&quot;&gt;B3&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF8F4;strokeColor=#118575;rounded=1;arcSize=9;" vertex="1" parent="sla-agents-physical">
          <mxGeometry as="geometry" x="1155" y="110" width="250" height="85" />
        </mxCell>
        <mxCell id="sla-agents-physical-C1" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C1&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF8F4;strokeColor=#118575;rounded=1;arcSize=9;" vertex="1" parent="sla-agents-physical">
          <mxGeometry as="geometry" x="35" y="230" width="250" height="85" />
        </mxCell>
        <mxCell id="sla-agents-physical-C2" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C2&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF8F4;strokeColor=#118575;rounded=1;arcSize=9;" vertex="1" parent="sla-agents-physical">
          <mxGeometry as="geometry" x="315" y="230" width="250" height="85" />
        </mxCell>
        <mxCell id="sla-agents-physical-C3" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C3&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF8F4;strokeColor=#118575;rounded=1;arcSize=9;" vertex="1" parent="sla-agents-physical">
          <mxGeometry as="geometry" x="595" y="230" width="250" height="85" />
        </mxCell>
        <mxCell id="sla-agents-physical-C4" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C4&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF8F4;strokeColor=#118575;rounded=1;arcSize=9;" vertex="1" parent="sla-agents-physical">
          <mxGeometry as="geometry" x="875" y="230" width="250" height="85" />
        </mxCell>
        <mxCell id="sla-agents-physical-A5" value="&lt;div style=&quot;line-height:1.4&quot;&gt;A5&lt;br&gt;COPYING&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFF7E8;strokeColor=#B17A1D;rounded=1;arcSize=9;dashed=1;dashPattern=7 5;" vertex="1" parent="sla-agents-physical">
          <mxGeometry as="geometry" x="1155" y="230" width="250" height="85" />
        </mxCell>
        <mxCell id="sla-agents-physical-note" value="&lt;div style=&quot;line-height:1.4&quot;&gt;S 包含 9 个已提交块；A5 另占 1 块空间。&lt;br&gt;恢复仅使用 S 中的连续前缀；内部共享块有后继时不能单独删除。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#657B90;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="sla-agents-physical">
          <mxGeometry as="geometry" x="25" y="340" width="1390" height="80" />
        </mxCell>
        <mxCell id="sla-agents-state-panel" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#C1CEDB;rounded=1;arcSize=9;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1560" y="1110" width="780" height="435" />
        </mxCell>
        <mxCell id="sla-agents-state-panel-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Pool 需要维护的状态&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#2E6FA8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="sla-agents-state-panel">
          <mxGeometry as="geometry" x="20" y="12" width="740" height="65" />
        </mxCell>
        <mxCell id="sla-agents-state" value="&lt;div style=&quot;line-height:1.4&quot;&gt;容量与物理分配记录&lt;br&gt;COMMITTED / COPYING / RETIRING&lt;br&gt;固定读取引用与分配代次&lt;br&gt;Agent 前缀、工作流版本、收益缓存&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#F3F5F8;strokeColor=#A6B7C8;rounded=1;arcSize=9;" vertex="1" parent="sla-agents-state-panel">
          <mxGeometry as="geometry" x="30" y="90" width="720" height="205" />
        </mxCell>
        <mxCell id="sla-agents-state-note" value="&lt;div style=&quot;line-height:1.4&quot;&gt;不为每块保存一份固定收益信用。&lt;br&gt;只有对应的释放 ACK 才减少实际占用。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#657B90;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="sla-agents-state-panel">
          <mxGeometry as="geometry" x="30" y="315" width="720" height="95" />
        </mxCell>
        <mxCell id="sla-agents-round" value="&lt;div style=&quot;line-height:1.4&quot;&gt;新请求开始&lt;br&gt;替换该 Agent 的本轮输入&lt;br&gt;本轮生成过程中不调整 Slack&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF4FD;strokeColor=#2E6FA8;rounded=1;arcSize=9;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1630" width="690" height="150" />
        </mxCell>
        <mxCell id="sla-agents-produce" value="&lt;div style=&quot;line-height:1.4&quot;&gt;生成完整 chunk&lt;br&gt;发布可读源与前缀关系&lt;br&gt;进入第 2 页的容量决策&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF4FD;strokeColor=#2E6FA8;rounded=1;arcSize=9;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="855" y="1630" width="690" height="150" />
        </mxCell>
        <mxCell id="sla-agents-edge-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#2E6FA8;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jumpStyle=arc;jumpSize=9;" edge="1" parent="1" source="sla-agents-round" target="sla-agents-produce">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="sla-agents-ack" value="&lt;div style=&quot;line-height:1.4&quot;&gt;备份提交 / 读取结束&lt;br&gt;更新恢复前沿与固定引用&lt;br&gt;合并新事件，再次决策&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF4FD;strokeColor=#2E6FA8;rounded=1;arcSize=9;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1650" y="1630" width="690" height="150" />
        </mxCell>
        <mxCell id="sla-agents-edge-13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#2E6FA8;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jumpStyle=arc;jumpSize=9;" edge="1" parent="1" source="sla-agents-produce" target="sla-agents-ack">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="sla-agents-footer" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C：算法 3 发布的备份可用容量；S：已提交的物理备份集合。&lt;br&gt;第 2 页：准入与回收；第 3 页：WCT 收益；第 4 页：容量租金与 Lazy Refresh。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#657B90;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1810" width="2280" height="95" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="flow" name="2 · KV 备份准入与回收">
    <mxGraphModel math="1" grid="0" gridSize="10" page="1" pageWidth="2400" pageHeight="2940" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="sla-flow-canvas" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=none;rounded=1;arcSize=9;locked=1;connectable=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="0" y="0" width="2400" height="2940" />
        </mxCell>
        <mxCell id="sla-flow-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;算法 2  ·  KV 备份决策流程&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=40;fontColor=#23384B;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="30" width="2280" height="75" />
        </mxCell>
        <mxCell id="sla-flow-subtitle" value="&lt;div style=&quot;line-height:1.4&quot;&gt;主流程沿一列向下；比较合法前缀组合。Peer HBM 容量有限，备份复制的带宽干扰暂不计入目标。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#657B90;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="115" width="2280" height="70" />
        </mxCell>
        <mxCell id="sla-flow-event" value="&lt;div style=&quot;line-height:1.4&quot;&gt;新请求 / 新完整 chunk / 引用变化 / 容量变化&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF4FD;strokeColor=#2E6FA8;rounded=1;arcSize=9;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="425" y="215" width="1060" height="105" />
        </mxCell>
        <mxCell id="sla-flow-snapshot" value="&lt;div style=&quot;line-height:1.4&quot;&gt;① 更新 Agent、工作流与可读源&lt;br&gt;纯价值更新可合并；源、布局、固定引用或容量变化立即使旧事务失效&lt;br&gt;尚有复制或实际释放未完成时，暂缓新事务&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF4FD;strokeColor=#2E6FA8;rounded=1;arcSize=9;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="385" y="400" width="1140" height="180" />
        </mxCell>
        <mxCell id="sla-flow-feasible" value="&lt;div style=&quot;line-height:1.4&quot;&gt;② 固定读取引用、连续前缀与容量&lt;br&gt;能同时满足吗？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#B17A1D;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFF7E8;strokeColor=#B17A1D;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="560" y="665" width="790" height="180" />
        </mxCell>
        <mxCell id="sla-flow-infeasible" value="&lt;div style=&quot;line-height:1.4&quot;&gt;DEFER&lt;br&gt;停止新分配&lt;br&gt;等待引用解除&lt;br&gt;或实际回收&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#F3F5F8;strokeColor=#657B90;rounded=1;arcSize=9;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="675" width="270" height="165" />
        </mxCell>
        <mxCell id="sla-flow-solve" value="&lt;div style=&quot;line-height:1.4&quot;&gt;③ 选择合法备份组合 S′&lt;br&gt;复用未变组件；完整组件表 + 整数动态规划&lt;br&gt;计算超预算 → 第 4 页的有界搜索&lt;br&gt;\(\max F(S^\prime)\quad\mathrm{s.t.}\ b(S^\prime)\le C\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF4FD;strokeColor=#2E6FA8;rounded=1;arcSize=9;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="385" y="950" width="1140" height="210" />
        </mxCell>
        <mxCell id="sla-flow-accept" value="&lt;div style=&quot;line-height:1.4&quot;&gt;④ 满足本次执行条件？&lt;br&gt;正常：模式允许且 \(F(S^\prime)&amp;gt;F(S)\)&lt;br&gt;缩额：已找到合法回收方案&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#B17A1D;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFF7E8;strokeColor=#B17A1D;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="505" y="1270" width="900" height="225" />
        </mxCell>
        <mxCell id="sla-flow-keep" value="&lt;div style=&quot;line-height:1.4&quot;&gt;KEEP / DEFER&lt;br&gt;没有更好方案则保留&lt;br&gt;精确模式未证最优&lt;br&gt;则暂缓&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#F3F5F8;strokeColor=#657B90;rounded=1;arcSize=9;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1300" width="280" height="175" />
        </mxCell>
        <mxCell id="sla-flow-revoke" value="&lt;div style=&quot;line-height:1.4&quot;&gt;⑤ 重验版本并撤销拟淘汰后缀的恢复可见性&lt;br&gt;受害块进入 RETIRING，发起实际释放&lt;br&gt;仍计入物理占用；已删除的旧副本不会自动回滚&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF4FD;strokeColor=#2E6FA8;rounded=1;arcSize=9;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="385" y="1590" width="1140" height="180" />
        </mxCell>
        <mxCell id="sla-flow-freed" value="&lt;div style=&quot;line-height:1.4&quot;&gt;⑥ 所需空间已经&lt;br&gt;收到实际释放 ACK？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#B17A1D;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFF7E8;strokeColor=#B17A1D;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="580" y="1880" width="750" height="165" />
        </mxCell>
        <mxCell id="sla-flow-wait-free" value="&lt;div style=&quot;line-height:1.4&quot;&gt;等待释放 ACK&lt;br&gt;保留实际占用记录&lt;br&gt;ACK 后再检查⑥&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#F3F5F8;strokeColor=#657B90;rounded=1;arcSize=9;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1885" width="280" height="155" />
        </mxCell>
        <mxCell id="sla-flow-copy" value="&lt;div style=&quot;line-height:1.4&quot;&gt;⑦ 空间足够后才分配并复制新增块&lt;br&gt;COPYING 占用容量，尚不能用于恢复&lt;br&gt;纯回收没有新增复制，直接满足下一步完成条件&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF4FD;strokeColor=#2E6FA8;rounded=1;arcSize=9;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="385" y="2140" width="1140" height="165" />
        </mxCell>
        <mxCell id="sla-flow-ack" value="&lt;div style=&quot;line-height:1.4&quot;&gt;⑧ 全部分片成功，&lt;br&gt;且发布版本有效？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#B17A1D;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFF7E8;strokeColor=#B17A1D;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="580" y="2395" width="750" height="170" />
        </mxCell>
        <mxCell id="sla-flow-wait-copy" value="&lt;div style=&quot;line-height:1.4&quot;&gt;等待剩余分片&lt;br&gt;重复 ACK&lt;br&gt;不代替其他分片&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#F3F5F8;strokeColor=#657B90;rounded=1;arcSize=9;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="2400" width="280" height="155" />
        </mxCell>
        <mxCell id="sla-flow-abort" value="&lt;div style=&quot;line-height:1.4&quot;&gt;ABORTED&lt;br&gt;撤销新副本；等待对应分配代次的释放 ACK&lt;br&gt;迟到 copy ACK / 旧 free ACK 均不生效&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#AE4B45;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FCEEEB;strokeColor=#AE4B45;rounded=1;arcSize=9;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1625" y="2385" width="715" height="180" />
        </mxCell>
        <mxCell id="sla-flow-commit" value="&lt;div style=&quot;line-height:1.4&quot;&gt;⑨ 发布连续 COMMITTED 前缀&lt;br&gt;更新 Agent 恢复前沿；发布合并的价值更新，进入下一次决策&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#118575;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF8F4;strokeColor=#118575;rounded=1;arcSize=9;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="385" y="2670" width="1140" height="145" />
        </mxCell>
        <mxCell id="sla-flow-edge-0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#2E6FA8;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=0.5;exitY=1;entryX=0.5;entryY=0;jumpStyle=arc;jumpSize=9;" edge="1" parent="1" source="sla-flow-event" target="sla-flow-snapshot">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="sla-flow-edge-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#2E6FA8;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=0.5;exitY=1;entryX=0.5;entryY=0;jumpStyle=arc;jumpSize=9;" edge="1" parent="1" source="sla-flow-snapshot" target="sla-flow-feasible">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="sla-flow-edge-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#2E6FA8;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=0.5;exitY=1;entryX=0.5;entryY=0;jumpStyle=arc;jumpSize=9;" edge="1" parent="1" source="sla-flow-feasible" target="sla-flow-solve">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="sla-flow-edge-2-label" value="&lt;div style=&quot;line-height:1.4&quot;&gt;是&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#2E6FA8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fillColor=#FFFFFF;spacing=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="970" y="870" width="80" height="45" />
        </mxCell>
        <mxCell id="sla-flow-edge-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#2E6FA8;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=0.5;exitY=1;entryX=0.5;entryY=0;jumpStyle=arc;jumpSize=9;" edge="1" parent="1" source="sla-flow-solve" target="sla-flow-accept">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
