        <mxCell id="sla-value-k2-label" value="&lt;div style=&quot;line-height:1.4&quot;&gt;前缀 k = 2    累计收益 U = 3 ms&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#23384B;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="sla-value-plans">
