        <mxCell id="sla-flow-example-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;容量竞争：删尾后仍保留短前缀&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#2E6FA8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="sla-flow-example">
