        </mxCell>
        <mxCell id="sla-value-k3-label" value="&lt;div style=&quot;line-height:1.4&quot;&gt;前缀 k = 3    累计收益 U = 6 ms&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#23384B;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="sla-value-plans">
          <mxGeometry as="geometry" x="30" y="1105" width="925" height="50" />
        </mxCell>
        <mxCell id="sla-value-k3-x1" value="&lt;div style=&quot;line-height:1.4&quot;&gt;x1&lt;br&gt;加载 2 ms&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF4FD;strokeColor=#2E6FA8;rounded=1;arcSize=9;" vertex="1" parent="sla-value-plans">
