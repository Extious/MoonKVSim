        <mxCell id="sla-lazy-implementation" value="&lt;div style=&quot;line-height:1.4&quot;&gt;组件表完整且规模可控时，可直接做整数 DP。&lt;br&gt;组件表不完整时不能冒充精确结果；转入以上有界搜索。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#657B90;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="300" y="2610" width="1040" height="135" />
        </mxCell>
        <mxCell id="sla-lazy-rent" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#C1CEDB;rounded=1;arcSize=9;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1490" y="235" width="850" height="850" />
        </mxCell>
        <mxCell id="sla-lazy-rent-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Priority 与 Credit 属于合法操作&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#2E6FA8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="sla-lazy-rent">
          <mxGeometry as="geometry" x="20" y="12" width="810" height="65" />
        </mxCell>
        <mxCell id="sla-lazy-delta" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(\Delta F=F(S^\prime)-F(S)\)&lt;br&gt;\(\Delta b=b(S^\prime)-b(S)\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=31;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF4FD;strokeColor=#2E6FA8;rounded=1;arcSize=9;" vertex="1" parent="sla-lazy-rent">
          <mxGeometry as="geometry" x="30" y="105" width="790" height="130" />
        </mxCell>
        <mxCell id="sla-lazy-credit" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(\mathrm{Credit}(S\to S^\prime;\lambda)=\Delta F-\lambda\Delta b\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#118575;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF8F4;strokeColor=#118575;rounded=1;arcSize=9;" vertex="1" parent="sla-lazy-rent">
          <mxGeometry as="geometry" x="30" y="275" width="790" height="115" />
        </mxCell>
        <mxCell id="sla-lazy-credit-meaning" value="&lt;div style=&quot;line-height:1.4&quot;&gt;λ：单位容量的竞争价格，单位 ms/byte。&lt;br&gt;Credit：当前操作的净值，单位 ms，可正可负。&lt;br&gt;新增操作可报告 ΔF / Δb，不能仅按密度贪心。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#657B90;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="sla-lazy-rent">
          <mxGeometry as="geometry" x="30" y="415" width="790" height="155" />
        </mxCell>
        <mxCell id="sla-lazy-credit-example" value="&lt;div style=&quot;line-height:1.4&quot;&gt;第 2 页的等容量替换&lt;br&gt;\(\Delta F=1\ \mathrm{ms},\quad \Delta b=0\)&lt;br&gt;\(\mathrm{Credit}=1\ \mathrm{ms}\)&lt;br&gt;先比较合法组合，不让尾部过期导致整个前缀过期。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF8F4;strokeColor=#118575;rounded=1;arcSize=9;" vertex="1" parent="sla-lazy-rent">
          <mxGeometry as="geometry" x="30" y="600" width="790" height="220" />
        </mxCell>
        <mxCell id="sla-lazy-upper" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#C1CEDB;rounded=1;arcSize=9;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1490" y="1160" width="850" height="530" />
        </mxCell>
        <mxCell id="sla-lazy-upper-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;u 仅作上界，真实收益仍由 DAG 计算&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#2E6FA8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="sla-lazy-upper">
          <mxGeometry as="geometry" x="20" y="12" width="810" height="65" />
        </mxCell>
        <mxCell id="sla-lazy-u-definition" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(u_x=\sum_f\omega_f\sum_{a:x=a_k}[T_a^f(k-1)-T_a^f(k)]\)&lt;br&gt;求和只包含该场景中受影响的引用 Agent。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="sla-lazy-upper">
          <mxGeometry as="geometry" x="25" y="80" width="800" height="130" />
        </mxCell>
        <mxCell id="sla-lazy-relaxation" value="&lt;div style=&quot;line-height:1.4&quot;&gt;允许分数选择并忽略前缀，仅用于计算上界。&lt;br&gt;第 2 页例：u = 1、2、3、4 ms；每块 2 MiB。&lt;br&gt;松弛可得 9 ms；合法整数最优解实际为 7 ms。&lt;br&gt;租金价格本身不能替代整数选择。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#B17A1D;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFF7E8;strokeColor=#B17A1D;rounded=1;arcSize=9;" vertex="1" parent="sla-lazy-upper">
          <mxGeometry as="geometry" x="30" y="250" width="790" height="225" />
        </mxCell>
        <mxCell id="sla-lazy-example" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#C1CEDB;rounded=1;arcSize=9;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1490" y="1770" width="850" height="395" />
        </mxCell>
        <mxCell id="sla-lazy-example-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Lazy 判断：用上界排除无须重算的方案&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#2E6FA8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="sla-lazy-example">
          <mxGeometry as="geometry" x="20" y="12" width="810" height="65" />
