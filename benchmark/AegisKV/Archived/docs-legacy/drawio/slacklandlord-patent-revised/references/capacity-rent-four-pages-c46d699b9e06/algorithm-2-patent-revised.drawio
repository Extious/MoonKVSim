        <mxCell id="sla-value-k3-loss" value="&lt;div style=&quot;line-height:1.4&quot;&gt;2 ms&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FCEEEB;strokeColor=#AE4B45;rounded=1;arcSize=9;" vertex="1" parent="sla-value-plans">
          <mxGeometry as="geometry" x="260" y="1285" width="110" height="60" />
        </mxCell>
        <mxCell id="sla-value-gain-callout" value="&lt;div style=&quot;line-height:1.4&quot;&gt;从前 2 块扩展到前 3 块：新增收益 6 − 3 = 3 ms&lt;br&gt;3 块累计收益为 6 ms，不能把每块都赋值为 6 ms。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#118575;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="sla-value-plans">
          <mxGeometry as="geometry" x="30" y="1360" width="925" height="90" />
        </mxCell>
        <mxCell id="sla-value-parallel" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#C1CEDB;rounded=1;arcSize=9;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1360" y="1780" width="980" height="850" />
        </mxCell>
        <mxCell id="sla-value-parallel-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;同一工作流的并行 Agent：必须经过汇合点&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#2E6FA8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="sla-value-parallel">
          <mxGeometry as="geometry" x="20" y="12" width="940" height="65" />
        </mxCell>
        <mxCell id="sla-value-parallel-note" value="&lt;div style=&quot;line-height:1.4&quot;&gt;A / B 各有一块独有 KV；同一次故障影响两者。&lt;br&gt;无备份恢复 12 ms，有备份恢复 8 ms。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#657B90;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="sla-value-parallel">
          <mxGeometry as="geometry" x="25" y="90" width="930" height="95" />
        </mxCell>
        <mxCell id="sla-value-branch-A" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Agent A&lt;br&gt;12 → 8 ms&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF4FD;strokeColor=#2E6FA8;rounded=1;arcSize=9;" vertex="1" parent="sla-value-parallel">
          <mxGeometry as="geometry" x="50" y="230" width="315" height="110" />
        </mxCell>
        <mxCell id="sla-value-branch-B" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Agent B&lt;br&gt;12 → 8 ms&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF4FD;strokeColor=#2E6FA8;rounded=1;arcSize=9;" vertex="1" parent="sla-value-parallel">
          <mxGeometry as="geometry" x="50" y="390" width="315" height="110" />
        </mxCell>
        <mxCell id="sla-value-join" value="&lt;div style=&quot;line-height:1.4&quot;&gt;汇合&lt;br&gt;max&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFF7E8;strokeColor=#B17A1D;rounded=1;arcSize=9;" vertex="1" parent="sla-value-parallel">
          <mxGeometry as="geometry" x="440" y="320" width="140" height="110" />
        </mxCell>
        <mxCell id="sla-value-dag-result" value="&lt;div style=&quot;line-height:1.4&quot;&gt;只备份 A：收益 0&lt;br&gt;只备份 B：收益 0&lt;br&gt;同时备份：收益 4&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF8F4;strokeColor=#118575;rounded=1;arcSize=9;" vertex="1" parent="sla-value-parallel">
          <mxGeometry as="geometry" x="650" y="285" width="300" height="180" />
        </mxCell>
        <mxCell id="sla-value-edge-15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#657B90;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=1;exitY=0.5;entryX=0;entryY=0.25;jumpStyle=arc;jumpSize=9;" edge="1" parent="1" source="sla-value-branch-A" target="sla-value-join">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1760" y="2065" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="sla-value-edge-16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#657B90;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=1;exitY=0.5;entryX=0;entryY=0.75;jumpStyle=arc;jumpSize=9;" edge="1" parent="1" source="sla-value-branch-B" target="sla-value-join">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1760" y="2225" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="sla-value-edge-17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#118575;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jumpStyle=arc;jumpSize=9;" edge="1" parent="1" source="sla-value-join" target="sla-value-dag-result">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="sla-value-parallel-explanation" value="&lt;div style=&quot;line-height:1.4&quot;&gt;两条分支一起变快，工作流才提前结束。&lt;br&gt;若属于两个独立工作流，总收益才可计为 4 + 4 = 8 ms。&lt;br&gt;若它们共享同一物理块，容量仍只计一份。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#657B90;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="sla-value-parallel">
          <mxGeometry as="geometry" x="30" y="570" width="920" height="185" />
        </mxCell>
        <mxCell id="sla-value-footer" value="&lt;div style=&quot;line-height:1.4&quot;&gt;T：恢复时间；s：本轮 Slack；J：超过 Slack 的损失；U：单 Agent 前缀收益；[z]₊ = max(z, 0)。&lt;br&gt;d：正常参考节点时间；D：工作流完成时间；w / f：工作流 / 故障场景；ω：明确给定的场景权重；F：总恢复收益。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#657B90;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="2685" width="2280" height="130" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="lazy" name="4 · 容量租金与 Lazy Refresh">
    <mxGraphModel math="1" grid="0" gridSize="10" page="1" pageWidth="2400" pageHeight="2940" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="sla-lazy-canvas" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=none;rounded=1;arcSize=9;locked=1;connectable=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="0" y="0" width="2400" height="2940" />
        </mxCell>
        <mxCell id="sla-lazy-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;SlackLandlord  ·  容量租金与 Lazy Refresh&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=40;fontColor=#23384B;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="30" width="2280" height="75" />
        </mxCell>
        <mxCell id="sla-lazy-subtitle" value="&lt;div style=&quot;line-height:1.4&quot;&gt;求解完成时与完整刷新一致；有限预算时返回可行方案和最优性差距。容量价格用于上界，不单独决定逐块淘汰。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#657B90;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="115" width="2280" height="70" />
        </mxCell>
        <mxCell id="sla-lazy-update" value="&lt;div style=&quot;line-height:1.4&quot;&gt;① 新请求或完整 chunk 改变相关输入&lt;br&gt;未变工作流复用缓存；结构变化建立新代次&lt;br&gt;同一请求中不因生成进度重新估计 Slack&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF4FD;strokeColor=#2E6FA8;rounded=1;arcSize=9;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="300" y="235" width="1040" height="165" />
        </mxCell>
        <mxCell id="sla-lazy-interval" value="&lt;div style=&quot;line-height:1.4&quot;&gt;② 对尚未重算的收益保留有效区间&lt;br&gt;\(E_w=\sum_{v\in w}(|\Delta d_v|+\max_{f,k}|\Delta T_v^f(k)|)\)&lt;br&gt;\(|F_w^{\rm new}-F_w^{\rm cached}|\le 2\sum E_w\)&lt;br&gt;\(\overline F=\min(\text{当前可证上界},F^{\rm cached}+2\sum E_w)\)&lt;br&gt;E 为单次扰动界；跨轮按未刷新轮次累加。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF4FD;strokeColor=#2E6FA8;rounded=1;arcSize=9;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="260" y="500" width="1120" height="270" />
        </mxCell>
        <mxCell id="sla-lazy-bound" value="&lt;div style=&quot;line-height:1.4&quot;&gt;③ 给待验证分支计算收益上界 UB&lt;br&gt;\(UB=\overline F(I)+\min_{\lambda\ge0}\{\lambda R+\sum_{x\in X}[u_x-\lambda b_x]_+\}\)&lt;br&gt;\(R=C-b(I)\)&lt;br&gt;按 u / b 解分数背包，得到该上界的租金 λ&lt;br&gt;以合法前缀初始化最好值；将起始分支入队&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF4FD;strokeColor=#2E6FA8;rounded=1;arcSize=9;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="260" y="850" width="1120" height="240" />
        </mxCell>
        <mxCell id="sla-lazy-pop" value="&lt;div style=&quot;line-height:1.4&quot;&gt;④ 取当前 UB 最高的待处理分支&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF4FD;strokeColor=#2E6FA8;rounded=1;arcSize=9;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="300" y="1170" width="1040" height="105" />
        </mxCell>
        <mxCell id="sla-lazy-possible" value="&lt;div style=&quot;line-height:1.4&quot;&gt;上界仍不低于&lt;br&gt;当前已验证的最好收益？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#B17A1D;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFF7E8;strokeColor=#B17A1D;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="430" y="1370" width="780" height="180" />
        </mxCell>
        <mxCell id="sla-lazy-prune" value="&lt;div style=&quot;line-height:1.4&quot;&gt;剪枝&lt;br&gt;这个分支&lt;br&gt;无需重算&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#F3F5F8;strokeColor=#657B90;rounded=1;arcSize=9;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="1390" width="220" height="150" />
        </mxCell>
        <mxCell id="sla-lazy-refresh" value="&lt;div style=&quot;line-height:1.4&quot;&gt;⑤ 精算当前配置，更新最好可行方案与缓存&lt;br&gt;重算上界；不可能改善则剪枝&lt;br&gt;否则按 chunk 保留 / 不保留分支，检查前缀与容量&lt;br&gt;给子分支设置上界并入队&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF4FD;strokeColor=#2E6FA8;rounded=1;arcSize=9;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="300" y="1660" width="1040" height="185" />
        </mxCell>
