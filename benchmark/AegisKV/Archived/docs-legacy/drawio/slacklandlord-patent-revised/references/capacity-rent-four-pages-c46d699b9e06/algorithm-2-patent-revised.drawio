        </mxCell>
        <mxCell id="sla-value-k2-x1" value="&lt;div style=&quot;line-height:1.4&quot;&gt;x1&lt;br&gt;加载 2 ms&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF4FD;strokeColor=#2E6FA8;rounded=1;arcSize=9;" vertex="1" parent="sla-value-plans">
