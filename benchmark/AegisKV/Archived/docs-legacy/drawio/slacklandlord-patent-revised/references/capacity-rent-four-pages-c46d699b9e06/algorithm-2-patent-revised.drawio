        <mxCell id="sla-value-k3-slack" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Slack 4 ms&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#E4EAF0;strokeColor=#A3B2C2;rounded=1;arcSize=9;" vertex="1" parent="sla-value-plans">
