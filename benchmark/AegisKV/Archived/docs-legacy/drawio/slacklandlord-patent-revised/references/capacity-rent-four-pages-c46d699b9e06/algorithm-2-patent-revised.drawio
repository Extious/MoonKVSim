        </mxCell>
        <mxCell id="sla-flow-after-label" value="&lt;div style=&quot;line-height:1.4&quot;&gt;候选 S′：收益 7 ms&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="sla-flow-example">
          <mxGeometry as="geometry" x="20" y="440" width="675" height="50" />
        </mxCell>
        <mxCell id="sla-flow-after-A1" value="&lt;div style=&quot;line-height:1.4&quot;&gt;A1&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF4FD;strokeColor=#2E6FA8;rounded=1;arcSize=9;" vertex="1" parent="sla-flow-example">
          <mxGeometry as="geometry" x="40" y="505" width="185" height="80" />
        </mxCell>
        <mxCell id="sla-flow-after-A2" value="&lt;div style=&quot;line-height:1.4&quot;&gt;A2&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF4FD;strokeColor=#2E6FA8;rounded=1;arcSize=9;" vertex="1" parent="sla-flow-example">
          <mxGeometry as="geometry" x="255" y="505" width="185" height="80" />
        </mxCell>
        <mxCell id="sla-flow-after-B1" value="&lt;div style=&quot;line-height:1.4&quot;&gt;B1&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF8F4;strokeColor=#118575;rounded=1;arcSize=9;" vertex="1" parent="sla-flow-example">
          <mxGeometry as="geometry" x="470" y="505" width="185" height="80" />
        </mxCell>
        <mxCell id="sla-flow-example-result" value="&lt;div style=&quot;line-height:1.4&quot;&gt;删 A3 损失 3 ms，新增 B1 收益 4 ms&lt;br&gt;\(\Delta F=7-6=1\ \mathrm{ms}\)&lt;br&gt;继续删除 A2 会再损失 2 ms，没有必要。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#118575;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="sla-flow-example">
          <mxGeometry as="geometry" x="20" y="615" width="675" height="130" />
        </mxCell>
        <mxCell id="sla-flow-modes" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#C1CEDB;rounded=1;arcSize=9;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1625" y="1060" width="715" height="560" />
        </mxCell>
        <mxCell id="sla-flow-modes-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;两种求解模式&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#2E6FA8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="sla-flow-modes">
          <mxGeometry as="geometry" x="20" y="12" width="675" height="65" />
        </mxCell>
        <mxCell id="sla-flow-mode-online" value="&lt;div style=&quot;line-height:1.4&quot;&gt;有限预算模式&lt;br&gt;只采用已经精算、容量合法的改善方案&lt;br&gt;同时报告尚未闭合的最优性差距&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#EDF4FD;strokeColor=#2E6FA8;rounded=1;arcSize=9;" vertex="1" parent="sla-flow-modes">
          <mxGeometry as="geometry" x="25" y="85" width="665" height="170" />
        </mxCell>
        <mxCell id="sla-flow-mode-exact" value="&lt;div style=&quot;line-height:1.4&quot;&gt;精确模式&lt;br&gt;未完成最优性及平局选择证明 → DEFER&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#F3F5F8;strokeColor=#657B90;rounded=1;arcSize=9;" vertex="1" parent="sla-flow-modes">
          <mxGeometry as="geometry" x="25" y="280" width="665" height="115" />
        </mxCell>
        <mxCell id="sla-flow-mode-shrink" value="&lt;div style=&quot;line-height:1.4&quot;&gt;容量下降：只从已有前缀选子集。&lt;br&gt;即使收益下降，也必须完成可行回收。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#B17A1D;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="sla-flow-modes">
          <mxGeometry as="geometry" x="25" y="415" width="665" height="115" />
        </mxCell>
        <mxCell id="sla-flow-memory" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#C1CEDB;rounded=1;arcSize=9;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1625" y="1700" width="715" height="535" />
        </mxCell>
        <mxCell id="sla-flow-memory-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;释放与复制期间的物理占用&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#2E6FA8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="sla-flow-memory">
          <mxGeometry as="geometry" x="20" y="12" width="675" height="65" />
        </mxCell>
        <mxCell id="sla-flow-physical-step-0" value="&lt;div style=&quot;line-height:1.4&quot;&gt;A3 已撤销，尚未释放：仍占 6 MiB&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FCEEEB;strokeColor=#AE4B45;rounded=1;arcSize=9;" vertex="1" parent="sla-flow-memory">
          <mxGeometry as="geometry" x="25" y="100" width="665" height="80" />
        </mxCell>
        <mxCell id="sla-flow-physical-step-1" value="&lt;div style=&quot;line-height:1.4&quot;&gt;收到 A3 的 free ACK：降至 4 MiB&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#F3F5F8;strokeColor=#657B90;rounded=1;arcSize=9;" vertex="1" parent="sla-flow-memory">
          <mxGeometry as="geometry" x="25" y="215" width="665" height="80" />
        </mxCell>
        <mxCell id="sla-flow-edge-14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#657B90;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=0.5;exitY=1;entryX=0.5;entryY=0;jumpStyle=arc;jumpSize=9;" edge="1" parent="1" source="sla-flow-physical-step-0" target="sla-flow-physical-step-1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="sla-flow-physical-step-2" value="&lt;div style=&quot;line-height:1.4&quot;&gt;开始复制 B1：占用回到 6 MiB&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFF7E8;strokeColor=#B17A1D;rounded=1;arcSize=9;" vertex="1" parent="sla-flow-memory">
          <mxGeometry as="geometry" x="25" y="330" width="665" height="80" />
        </mxCell>
        <mxCell id="sla-flow-edge-15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#657B90;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=0.5;exitY=1;entryX=0.5;entryY=0;jumpStyle=arc;jumpSize=9;" edge="1" parent="1" source="sla-flow-physical-step-1" target="sla-flow-physical-step-2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="sla-flow-footer" value="&lt;div style=&quot;line-height:1.4&quot;&gt;S / S′：当前 / 候选物理备份集合；b：实际字节数；F：第 3 页定义的 WCT 恢复收益。&lt;br&gt;收益保证针对已发布快照的提交后状态；复制过渡窗口、实机代价误差另行评估。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#657B90;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="2820" width="2280" height="95" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
