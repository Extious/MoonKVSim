        </mxCell>
        <mxCell id="sla-flow-example-input" value="&lt;div style=&quot;line-height:1.4&quot;&gt;容量 6 MiB；每块 2 MiB&lt;br&gt;A 的累计收益：0、1、3、6 ms&lt;br&gt;B1 的收益：4 ms&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="sla-flow-example">
          <mxGeometry as="geometry" x="20" y="90" width="675" height="135" />
        </mxCell>
        <mxCell id="sla-flow-before-label" value="&lt;div style=&quot;line-height:1.4&quot;&gt;当前 S：收益 6 ms&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="sla-flow-example">
          <mxGeometry as="geometry" x="20" y="225" width="675" height="50" />
        </mxCell>
