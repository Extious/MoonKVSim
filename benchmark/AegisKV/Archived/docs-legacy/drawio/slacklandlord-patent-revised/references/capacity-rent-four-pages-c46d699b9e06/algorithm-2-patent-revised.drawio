        <mxCell id="sla-value-edge-14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#657B90;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jumpStyle=arc;jumpSize=9;" edge="1" parent="1" source="sla-value-k3-x2" target="sla-value-k3-x3">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="sla-value-k3-numbers" value="&lt;div style=&quot;line-height:1.4&quot;&gt;T = 6 ms&lt;br&gt;J = 2 ms&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="sla-value-plans">
          <mxGeometry as="geometry" x="730" y="1170" width="220" height="85" />
