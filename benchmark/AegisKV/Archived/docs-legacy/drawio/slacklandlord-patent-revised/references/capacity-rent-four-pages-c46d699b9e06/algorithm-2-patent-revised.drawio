        <mxCell id="sla-flow-example" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#23384B;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#C1CEDB;rounded=1;arcSize=9;container=1;pointerEvents=0;" vertex="1" parent="1">
