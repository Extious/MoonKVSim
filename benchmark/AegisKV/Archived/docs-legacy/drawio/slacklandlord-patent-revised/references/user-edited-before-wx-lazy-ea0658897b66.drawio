                <mxCell id="sla-flow-pool-result" value="&lt;div style=&quot;line-height:1.4&quot;&gt;若接纳 x：P1 | C1 | C2 | x&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-flow-pool" vertex="1">
                    <mxGeometry x="20" y="755" width="670" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-lazy" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;container=1;pointerEvents=0;" parent="1" vertex="1">
                    <mxGeometry x="1830" y="1980" width="710" height="875" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-lazy-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Lazy Refresh：更新哪些值&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" parent="sla-flow-lazy" vertex="1">
                    <mxGeometry x="20" y="12" width="670" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-round-update" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Agent1 的下一轮请求&lt;br&gt;Slack: 8 → 4 ms；版本: 7 → 8&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-lazy" vertex="1">
                    <mxGeometry x="40" y="100" width="630" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-mark" value="&lt;div style=&quot;line-height:1.4&quot;&gt;只更新 Agent1 的记录，标记相关缓存陈旧&lt;br&gt;Agent2 仍为 3 ms；共享 KV 不搬动&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-lazy" vertex="1">
                    <mxGeometry x="40" y="270" width="630" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-lazy-when" value="&lt;div style=&quot;line-height:1.4&quot;&gt;x 待准入 / y 参与回收比较&lt;br&gt;检查引用版本、恢复代价、试算前缀&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-lazy" vertex="1">
                    <mxGeometry x="40" y="440" width="630" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-lazy-write" value="&lt;div style=&quot;line-height:1.4&quot;&gt;输入变化才重新计算 \(W_x\)&lt;br&gt;\(G_x\leftarrow W_x,\quad P_x\leftarrow G_x/b_x\)&lt;br&gt;写回缓存版本；尾块 y 同样处理&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-flow-lazy" vertex="1">
                    <mxGeometry x="40" y="610" width="630" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-lazy-note" value="&lt;div style=&quot;line-height:1.4&quot;&gt;输入未变 → 复用缓存；新暴露的尾块必须重验。&lt;br&gt;同一工作流的多个 Agent 联合计算恢复收益。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=23;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-flow-lazy" vertex="1">
                    <mxGeometry x="20" y="760" width="670" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-edge-21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=0.5;exitY=1;entryX=0.5;entryY=0;jumpStyle=arc;jumpSize=9;" parent="1" source="sla-flow-round-update" target="sla-flow-mark" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-edge-22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=0.5;exitY=1;entryX=0.5;entryY=0;jumpStyle=arc;jumpSize=9;" parent="1" source="sla-flow-mark" target="sla-flow-lazy-when" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-edge-23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=0.5;exitY=1;entryX=0.5;entryY=0;jumpStyle=arc;jumpSize=9;" parent="1" source="sla-flow-lazy-when" target="sla-flow-lazy-write" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-quota" value="&lt;div style=&quot;line-height:1.4&quot;&gt;容量缩小：暂停准入，先回收到新上限。&lt;br&gt;复制中、释放中的分配仍计入物理占用。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
                    <mxGeometry x="1830" y="2920" width="710" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-footer" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Size 以 tokens 展示；容量比较使用实际 HBM 字节。恢复收益的单位是 ms；优先级的单位是 ms/byte。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="60" y="3040" width="2480" height="55" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
