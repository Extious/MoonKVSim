          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="sla-cache-hit-layout-pool-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Pool · 共享块只占一份空间&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
