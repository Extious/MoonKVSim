                <mxCell id="sla-flow-gate-bypass" value="&lt;div style=&quot;line-height:1.4&quot;&gt;不备份 x&lt;br&gt;丢弃临时计划&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
