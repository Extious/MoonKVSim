                <mxCell id="sla-agents-physical-C1" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C1&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-agents-physical" vertex="1">
                    <mxGeometry x="35" y="230" width="250" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-physical-C2" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C2&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-agents-physical" vertex="1">
                    <mxGeometry x="315" y="230" width="250" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-physical-C3" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C3&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-agents-physical" vertex="1">
                    <mxGeometry x="595" y="230" width="250" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-physical-C4" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C4&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-agents-physical" vertex="1">
                    <mxGeometry x="875" y="230" width="250" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-physical-A5" value="&lt;div style=&quot;line-height:1.4&quot;&gt;A5&lt;br&gt;COPYING&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;dashed=1;dashPattern=7 5;" parent="sla-agents-physical" vertex="1">
                    <mxGeometry x="1155" y="230" width="250" height="85" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-physical-note" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Pool 包含 9 个已提交块；A5 另占 1 块空间。&lt;br&gt;恢复仅使用已提交的连续前缀；内部共享块有后继时不能单独删除。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-agents-physical" vertex="1">
                    <mxGeometry x="25" y="340" width="1390" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-state-panel" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;container=1;pointerEvents=0;" parent="1" vertex="1">
                    <mxGeometry x="1560" y="1110" width="780" height="435" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-state-panel-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Pool 需要维护的状态&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" parent="sla-agents-state-panel" vertex="1">
                    <mxGeometry x="20" y="12" width="740" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-state" value="&lt;div style=&quot;line-height:1.4&quot;&gt;容量与物理分配记录&lt;br&gt;COMMITTED / COPYING / RETIRING&lt;br&gt;固定读取引用与分配代次&lt;br&gt;Agent 子租约余额与已兑现轮号&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-agents-state-panel" vertex="1">
                    <mxGeometry x="30" y="90" width="720" height="205" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-state-note" value="&lt;div style=&quot;line-height:1.4&quot;&gt;每个 Agent 单独续租；物理块只收一份租金。&lt;br&gt;只有释放 ACK 才减少实际占用。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-agents-state-panel" vertex="1">
                    <mxGeometry x="30" y="315" width="720" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-round" value="&lt;div style=&quot;line-height:1.4&quot;&gt;新请求开始&lt;br&gt;替换本轮输入，登记一次续租资格&lt;br&gt;本轮生成过程中不调整 Slack&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1630" width="690" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-produce" value="&lt;div style=&quot;line-height:1.4&quot;&gt;生成完整 chunk&lt;br&gt;发布可读源与前缀关系&lt;br&gt;进入第 2 页的容量决策&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
                    <mxGeometry x="855" y="1630" width="690" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-edge-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jumpStyle=arc;jumpSize=9;" parent="1" source="sla-agents-round" target="sla-agents-produce" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-ack" value="&lt;div style=&quot;line-height:1.4&quot;&gt;请求结束：保留 Agent 的租约&lt;br&gt;Agent 结束：撤销自己的份额&lt;br&gt;共享物理块按尾块规则回收&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
                    <mxGeometry x="1650" y="1630" width="690" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-edge-13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jumpStyle=arc;jumpSize=9;" parent="1" source="sla-agents-produce" target="sla-agents-ack" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sla-agents-footer" value="&lt;div style=&quot;line-height:1.4&quot;&gt;第 2 页：逐块准入与收租。内部前缀 / 固定读取块保存剩余信用；成为可释放尾块后继续收租。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1850" width="2280" height="55" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="flow" name="2 · 新 chunk：准入与尾块收租">
        <mxGraphModel dx="1288" dy="1278" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3820" pageHeight="4360" background="#FFFFFF" math="1" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="sla-flow-canvas" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;locked=1;connectable=0;" parent="1" vertex="1">
                    <mxGeometry width="3820" height="4360" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;SlackLandlord  ·  新 chunk：收益分账、准入与尾块收租&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=40;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="25" width="3700" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-subtitle" value="&lt;div style=&quot;line-height:1.4&quot;&gt;恢复方式：复用全部可用前缀，再重算剩余已生成 KV；收益只按 WCT 计价。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="60" y="115" width="3700" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-symbols-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;符号说明&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=31;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="60" y="210" width="3700" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-symbols-0" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(x\)：本次处理的物理块；\(y\)：待淘汰尾块；\(a\)：Agent；\(s_a\)：本轮 Slack；\(b_x,b_y\)：物理字节数&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="75" y="290" width="3670" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-symbols-1" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(k\)：连续备份块数；\(k_a\)：待评估块之前的连续备份块数；\(t_a^{\rm reuse}(k)\)：复用前 k 块；\(t_a^{\rm recompute}(k)\)：重算其余已生成 KV&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="75" y="355" width="3670" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-symbols-2" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(T_a(k_a),T_a(k_a+1)\)：不用 / 使用待评估块的恢复时间；\(W_{a,x}\)：Agent 的 WCT 收益份额；\(P_{a,x}=W_{a,x}/b_x\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="75" y="420" width="3670" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-symbols-3" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(c_{a,x}\)：Agent 剩余信用；\(\mathrm{Credit}_x=\sum_a c_{a,x}\)；\(H_x\)：尾块租值键；\(L\)：累计租金；\(\delta\)：本次收租增量&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="75" y="485" width="3670" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-symbols-4" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(Q\)：本次决策的可释放尾块优先队列；\(Y\)：计划淘汰的块；\(f\)：计划可用字节；\(G_x,D_Y\)：加入收益、累计回收损失&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="75" y="550" width="3670" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-symbols-5" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(w\)：工作流；\(v,u\)：DAG 节点；\(d_v,t_v\)：正常耗时、完成时间；\(\mathbf T\)：各节点恢复耗时，未受影响节点为 0；\(\max\varnothing=0\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="75" y="615" width="3670" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-candidate" value="&lt;div style=&quot;line-height:1.4&quot;&gt;新 KV chunk x ( 第k+1个 )到来；按前缀顺序逐块决策&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="1450" y="770" width="1300" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-prefix" value="&lt;div style=&quot;line-height:1.4&quot;&gt;前缀均已准入？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" parent="1" vertex="1">
                    <mxGeometry x="1640" y="970" width="920" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-wait-prefix" value="&lt;div style=&quot;line-height:1.4&quot;&gt;本轮不备份 x 及后续块&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="80" y="970" width="1160" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-recovery" value="&lt;div style=&quot;line-height:1.4&quot;&gt;对于Agent a 来讲，&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;\(T_a(k)\) 为&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;已经备份到前 k 个 chunk时的&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;恢复时间&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;line-height:1.4&quot;&gt;备份 x 前：\(T_a(k_a)\)；备份后：\(T_a(k_a+1)\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="1450" y="1200" width="1300" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-benefits" value="&lt;div style=&quot;line-height:1.4&quot;&gt;按固定 Agent ID 顺序计算 WCT 收益并分账&lt;br&gt;\(\mathbf T^{(i)}\)：前 i 个引用使用 x，其余引用不用；其他节点不变&lt;br&gt;\(w\gets x\)：引用 x 的工作流；\(\mathbf T^{(0)}\)：所有引用均不用 x&lt;br&gt;\(t_v=d_v+T_v+\max_{u\to v}t_u,\quad\mathrm{WCT}_w=\max_{v\in w}t_v\)&lt;br&gt;\(W_{a_i,x}=\sum_{w\gets x}[\mathrm{WCT}_w(\mathbf T^{(i-1)})-\mathrm{WCT}_w(\mathbf T^{(i)})]\)&lt;br&gt;仅单 Agent 恢复：\(W_{a,x}=\min\{T_a(k_a)-T_a(k_a+1),\max(T_a(k_a)-s_a,0)\}\)&lt;br&gt;\(P_{a,x}=W_{a,x}/b_x\)，\(G_x=\sum_a W_{a,x}\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="1450" y="1470" width="1300" height="350" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-init" value="&lt;div style=&quot;line-height:1.4&quot;&gt;建立临时账本，保护 x 的前缀；试算中将 x 视为可恢复&lt;br&gt;\(Y\leftarrow\varnothing,\quad D_Y\leftarrow0,\quad f\leftarrow\text{Pool 可用字节}\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="1450" y="1930" width="1300" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-fits" value="&lt;div style=&quot;line-height:1.4&quot;&gt;容量足够？&lt;br&gt;\(f\ge b_x\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" parent="1" vertex="1">
                    <mxGeometry x="1675" y="2190" width="850" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-admission-rule" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(\begin{cases}G_x\ge0,&amp;amp;Y=\varnothing\quad\text{无需淘汰};\\[2mm]G_x&amp;gt;D_Y,&amp;amp;Y\ne\varnothing\quad\text{需要淘汰}.\end{cases}\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="1450" y="2450" width="1300" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-accept" value="&lt;div style=&quot;line-height:1.4&quot;&gt;满足准入条件？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" parent="1" vertex="1">
                    <mxGeometry x="1675" y="2720" width="850" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-validate" value="&lt;div style=&quot;line-height:1.4&quot;&gt;输入、容量、读取与账本版本仍有效？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" parent="1" vertex="1">
                    <mxGeometry x="1640" y="2950" width="920" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-copy" value="&lt;div style=&quot;line-height:1.4&quot;&gt;提交临时账本；释放 Y 并等待释放 ACK&lt;br&gt;分配空间，复制 x 的全部分片&lt;br&gt;Y 为空时直接分配&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="1450" y="3180" width="1300" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-ack" value="&lt;div style=&quot;line-height:1.4&quot;&gt;全部分片成功且提交条件有效？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" parent="1" vertex="1">
                    <mxGeometry x="1640" y="3450" width="920" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-commit" value="&lt;div style=&quot;line-height:1.4&quot;&gt;按当前前缀重算 W，原子核验版本并发布 COMMITTED&lt;br&gt;\(c_{a,x}=W_{a,x},\quad\mathrm{Credit}_x=\sum_a c_{a,x}\)&lt;br&gt;\(H_x=L+\mathrm{Credit}_x/b_x\)&lt;br&gt;记录已兑现轮号；仅可释放尾块加入 Q&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="1450" y="3710" width="1300" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-done" value="&lt;div style=&quot;line-height:1.4&quot;&gt;备份完成，处理下一个完整 chunk&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="1450" y="4070" width="1300" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-build-q" value="&lt;div style=&quot;line-height:1.4&quot;&gt;更新 Q：已提交、无后继、可释放的尾块&lt;br&gt;排除 x、受保护前缀与读取中的块&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="80" y="1990" width="1160" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-has-tail" value="&lt;div style=&quot;line-height:1.4&quot;&gt;有可释放尾块？&lt;br&gt;\(Q\ne\varnothing\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" parent="1" vertex="1">
                    <mxGeometry x="235" y="2240" width="850" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-refresh-credit" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Lazy Refresh：检查全部 Q，结果先写临时账本&lt;br&gt;新暴露或版本变化：按上方收益式（x 换为 y）重算 W&lt;br&gt;\(c_{a,y}\leftarrow\begin{cases}0,&amp;amp;\text{Agent 结束或引用解除};\\W_{a,y},&amp;amp;\text{首次引用或新轮尚未兑现};\\\min(c_{a,y},W_{a,y}),&amp;amp;\text{本轮已兑现}.\end{cases}\)&lt;br&gt;\(\mathrm{Credit}_y=\sum_a c_{a,y},\quad H_y=L+\mathrm{Credit}_y/b_y\)&lt;br&gt;版本未变则保留余额；已兑现轮号保留去重&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="80" y="2480" width="1160" height="320" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-debit" value="&lt;div style=&quot;line-height:1.4&quot;&gt;对 Q 收租：每个物理块一份，按余额分摊&lt;br&gt;\(\delta=\min_{y\in Q}(H_y-L)\)&lt;br&gt;\(c_{a,y}\leftarrow c_{a,y}\left(1-\frac{b_y\delta}{\mathrm{Credit}_y}\right),\quad y\in Q\)&lt;br&gt;\(\mathrm{Credit}_y\leftarrow\sum_a c_{a,y},\quad L\leftarrow L+\delta\)&lt;br&gt;零余额跳过除法；全 Q 扣租后仅推进一次 L&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="80" y="2910" width="1160" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-loss" value="&lt;div style=&quot;line-height:1.4&quot;&gt;选择 Credit = 0 的尾块 y，计算当前删除损失&lt;br&gt;\(G_y=\sum_{w\gets y}[\mathrm{WCT}_w(\mathbf T^{-y})-\mathrm{WCT}_w(\mathbf T)]\)&lt;br&gt;\(\mathbf T^{-y}\)：从当前临时前缀删除 y；同值按块 ID 选择&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="80" y="3260" width="1160" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-trim" value="&lt;div style=&quot;line-height:1.4&quot;&gt;更新临时计划与 Q，再检查容量&lt;br&gt;\(Y\leftarrow Y\cup\{y\},\quad D_Y\leftarrow D_Y+G_y,\quad f\leftarrow f+b_y\)&lt;br&gt;移除 y，加入新暴露尾块；新尾块保留剩余余额&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="80" y="3560" width="1160" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-bypass" value="&lt;div style=&quot;line-height:1.4&quot;&gt;不备份 x；丢弃临时计划&lt;br&gt;已有备份、真实余额与 L 不变&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" parent="1" vertex="1">
                    <mxGeometry x="80" y="4020" width="1160" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="sla-flow-layout-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;KV 引用与 Peer HBM 布局&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=30;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" parent="1" vertex="1">
