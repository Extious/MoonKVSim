        <mxCell id="sla-agents-physical-C1" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C1&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-agents-physical" vertex="1">
          <mxGeometry x="35" y="230" width="250" height="85" as="geometry" />
        </mxCell>
        <mxCell id="sla-agents-physical-C2" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C2&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-agents-physical" vertex="1">
          <mxGeometry x="315" y="230" width="250" height="85" as="geometry" />
        </mxCell>
        <mxCell id="sla-agents-physical-C3" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C3&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-agents-physical" vertex="1">
          <mxGeometry x="595" y="230" width="250" height="85" as="geometry" />
        </mxCell>
        <mxCell id="sla-agents-physical-C4" value="&lt;div style=&quot;line-height:1.4&quot;&gt;C4&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-agents-physical" vertex="1">
          <mxGeometry x="875" y="230" width="250" height="85" as="geometry" />
        </mxCell>
        <mxCell id="sla-agents-physical-A5" value="&lt;div style=&quot;line-height:1.4&quot;&gt;A5&lt;br&gt;COPYING&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;dashed=1;dashPattern=7 5;" parent="sla-agents-physical" vertex="1">
          <mxGeometry x="1155" y="230" width="250" height="85" as="geometry" />
        </mxCell>
        <mxCell id="sla-agents-physical-note" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Pool 包含 9 个已提交块；A5 另占 1 块空间。&lt;br&gt;恢复仅使用已提交的连续前缀；内部共享块有后继时不能单独删除。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-agents-physical" vertex="1">
          <mxGeometry x="25" y="340" width="1390" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sla-agents-state-panel" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;container=1;pointerEvents=0;" parent="1" vertex="1">
          <mxGeometry x="1560" y="1110" width="780" height="435" as="geometry" />
        </mxCell>
        <mxCell id="sla-agents-state-panel-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Pool 需要维护的状态&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" parent="sla-agents-state-panel" vertex="1">
          <mxGeometry x="20" y="12" width="740" height="65" as="geometry" />
        </mxCell>
        <mxCell id="sla-agents-state" value="&lt;div style=&quot;line-height:1.4&quot;&gt;容量与物理分配记录&lt;br&gt;COMMITTED / COPYING / RETIRING&lt;br&gt;读取保护与分配代次&lt;br&gt;各 Agent 的剩余信用、最近续租请求号&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="sla-agents-state-panel" vertex="1">
          <mxGeometry x="30" y="90" width="720" height="205" as="geometry" />
        </mxCell>
        <mxCell id="sla-agents-state-note" value="&lt;div style=&quot;line-height:1.4&quot;&gt;每个 Agent 单独续租；物理块只收一份租金。&lt;br&gt;只有释放 ACK 才减少实际占用。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=24;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="sla-agents-state-panel" vertex="1">
          <mxGeometry x="30" y="315" width="720" height="95" as="geometry" />
        </mxCell>
        <mxCell id="sla-agents-round" value="&lt;div style=&quot;line-height:1.4&quot;&gt;新请求到来&lt;br&gt;记录本轮 Slack 与请求号&lt;br&gt;本轮生成过程中 Slack 不变&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
          <mxGeometry x="60" y="1630" width="690" height="150" as="geometry" />
        </mxCell>
        <mxCell id="sla-agents-produce" value="&lt;div style=&quot;line-height:1.4&quot;&gt;复用已有 KV&lt;br&gt;按新 Slack 重算该块收益&lt;br&gt;刷新本 Agent 的 Credit&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
          <mxGeometry x="855" y="1630" width="690" height="150" as="geometry" />
        </mxCell>
        <mxCell id="sla-agents-edge-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jumpStyle=arc;jumpSize=9;" parent="1" source="sla-agents-round" target="sla-agents-produce" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sla-agents-ack" value="&lt;div style=&quot;line-height:1.4&quot;&gt;生成新的完整 KV chunk&lt;br&gt;按前缀顺序进行准入决策&lt;br&gt;容量不足时收租并淘汰尾块&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#000000;rounded=1;arcSize=9;" parent="1" vertex="1">
          <mxGeometry x="1650" y="1630" width="690" height="150" as="geometry" />
        </mxCell>
        <mxCell id="sla-agents-edge-13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#000000;strokeWidth=2.4;endArrow=block;endFill=1;endSize=9;jettySize=20;exitX=1;exitY=0.5;entryX=0;entryY=0.5;jumpStyle=arc;jumpSize=9;" parent="1" source="sla-agents-produce" target="sla-agents-ack" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sla-agents-footer" value="&lt;div style=&quot;line-height:1.4&quot;&gt;第 2 页：每次只处理当前 Agent 的一个 KV 块；单独估值、单独续租，再用共享块的剩余 Credit 决策。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=22;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="60" y="1850" width="2280" height="55" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="flow" name="2 · 一个 Agent 的一次请求：KV 决策全流程">
    <mxGraphModel math="1" grid="0" page="1" pageWidth="3760" pageHeight="4530" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="sla-flow-canvas" value="&lt;div style=&quot;line-height:1.4&quot;&gt;&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;locked=1;connectable=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="0" y="0" width="3760" height="4530" />
        </mxCell>
        <mxCell id="sla-flow-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;SlackLandlord  ·  一个 Agent 的请求如何决定一个 KV 块&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=40;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="25" width="3640" height="80" />
        </mxCell>
        <mxCell id="sla-flow-subtitle" value="&lt;div style=&quot;line-height:1.4&quot;&gt;逐块处理当前请求；收益与续租只属于当前 Agent；共享块用各份额的剩余信用参与容量竞争。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="115" width="3640" height="65" />
        </mxCell>
        <mxCell id="sla-flow-symbols-0" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(a\)：当前 Agent；\(x\)：本次完整 KV 块；\(s_a\)：本请求的 Slack，本轮不变；\(b_x\)：物理字节数&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="225" width="3620" height="58" />
        </mxCell>
        <mxCell id="sla-flow-symbols-1" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(G_{a,x}\)：a 备份 x 的独立收益；\(c_{a,x}\)：a 对 x 的剩余信用；\(\mathrm{Credit}_x=\sum_a c_{a,x}\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="283" width="3620" height="58" />
        </mxCell>
        <mxCell id="sla-flow-symbols-2" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(T_a(k)\)：使用前 k 块备份恢复已生成 KV 的时间；\(k_a\)：x 前面的块数；不计未知未来 KV&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="341" width="3620" height="58" />
        </mxCell>
        <mxCell id="sla-flow-symbols-3" value="&lt;div style=&quot;line-height:1.4&quot;&gt;\(Q\)：可释放尾块；\(Y\)：试算中选出的回收块；\(f\)：试算可用字节；\(\delta\)：每字节租金&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="399" width="3620" height="58" />
        </mxCell>
        <mxCell id="sla-flow-symbols-4" value="&lt;div style=&quot;line-height:1.4&quot;&gt;处理记录按“副本代次、Agent、请求号”去重；无新请求就不续租，容量竞争仍按余额扣租。&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="457" width="3620" height="58" />
        </mxCell>
        <mxCell id="sla-flow-candidate" value="&lt;div style=&quot;line-height:1.4&quot;&gt;① 取当前 Agent a 的一个 KV 事件&lt;br&gt;当前有效请求新生成或实际复用完整块 x；使用本轮 Slack&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=29;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="590" width="1300" height="130" />
        </mxCell>
        <mxCell id="sla-flow-state" value="&lt;div style=&quot;line-height:1.4&quot;&gt;② 读取 x 的状态、各 Agent 余额与 a 的已处理请求号&lt;br&gt;无副本则建立空分账；本 Pool 的元数据操作串行执行&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="850" width="1300" height="150" />
        </mxCell>
        <mxCell id="sla-flow-busy" value="&lt;div style=&quot;line-height:1.4&quot;&gt;x 有未完成的备份或释放操作？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1430" y="1100" width="840" height="150" />
        </mxCell>
        <mxCell id="sla-flow-defer" value="&lt;div style=&quot;line-height:1.4&quot;&gt;暂存本事件，等待该操作结束&lt;br&gt;随后重新读取 x；不并发复制、不提前续租&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="1100" width="960" height="150" />
        </mxCell>
        <mxCell id="sla-flow-duplicate" value="&lt;div style=&quot;line-height:1.4&quot;&gt;a 的本请求已处理或过期？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1430" y="1370" width="840" height="160" />
        </mxCell>
        <mxCell id="sla-flow-duplicate-done" value="&lt;div style=&quot;line-height:1.4&quot;&gt;保留全部余额，本次结束&lt;br&gt;重复或过期事件不再次授信&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="1370" width="960" height="160" />
        </mxCell>
        <mxCell id="sla-flow-gain" value="&lt;div style=&quot;line-height:1.4&quot;&gt;③ 只计算当前 Agent a 的恢复收益&lt;br&gt;\(G_{a,x}=\min\{T_a(k_a)-T_a(k_a+1),\max(T_a(k_a)-s_a,0)\}\)&lt;br&gt;使用到 x 之前 / 到 x 的备份前缀，其后已生成的 KV 重算&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="1640" width="1300" height="210" />
        </mxCell>
        <mxCell id="sla-flow-credit" value="&lt;div style=&quot;line-height:1.4&quot;&gt;④ 首次授信，或为 a 的新请求续租&lt;br&gt;\(c_{a,x}\leftarrow G_{a,x}\)&lt;br&gt;只改 a 的份额；其他 Agent 保留已扣租的余额&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="1960" width="1300" height="150" />
        </mxCell>
        <mxCell id="sla-flow-aggregate" value="&lt;div style=&quot;line-height:1.4&quot;&gt;⑤ 汇总共享物理块的剩余信用&lt;br&gt;\(\mathrm{Credit}_x\leftarrow\sum_a c_{a,x}\)；更新先保存在本次临时记录&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=28;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="2210" width="1300" height="130" />
        </mxCell>
        <mxCell id="sla-flow-resident" value="&lt;div style=&quot;line-height:1.4&quot;&gt;x 已有已提交的物理备份？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1430" y="2450" width="840" height="150" />
        </mxCell>
        <mxCell id="sla-flow-renew-done" value="&lt;div style=&quot;line-height:1.4&quot;&gt;保存 a 的份额与本请求已处理记录，结束&lt;br&gt;内部块、读取中的块也立即续租；更新 Q&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2790" y="2450" width="820" height="150" />
        </mxCell>
        <mxCell id="sla-flow-prefix" value="&lt;div style=&quot;line-height:1.4&quot;&gt;x 的必要前缀已提交，且源完整可读？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1430" y="2710" width="840" height="150" />
        </mxCell>
        <mxCell id="sla-flow-wait-prefix" value="&lt;div style=&quot;line-height:1.4&quot;&gt;暂不备份 x，丢弃本次临时分账&lt;br&gt;先处理缺失前缀或等待源就绪&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2790" y="2710" width="820" height="150" />
        </mxCell>
        <mxCell id="sla-flow-plan" value="&lt;div style=&quot;line-height:1.4&quot;&gt;⑥ 新备份：保护必要前缀，建立回收试算&lt;br&gt;\(Y\leftarrow\varnothing,\qquad f\leftarrow\text{Pool 空闲字节}\)&lt;br&gt;以下扣租和试删仍只改变临时记录&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="2970" width="1300" height="150" />
        </mxCell>
        <mxCell id="sla-flow-fits" value="&lt;div style=&quot;line-height:1.4&quot;&gt;空间足够？\(f\ge b_x\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1430" y="3230" width="840" height="150" />
        </mxCell>
        <mxCell id="sla-flow-validate" value="&lt;div style=&quot;line-height:1.4&quot;&gt;状态、请求版本、读保护与容量仍有效？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1430" y="3490" width="840" height="160" />
        </mxCell>
        <mxCell id="sla-flow-retry" value="&lt;div style=&quot;line-height:1.4&quot;&gt;丢弃未执行的试算&lt;br&gt;重新读取状态和余额后再决策&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2790" y="3505" width="820" height="130" />
        </mxCell>
        <mxCell id="sla-flow-copy" value="&lt;div style=&quot;line-height:1.4&quot;&gt;⑦ 提交扣租与回收计划，登记 x 的备份操作&lt;br&gt;释放 Y，确认空间后分配并复制 x&lt;br&gt;等待操作结果；只接受匹配本代次的确认&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="3760" width="1300" height="150" />
        </mxCell>
        <mxCell id="sla-flow-copy-result" value="&lt;div style=&quot;line-height:1.4&quot;&gt;本次释放、分配与复制均成功？&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1430" y="4020" width="840" height="160" />
        </mxCell>
        <mxCell id="sla-flow-copy-failed" value="&lt;div style=&quot;line-height:1.4&quot;&gt;清理本次未完成分配，本次未备份成功&lt;br&gt;不发布 x；已执行的扣租与释放不回滚&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2790" y="4020" width="820" height="160" />
        </mxCell>
        <mxCell id="sla-flow-done" value="&lt;div style=&quot;line-height:1.4&quot;&gt;⑧ 发布完整备份与竞争后的剩余信用&lt;br&gt;记录 a 本请求已授信；更新 Q，本次结束&lt;br&gt;不补满 Credit；等候中的其他 Agent 事件随后逐个处理&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="4280" width="1300" height="150" />
        </mxCell>
        <mxCell id="sla-flow-queue" value="&lt;div style=&quot;line-height:1.4&quot;&gt;⑥a 更新 Q：无备份后继、未被读取的已提交块&lt;br&gt;排除 x、必要前缀、其他备份的操作保护块及释放中块&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="2970" width="960" height="150" />
        </mxCell>
        <mxCell id="sla-flow-has-tail" value="&lt;div style=&quot;line-height:1.4&quot;&gt;有可释放尾块且 x 尚有信用？&lt;br&gt;\(Q\ne\varnothing\ \land\ \mathrm{Credit}_x&amp;gt;0\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="145" y="3230" width="810" height="160" />
        </mxCell>
        <mxCell id="sla-flow-rent" value="&lt;div style=&quot;line-height:1.4&quot;&gt;⑥b x 与 Q 中各块按物理字节收租&lt;br&gt;\(\delta=\min\{\mathrm{Credit}_x/b_x,\min_{y\in Q}\mathrm{Credit}_y/b_y\}\)&lt;br&gt;\(c_{a,y}\leftarrow c_{a,y}(1-b_y\delta/\mathrm{Credit}_y),\quad y\in Q\cup\{x\}\)&lt;br&gt;每块的所有 Agent 均扣租，分母取扣租前总余额&lt;br&gt;零余额跳过除法，再汇总各块 Credit&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=25;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="3500" width="960" height="230" />
        </mxCell>
        <mxCell id="sla-flow-alive" value="&lt;div style=&quot;line-height:1.4&quot;&gt;收租后 x 仍有信用？&lt;br&gt;\(\mathrm{Credit}_x&amp;gt;0\)&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=27;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rhombus;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="165" y="3830" width="770" height="160" />
        </mxCell>
        <mxCell id="sla-flow-remove" value="&lt;div style=&quot;line-height:1.4&quot;&gt;⑥c 选一个 Credit = 0 的旧尾块 y，加入试删&lt;br&gt;\(Y\leftarrow Y\cup\{y\},\qquad f\leftarrow f+b_y\)&lt;br&gt;同值按块 ID 选择；前驱成为尾块后再参与下一轮&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="4090" width="960" height="160" />
        </mxCell>
        <mxCell id="sla-flow-reject" value="&lt;div style=&quot;line-height:1.4&quot;&gt;不备份 x，丢弃整次试算&lt;br&gt;已有备份与余额不变；新旧同时归零也拒绝 x&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="4340" width="960" height="110" />
        </mxCell>
        <mxCell id="sla-flow-layout-title" value="&lt;div style=&quot;line-height:1.4&quot;&gt;同一块 x，各 Agent 分别记账&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=30;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;text;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2790" y="1100" width="820" height="60" />
        </mxCell>
        <mxCell id="sla-flow-layout-card" value="&lt;div style=&quot;line-height:1.4&quot;&gt;Agent A：\(s_A,\ c_{A,x}\)，上次续租请求号&lt;br&gt;Agent B：\(s_B,\ c_{B,x}\)，上次续租请求号&lt;br&gt;A 的新请求只更新 A；B 的份额继续保留&lt;br&gt;物理大小 \(b_x\)：共享块只占一份空间&lt;/div&gt;" style="fontFamily=Noto Sans CJK SC;fontSize=26;fontColor=#000000;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#000000;fillColor=#FFFFFF;rounded=1;arcSize=8;" vertex="1" parent="1">
