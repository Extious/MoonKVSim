+def _sum_buffer_sizes(buffer_sizes: Sequence[Any]) -> int:
+    """Return the total number of bytes described by a Mooncake I/O call."""
+
+    total = 0
+    for size in buffer_sizes:
+        if isinstance(size, Sequence) and not isinstance(
+            size, (str, bytes, bytearray)
+        ):
+            total += _sum_buffer_sizes(size)
+        else:
+            total += int(size)
+    return total
+
+
+def _io_profile_name(operation: str, object_count: int, buffer_sizes) -> str:
+    """Build a machine-parseable torch-profiler span name for L3 I/O."""
+
+    return (
+        f"sglang.hicache.mooncake.{operation}"
+        f"|objects={object_count}|bytes={_sum_buffer_sizes(buffer_sizes)}"
+    )
+
+
+@contextmanager
+def _profile_mooncake_io(operation: str, object_count: int, buffer_sizes):
+    """Profile Mooncake I/O from HiCache's background storage threads.
+
+    PyTorch's profiler enable flag is thread-local, so ``record_function`` spans
+    created by the prefetch/backup worker threads are not exported by the
+    scheduler thread's profiler.  Keep the torch span for synchronous callers
+    and also emit one atomic JSONL event per real Mooncake call when the
+    profiling directory is configured.
+    """
+
+    num_bytes = _sum_buffer_sizes(buffer_sizes)
+    profile_name = _io_profile_name(operation, object_count, buffer_sizes)
+    start_unix_ns = time.time_ns()
+    start_ns = time.perf_counter_ns()
+    status = "ok"
+    with profile_range(profile_name):
+        try:
+            yield
+        except Exception:
+            status = "error"
+            raise
+        finally:
+            end_ns = time.perf_counter_ns()
+            profile_dir = os.environ.get("SGLANG_HICACHE_IO_PROFILE_DIR")
+            if profile_dir:
+                os.makedirs(profile_dir, exist_ok=True)
+                event = {
+                    "operation": operation,
+                    "objects": object_count,
+                    "bytes": num_bytes,
+                    "duration_us": (end_ns - start_ns) / 1_000,
+                    "start_unix_ns": start_unix_ns,
+                    "end_unix_ns": time.time_ns(),
+                    "pid": os.getpid(),
+                    "thread": threading.current_thread().name,
+                    "status": status,
+                }
+                path = os.path.join(profile_dir, f"hicache-io-{os.getpid()}.jsonl")
+                payload = (json.dumps(event, sort_keys=True) + "\n").encode("utf-8")
+                fd = os.open(path, os.O_APPEND | os.O_CREAT | os.O_WRONLY, 0o644)
+                try:
+                    os.write(fd, payload)
+                finally:
+                    os.close(fd)
+
+
