{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonkvsim.local/schemas/vanilla-mooncake-e4-result-v1.json",
  "title": "MoonKVSim Vanilla Mooncake physical component result",
  "type": "object",
  "required": [
    "schema",
    "status",
    "evidence_level",
    "paper_ready"
  ],
  "properties": {
    "schema": {
      "const": "moonkvsim.vanilla_mooncake_e4.v1"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "evidence_level": {
      "enum": [
        "E3_SMALL_SCALE_PHYSICAL_COMPONENT",
        "NONE"
      ]
    },
    "paper_ready": {
      "const": false
    },
    "e4_status": {
      "const": "BLOCKED_MISSING_MATCHED_MOONKVSIM_ERROR_COMPARISON"
    },
    "rounds": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/round"
      }
    },
    "gate": {
      "type": "object",
      "required": [
        "status",
        "requirements"
      ],
      "properties": {
        "status": {
          "const": "PASS"
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "evidence_boundary": {
      "type": "object",
      "required": [
        "physical_request_path_executed",
        "matched_simulator_run_present",
        "simulator_error_comparison_present",
        "formal_e4_claim_allowed"
      ],
      "properties": {
        "physical_request_path_executed": {
          "const": true
        },
        "matched_simulator_run_present": {
          "const": false
        },
        "simulator_error_comparison_present": {
          "const": false
        },
        "formal_e4_claim_allowed": {
          "const": false
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "required": [
          "e4_status",
          "rounds",
          "gate",
          "evidence_boundary"
        ],
        "properties": {
          "evidence_level": {
            "const": "E3_SMALL_SCALE_PHYSICAL_COMPONENT"
          }
        }
      },
      "else": {
        "properties": {
          "evidence_level": {
            "const": "NONE"
          }
        }
      }
    }
  ],
  "$defs": {
    "round": {
      "type": "object",
      "required": [
        "round",
        "cold_reference",
        "prime_on_a",
        "reuse_on_b",
        "gate_errors"
      ],
      "properties": {
        "round": {
          "type": "integer",
          "minimum": 0
        },
        "cold_reference": {
          "$ref": "#/$defs/case"
        },
        "prime_on_a": {
          "$ref": "#/$defs/case"
        },
        "reuse_on_b": {
          "$ref": "#/$defs/case"
        },
        "gate_errors": {
          "type": "array",
          "maxItems": 0
        }
      },
      "additionalProperties": true
    },
    "case": {
      "type": "object",
      "required": [
        "name",
        "server_id",
        "request_fingerprint",
        "http_status",
        "metrics_delta",
        "decomposition"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "server_id": {
          "enum": [
            "server_a",
            "server_b"
          ]
        },
        "request_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "http_status": {
          "const": 200
        },
        "metrics_delta": {
          "$ref": "#/$defs/metricsDelta"
        },
        "decomposition": {
          "$ref": "#/$defs/decomposition"
        }
      },
      "additionalProperties": true
    },
    "metricsDelta": {
      "type": "object",
      "required": [
        "request",
        "operations"
      ],
      "properties": {
        "request": {
          "type": "object"
        },
        "operations": {
          "type": "object",
          "required": [
            "lookup_exists",
            "load_get",
            "save_exists",
            "save_put"
          ]
        }
      },
      "additionalProperties": true
    },
    "decomposition": {
      "type": "object",
      "required": [
        "queue_seconds",
        "forward_path_residual_seconds",
        "kv_io_total_seconds",
        "engine_e2e_seconds",
        "client_e2e_seconds",
        "spans_are_additive"
      ],
      "properties": {
        "queue_seconds": {
          "type": "number",
          "minimum": 0
        },
        "forward_path_residual_seconds": {
          "type": "number",
          "minimum": 0
        },
        "kv_io_total_seconds": {
          "type": "number",
          "minimum": 0
        },
        "engine_e2e_seconds": {
          "type": "number",
          "minimum": 0
        },
        "client_e2e_seconds": {
          "type": "number",
          "minimum": 0
        },
        "spans_are_additive": {
          "const": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
